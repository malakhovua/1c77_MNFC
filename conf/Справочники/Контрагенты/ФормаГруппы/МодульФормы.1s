// ===============================
Процедура ПриЗаписи()	// Предопределенная процедура
	// в процедуре при записи проверятся заполнение обязательных реквизитов
	
	// проверка заполения поля "Наименование"
	Если ПустоеЗначение(Наименование) = 1 Тогда
	    Предупреждение(	"Не заполено поле 'Наименование'");
		СтатусВозврата(0);
	КонецЕсли;
	
	//Реквизиты необходимы для оптимизации отчетов
	
	Если Выбран() = 1 Тогда
		Уровень = Уровень();
	Иначе
		Уровень = Родитель.Уровень + 1;
	КонецЕсли;
	
	ЭтоГруппа = ЭтоГруппа();

КонецПроцедуры

// ===============================
Процедура УстановитьОсновногоПартнераДляПодчиненныхЭлементов()	// + claude
	Если (Выбран() = 0) ИЛИ (Модифицированность() = 1) Тогда
		Предупреждение("Сначала запишите группу!");
		Возврат;
	КонецЕсли;
	
	// пустой партнер группы - наследуется от ближайшей группы выше, если и там нет - очищается
	Если ПустоеЗначение(ОсновнойПартнер) = 0 Тогда	// + claude
		Партнер = ОсновнойПартнер;
		ТекстВопроса = "Установить основного партнера """ + СокрЛП(Партнер.Наименование) + """ всем подчиненным элементам группы?";
	Иначе
		Партнер = глОсновнойПартнерБлижайшейГруппы(Родитель);
		Если ПустоеЗначение(Партнер) = 0 Тогда
			ТекстВопроса = "У группы не задан основной партнер. Установить подчиненным элементам партнера вышестоящей группы """ + СокрЛП(Партнер.Наименование) + """?";
		Иначе
			ТекстВопроса = "Основной партнер не задан ни у группы, ни выше. Очистить основного партнера у всех подчиненных элементов группы?";
		КонецЕсли;
	КонецЕсли;
	Если Вопрос(ТекстВопроса, "Да+Нет") <> "Да" Тогда	// + claude
		Возврат;
	КонецЕсли;

	КолвоИзменено = 0;
	глУстановитьОсновногоПартнераПодчиненным(ТекущийЭлемент(), Партнер, КолвоИзменено);	// + claude
	Сообщить("Основной партнер установлен у элементов: " + КолвоИзменено);
КонецПроцедуры	// УстановитьОсновногоПартнераДляПодчиненныхЭлементов