// ===============================
Процедура ПриЗаписи()	// Предопределенная процедура
	// в процедуре при записи проверятся заполнение обязательных реквизитов
	
	// проверка заполения поля "Наименование"
	Если ПустоеЗначение(Наименование) = 1 Тогда
	    Предупреждение(	"Не заполено поле 'Наименование'");
		СтатусВозврата(0);
	КонецЕсли;
	
	//Реквизиты необходимы для оптимизации отчетов
	
	Если Выбран() = 1 Тогда
		Уровень = Уровень();
	Иначе
		Уровень = Родитель.Уровень + 1;
	КонецЕсли;
	
	ЭтоГруппа = ЭтоГруппа();

КонецПроцедуры

// ===============================
// Рекурсивно устанавливает основного партнера подчиненным элементам группы.
// Вложенная группа с заполненным основным партнером передает своим подчиненным его
Процедура УстановитьПартнераПодчиненным(Группа, Партнер, КолвоИзменено)	// + claude
	Спр = СоздатьОбъект("Справочник.Контрагенты");
	Спр.ИспользоватьРодителя(Группа);
	Спр.ВыбратьЭлементы(1);
	Пока Спр.ПолучитьЭлемент() = 1 Цикл
		Если Спр.ЭтоГруппа() = 1 Тогда
			Если ПустоеЗначение(Спр.ОсновнойПартнер) = 1 Тогда
				УстановитьПартнераПодчиненным(Спр.ТекущийЭлемент(), Партнер, КолвоИзменено);
			Иначе
				УстановитьПартнераПодчиненным(Спр.ТекущийЭлемент(), Спр.ОсновнойПартнер, КолвоИзменено);
			КонецЕсли;
		Иначе
			Если Спр.ОсновнойПартнер <> Партнер Тогда
				Спр.ОсновнойПартнер = Партнер;
				Спр.Записать();
				КолвоИзменено = КолвоИзменено + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	// УстановитьПартнераПодчиненным

// ===============================
Процедура УстановитьОсновногоПартнераДляПодчиненныхЭлементов()	// + claude
	Если (Выбран() = 0) ИЛИ (Модифицированность() = 1) Тогда
		Предупреждение("Сначала запишите группу!");
		Возврат;
	КонецЕсли;
	Если ПустоеЗначение(ОсновнойПартнер) = 1 Тогда
		Предупреждение("Не заполнен основной партнер группы!");
		Возврат;
	КонецЕсли;
	Если Вопрос("Установить основного партнера """ + СокрЛП(ОсновнойПартнер.Наименование) + """ всем подчиненным элементам группы?", "Да+Нет") <> "Да" Тогда
		Возврат;
	КонецЕсли;

	КолвоИзменено = 0;
	УстановитьПартнераПодчиненным(ТекущийЭлемент(), ОсновнойПартнер, КолвоИзменено);
	Сообщить("Основной партнер установлен у элементов: " + КолвоИзменено);
КонецПроцедуры	// УстановитьОсновногоПартнераДляПодчиненныхЭлементов