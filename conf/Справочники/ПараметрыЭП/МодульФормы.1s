Процедура ПриОткрытии()
КонецПроцедуры

Процедура ВводНового(ПризнакКопирования) // + claude
	Если ПризнакКопирования = 1 Тогда
		Возврат;
	КонецЕсли;

	Тип = Перечисление.ТипыПротоколовЭП.SMTP;
КонецПроцедуры

Процедура ПриЗаписи() // + claude
	Если ПустоеЗначение(Тип) = 1 Тогда
		Предупреждение("Не задан тип протокола (SMTP/IMAP/POP3)!");
		Активизировать("Тип");
		СтатусВозврата(0);
		Возврат;
	КонецЕсли;
КонецПроцедуры
