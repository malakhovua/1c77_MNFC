// + claude
Перем Шпион; 

//*******************************************

Процедура НачатьЛог() 
	Перем ЧЛог, МЛог, СЛог, ИмяФайлаЛога; 

	Попытка 
		Шпион = СоздатьОбъект("Шпион1С");
	Исключение 
		Если ЗагрузитьВнешнююКомпоненту(КаталогПрограммы() + "Компоненты\1spy.dll") = 0 Тогда 
			Предупреждение("Зовнішня компонента 1spy.dll не завантажена, лог вестись не буде", 10);
			Возврат;
		КонецЕсли; 
		Шпион = СоздатьОбъект("Шпион1С");
	КонецПопытки; 

	ЧЛог = 0; МЛог = 0; СЛог = 0; 
	ТекущееВремя(ЧЛог, МЛог, СЛог); 
	ИмяФайлаЛога = КаталогВременныхФайлов() + "ПровестиПоПартиям_" + СтрЗаменить(Формат(ТекущаяДата(), "ДДММГГГГ"), ".", "") + "_" + ЧЛог + МЛог + СЛог + ".csv"; 
	Шпион.НачатьЗаписьВФайл(ИмяФайлаЛога); 
	Сообщить("======================= Початок проведення " + Строка(ТекущаяДата()) + " " + Строка(ТекущееВремя()) + " ======================="); 

КонецПроцедуры 

//*******************************************

Процедура ЗавершитьЛог() 
	Перем ИмяФайлаЛога, тФайл, хExcel; 

	Если (ПустоеЗначение(Шпион) = 0) Тогда , немає short-circuit у 1С7.7 - вкладений Если, щоб не звертатись до Шпион.ПишетВФайл на пустому Шпионе
		Если (Шпион.ПишетВФайл = 1) Тогда 
			Сообщить("======================= Кінець проведення " + Строка(ТекущаяДата()) + " " + Строка(ТекущееВремя()) + " ======================="); 
			ИмяФайлаЛога = Шпион.ИмяФайлаЖурнала; 
			Шпион.ЗавершитьЗаписьВФайл(); 
			Попытка , спочатку пробуємо відкрити лог через MS Excel
				хExcel = СоздатьОбъект("Excel.Application");
				хExcel.Workbooks.Open(ИмяФайлаЛога);
				хExcel.Visible = 1;
			Исключение , Excel не встановлений або не відкрився - відкриваємо засобами 1С
				Попытка 
					тФайл = СоздатьОбъект("Текст");
					тФайл.Открыть(ИмяФайлаЛога);
					тФайл.Показать(ИмяФайлаЛога);
				Исключение 
				КонецПопытки; 
			КонецПопытки; 
		КонецЕсли; 
	КонецЕсли; 

КонецПроцедуры 

//*******************************************

Процедура Выполнить() 
	Перем рс, ТекстЗапроса, УсловиеТМЦ, спТМЦПлоский, тз, ВсегоДок, ДокСсылка, ДокОбъект, ТекстПрогресса, КВпров, НомПопытки, УспПроведение, ТекстОшибки; 

	Если (ПустоеЗначение(НачДата) = 1) ИЛИ (ПустоеЗначение(КонДата) = 1) Тогда 
		Предупреждение("Вкажіть початкову та кінцеву дату періоду!");
		Возврат;
	КонецЕсли; 

	Если фВестиЛог = 1 Тогда 
		НачатьЛог();
	КонецЕсли; 

	рс = СоздатьОбъект("ODBCRecordset"); 
	Если списТМЦ.РазмерСписка() > 0 Тогда 
		УсловиеТМЦ = "(ТМЦ IN (SELECT Val FROM #спТМЦПлоский))";
		рс.УложитьСписокОбъектов(списТМЦ, "#спТМЦПлоский", "ТМЦ");
	Иначе
		УсловиеТМЦ = "";
	КонецЕсли; 

	ТекстЗапроса = "
	|SELECT RIGHT(Партии.ПозицияДокумента,9) [Документ $Документ]
	|     , CAST(LEFT(Партии.ПозицияДокумента, 8) as DateTime) as ДатаДок
	|     , Партии.ВидДокумента [Документ_вид $ВидДокументаПредставление]
	|FROM $РегистрОбороты.Партии(:НачДата,
	|     :КонДата~,
	|     Документ,,
	|     " + УсловиеТМЦ + ",
	|     ТМЦ,
	|     ОстатокТовара) AS Партии
	|GROUP BY Партии.ПозицияДокумента, Партии.ВидДокумента
	|ORDER BY Партии.ПозицияДокумента // + claude, сортування по повному рядку (дата+час+ID), а не тільки по даті - інакше документи одного дня йдуть у довільному порядку
	|"; 

	рс.УстановитьТекстовыйПараметр("НачДата", НачДата); 
	рс.УстановитьТекстовыйПараметр("КонДата", КонДата); 

	тз = рс.ВыполнитьИнструкцию(ТекстЗапроса); 
	тз.ВыбратьСтроки(); 
	ВсегоДок = тз.КоличествоСтрок(); 

	КВпров = 0; 
	Пока тз.ПолучитьСтроку() = 1 Цикл 
		ДокСсылка = тз.Документ;
		ДокОбъект = СоздатьОбъект("Документ"); 
		ДокОбъект.НайтиДокумент(ДокСсылка); 

		ТекстПрогресса = "Документ " + (КВпров + 1) + " з " + ВсегоДок + ": " + ДокОбъект.ТекущийДокумент(); 
		Состояние(ТекстПрогресса); 
		Форма.тПрогресс.Заголовок(ТекстПрогресса); 
		Сообщить(ТекстПрогресса); 

		УспПроведение = 0; 
		ТекстОшибки = ""; 
		Для НомПопытки = 1 По 3 Цикл 
			Попытка 
				Если ДокОбъект.Провести() = 1 Тогда 
					УспПроведение = 1;
				КонецЕсли; 
			Исключение 
				ТекстОшибки = ОписаниеОшибки();
				Сообщить("Помилка (спроба " + НомПопытки + "): " + ТекстОшибки); 
			КонецПопытки; 

			Если УспПроведение = 1 Тогда 
				Прервать;
			КонецЕсли; 
			Если НомПопытки < 3 Тогда 
				Пауза(3);
			КонецЕсли; 
		КонецЦикла; 

		Если УспПроведение = 0 Тогда 
			Сообщить("ЗУПИНЕНО: " + ТекстОшибки); 
			ЗавершитьЛог(); 
			Предупреждение("Помилка проведення документа (3 спроби): " + ТекстПрогресса + Симв(13) + ТекстОшибки + Симв(13) + "Проведення зупинено, оброблено документів: " + КВпров);
			Возврат;
		КонецЕсли; 

		КВпров = КВпров + 1; 

		Если (фПауза = 1) И (ИнтервалПауза <> 0) И (КоличествоСета <> 0) Тогда 
			Если (КВпров - Цел(КВпров / КоличествоСета) * КоличествоСета) = 0 Тогда 
				Пауза(ИнтервалПауза);
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 

	Состояние(""); 
	Форма.тПрогресс.Заголовок(""); 
	ЗавершитьЛог(); 
	Предупреждение("Проведення завершено. Оброблено документів: " + КВпров);

КонецПроцедуры 

///////////////////////////////////Работа со списками отбора и подбором///////////////////////////////////////

Процедура ДобавитьВСписок(Элт, Спис)
	
	Если Спис.Принадлежит(Элт) = 0 Тогда
		Спис.ДобавитьЗначение(Элт, Элт.Наименование);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПодбора(Элт)
	
	ДобавитьвСписок(Элт, списТМЦ);
	
КонецПроцедуры

Процедура ДобавитьЭлементВСписок(НазваниеОбъекта, Один, ИмСп = "")
	
	ИмСпис = ИмСп;
	КФормы = 0;
	ОткрытьПодбор(НазваниеОбъекта, "ДляВыбора", КФормы, Один);
	КФормы.ВыборГруппы(1);
	
КонецПроцедуры

Процедура УдалитьЗначениеСписка(Спис)
	
	Если Спис.ТекущаяСтрока() <> 0 Тогда
		Спис.УдалитьЗначение(Спис.ТекущаяСтрока());
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////////////////////////////////////