Перем Шпион; // + claude

//*******************************************
// + claude
Процедура НачатьЛог() // + claude
	Перем ЧЛог, МЛог, СЛог, ИмяФайлаЛога; // + claude

	Попытка // + claude
		Шпион = СоздатьОбъект("Шпион1С");
	Исключение // + claude
		Если ЗагрузитьВнешнююКомпоненту(КаталогПрограммы() + "Компоненты\1spy.dll") = 0 Тогда // + claude
			Предупреждение("Зовнішня компонента 1spy.dll не завантажена, лог вестись не буде", 10);
			Возврат;
		КонецЕсли; // + claude
		Шпион = СоздатьОбъект("Шпион1С");
	КонецПопытки; // + claude

	ЧЛог = 0; МЛог = 0; СЛог = 0; // + claude
	ТекущееВремя(ЧЛог, МЛог, СЛог); // + claude
	ИмяФайлаЛога = КаталогВременныхФайлов() + "ПровестиПоПартиям_" + СтрЗаменить(Формат(ТекущаяДата(), "ДДММГГГГ"), ".", "") + "_" + ЧЛог + МЛог + СЛог + ".csv"; // + claude
	Шпион.НачатьЗаписьВФайл(ИмяФайлаЛога); // + claude
	Сообщить("======================= Початок проведення " + Строка(ТекущаяДата()) + " " + Строка(ТекущееВремя()) + " ======================="); // + claude

КонецПроцедуры // + claude

//*******************************************
// + claude
Процедура ЗавершитьЛог() // + claude
	Перем ИмяФайлаЛога, тФайл; // + claude

	Если (ПустоеЗначение(Шпион) = 0) Тогда // + claude, немає short-circuit у 1С7.7 - вкладений Если, щоб не звертатись до Шпион.ПишетВФайл на пустому Шпионе
		Если (Шпион.ПишетВФайл = 1) Тогда // + claude
			Сообщить("======================= Кінець проведення " + Строка(ТекущаяДата()) + " " + Строка(ТекущееВремя()) + " ======================="); // + claude
			ИмяФайлаЛога = Шпион.ИмяФайлаЖурнала; // + claude
			Шпион.ЗавершитьЗаписьВФайл(); // + claude
			Попытка // + claude
				тФайл = СоздатьОбъект("Текст");
				тФайл.Открыть(ИмяФайлаЛога);
				тФайл.Показать(ИмяФайлаЛога);
			Исключение // + claude
			КонецПопытки; // + claude
		КонецЕсли; // + claude
	КонецЕсли; // + claude

КонецПроцедуры // + claude

//*******************************************
// + claude
Процедура УложитьСписок(СпИсходный, СпРезультат) // + claude
	Перем Инд, Элт, СпрТМЦ; // + claude

	СпрТМЦ = СоздатьОбъект("Справочник.ТМЦ"); // + claude

	Для Инд = 1 По СпИсходный.РазмерСписка() Цикл // + claude
		Элт = СпИсходный.ПолучитьЗначение(Инд);
		Если Элт.ЭтоГруппа() = 1 Тогда // + claude
			СпрТМЦ.ИспользоватьРодителя(Элт);
			СпрТМЦ.ВыбратьЭлементы(1);
			Пока СпрТМЦ.ПолучитьЭлемент() = 1 Цикл // + claude
				Если СпрТМЦ.ЭтоГруппа() = 1 Тогда // + claude
					Продолжить;
				КонецЕсли; // + claude
				Если СпРезультат.Принадлежит(СпрТМЦ.ТекущийЭлемент()) = 0 Тогда // + claude
					СпРезультат.ДобавитьЗначение(СпрТМЦ.ТекущийЭлемент());
				КонецЕсли; // + claude
			КонецЦикла; // + claude
		Иначе
			Если СпРезультат.Принадлежит(Элт) = 0 Тогда // + claude
				СпРезультат.ДобавитьЗначение(Элт);
			КонецЕсли; // + claude
		КонецЕсли; // + claude
	КонецЦикла; // + claude

КонецПроцедуры // + claude

//*******************************************
// + claude
Процедура Выполнить() // + claude
	Перем рс, ТекстЗапроса, УсловиеТМЦ, спТМЦПлоский, тз, ВсегоДок, ДокСсылка, ДокОбъект, ТекстПрогресса, КВпров, НомПопытки, УспПроведение, ТекстОшибки; // + claude

	Если (ПустоеЗначение(НачДата) = 1) ИЛИ (ПустоеЗначение(КонДата) = 1) Тогда // + claude
		Предупреждение("Вкажіть початкову та кінцеву дату періоду!");
		Возврат;
	КонецЕсли; // + claude

	Если фВестиЛог = 1 Тогда // + claude
		НачатьЛог();
	КонецЕсли; // + claude

	спТМЦПлоский = СоздатьОбъект("СписокЗначений"); // + claude
	Если списТМЦ.РазмерСписка() > 0 Тогда // + claude
		УложитьСписок(списТМЦ, спТМЦПлоский);
	КонецЕсли; // + claude

	рс = СоздатьОбъект("ODBCRecordset"); // + claude
	Если спТМЦПлоский.РазмерСписка() > 0 Тогда // + claude
		УсловиеТМЦ = "(ТМЦ IN (SELECT Val FROM #спТМЦПлоский))";
		рс.УложитьСписокОбъектов(спТМЦПлоский, "#спТМЦПлоский", "ТМЦ");
	Иначе
		УсловиеТМЦ = "";
	КонецЕсли; // + claude

	ТекстЗапроса = "
	|SELECT RIGHT(Партии.ПозицияДокумента,9) [Документ $Документ]
	|     , CAST(LEFT(Партии.ПозицияДокумента, 8) as DateTime) as ДатаДок
	|     , Партии.ВидДокумента [Документ_вид $ВидДокументаПредставление]
	|FROM $РегистрОбороты.Партии(:НачДата,
	|     :КонДата~,
	|     Документ,,
	|     " + УсловиеТМЦ + ",
	|     ТМЦ,
	|     ОстатокТовара) AS Партии
	|GROUP BY Партии.ПозицияДокумента, Партии.ВидДокумента
	|ORDER BY CAST(LEFT(Партии.ПозицияДокумента, 8) as DateTime)
	|"; // + claude

	рс.УстановитьТекстовыйПараметр("НачДата", НачДата); // + claude
	рс.УстановитьТекстовыйПараметр("КонДата", КонДата); // + claude

	тз = рс.ВыполнитьИнструкцию(ТекстЗапроса); // + claude
	тз.ВыбратьСтроки(); // + claude
	ВсегоДок = тз.КоличествоСтрок(); // + claude

	КВпров = 0; // + claude
	Пока тз.ПолучитьСтроку() = 1 Цикл // + claude
		ДокСсылка = тз.Документ;
		ДокОбъект = СоздатьОбъект("Документ"); // + claude
		ДокОбъект.НайтиДокумент(ДокСсылка); // + claude

		ТекстПрогресса = "Документ " + (КВпров + 1) + " з " + ВсегоДок + ": " + ДокОбъект.ТекущийДокумент(); // + claude
		Состояние(ТекстПрогресса); // + claude
		Форма.тПрогресс.Заголовок(ТекстПрогресса); // + claude
		Сообщить(ТекстПрогресса); // + claude

		УспПроведение = 0; // + claude
		ТекстОшибки = ""; // + claude
		Для НомПопытки = 1 По 3 Цикл // + claude
			Попытка // + claude
				Если ДокОбъект.Провести() = 1 Тогда // + claude
					УспПроведение = 1;
				КонецЕсли; // + claude
			Исключение // + claude
				ТекстОшибки = ОписаниеОшибки();
				Сообщить("Помилка (спроба " + НомПопытки + "): " + ТекстОшибки); // + claude
			КонецПопытки; // + claude

			Если УспПроведение = 1 Тогда // + claude
				Прервать;
			КонецЕсли; // + claude
			Если НомПопытки < 3 Тогда // + claude
				Пауза(3);
			КонецЕсли; // + claude
		КонецЦикла; // + claude

		Если УспПроведение = 0 Тогда // + claude
			Сообщить("ЗУПИНЕНО: " + ТекстОшибки); // + claude
			ЗавершитьЛог(); // + claude
			Предупреждение("Помилка проведення документа (3 спроби): " + ТекстПрогресса + Симв(13) + ТекстОшибки + Симв(13) + "Проведення зупинено, оброблено документів: " + КВпров);
			Возврат;
		КонецЕсли; // + claude

		КВпров = КВпров + 1; // + claude

		Если (фПауза = 1) И (ИнтервалПауза <> 0) И (КоличествоСета <> 0) Тогда // + claude
			Если (КВпров - Цел(КВпров / КоличествоСета) * КоличествоСета) = 0 Тогда // + claude
				Пауза(ИнтервалПауза);
			КонецЕсли; // + claude
		КонецЕсли; // + claude
	КонецЦикла; // + claude

	Состояние(""); // + claude
	Форма.тПрогресс.Заголовок(""); // + claude
	ЗавершитьЛог(); // + claude
	Предупреждение("Проведення завершено. Оброблено документів: " + КВпров);

КонецПроцедуры // + claude

///////////////////////////////////Работа со списками отбора и подбором///////////////////////////////////////

Процедура ДобавитьВСписок(Элт, Спис)
	
	Если Спис.Принадлежит(Элт) = 0 Тогда
		Спис.ДобавитьЗначение(Элт, Элт.Наименование);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПодбора(Элт)
	
	ДобавитьвСписок(Элт, списТМЦ);
	
КонецПроцедуры

Процедура ДобавитьЭлементВСписок(НазваниеОбъекта, Один, ИмСп = "")
	
	ИмСпис = ИмСп;
	КФормы = 0;
	ОткрытьПодбор(НазваниеОбъекта, "ДляВыбора", КФормы, Один);
	КФормы.ВыборГруппы(1);
	
КонецПроцедуры

Процедура УдалитьЗначениеСписка(Спис)
	
	Если Спис.ТекущаяСтрока() <> 0 Тогда
		Спис.УдалитьЗначение(Спис.ТекущаяСтрока());
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////////////////////////////////////