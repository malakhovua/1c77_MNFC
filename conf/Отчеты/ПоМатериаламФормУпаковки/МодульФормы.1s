Перем Расшифровка;
Перем Обновить;
Перем Таб;

Перем НомерСписка;
//Условие отборов
Перем Отбор_1;
Перем Отбор_2;

// Списки отборов
Перем СписокОтбор_1; 
Перем СписокОтбор_2;
Перем Заголовок_5;

Перем ЗаголовокГруппировок;

Процедура УстановитьЗаголовки() Далее
Процедура Сформировать() Далее

//***************Расшифровка************************************************

Функция РасшифровкаОбновить(Обновить)
	Расшифровка.Установить("Обновить", Обновить);
	Возврат Расшифровка;
КонецФункции

//***************Предопределенные процедуры*********************************

Процедура ПриОткрытии()
	
	Если ПоФорме = 0 Тогда
		ПоФорме = 1 
	КонецЕсли;
	Если ПустоеЗначение(ВыбДата) = 1 Тогда
		ВыбДата =ТекущаяДата();
	КонецЕсли;
	Если (ПустоеЗначение(НачДата) = 1) Тогда // + claude
		НачДата = НачМесяца(ТекущаяДата()); // + claude
	КонецЕсли; // + claude
	Если (ПустоеЗначение(КонДата) = 1) Тогда // + claude
		КонДата = ТекущаяДата(); // + claude
	КонецЕсли; // + claude

	Если глФлагРасшифровки = 1 Тогда
		Обновить = глОбновить;

		глРасшифровка.Получить("Список_1").Выгрузить(Список_1);
		глРасшифровка.Получить("Список_2").Выгрузить(Список_2);
		ВыбДата = глРасшифровка.Получить("ВыбДата");
		ПоФорме = глРасшифровка.Получить("ПоФорме");
		НачДата = глРасшифровка.Получить("НачДата"); // + claude
		КонДата = глРасшифровка.Получить("КонДата"); // + claude

		Если Обновить <> 0 Тогда
			Таб = глТаблица;
		КонецЕсли;           
		
		Если Обновить <> 2 Тогда
			Сформировать();
			СтатусВозврата(0);
			Возврат;       
		КонецЕсли;           
	Иначе
		Обновить = 0;
	КонецЕсли;
	
	Форма.КнопкаПоУмолчанию("Сформировать");
	
КонецПроцедуры

//***************Работа со списками отбора**********************************

Процедура ДобавитьВСписок(Элт, Наим, Список)
	Если Список.Принадлежит(Элт) = 0 Тогда
		Список.ДобавитьЗначение(Элт, Наим);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПодбора(Элт, конт)
	Если Элт.Вид() = "ТМЦ" Тогда
		ДобавитьвСписок(Элт, Строка(Элт), ?(НомерСписка=1,Список_1,Список_2));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьЭлементВСписок(НазваниеОбъекта, МножВыбор, НомСпис)
	
	НомерСписка = НомСпис;
	КФормы = 0;
	ОткрытьПодбор(НазваниеОбъекта, "ДляВыбора", КФормы, МножВыбор);
	КФормы.ВыборГруппы(1);
	
КонецПроцедуры

Процедура УдалитьЗначениеСписка(Список)
	Если Список.ТекущаяСтрока() <> 0 Тогда
		Список.УдалитьЗначение(Список.ТекущаяСтрока());
	КонецЕсли;
КонецПроцедуры

//**************Область компоновки отчета***********************************

Функция ТекстЗапроса1()
	Возврат 
	"SELECT 
	|     Подзапрос.значение_1 [значение_1 $Справочник.ТМЦ] 
	|   , Подзапрос.значение_2 [значение_2 $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ]
	|	, Подзапрос.значение_3 [значение_3 $Справочник.ВидыУпаковки]
	|	, Подзапрос.значение_4 [значение_4 $Справочник.ФормыУпаковки]
	|	, Подзапрос.значение_5 [значение_5 $Справочник.ТМЦ]
	|	, Sum(Подзапрос.значение_6) значение_6
	|   , GROUPING(Подзапрос.значение_1) as Группа_1
	|   , GROUPING(Подзапрос.значение_2) as Группа_2
	|   , GROUPING(Подзапрос.значение_3) as Группа_3
	|   , GROUPING(Подзапрос.значение_4) as Группа_4 
	|   , GROUPING(Подзапрос.значение_5) as Группа_5
	|FROM (SELECT ТМЦ.ID значение_1
	|           ,УМК_РазрешенныеВидыУпаковкиТМЦ.ID значение_2
	|			, $УМК_РазрешенныеВидыУпаковкиТМЦ.ВидУпаковки значение_3
	|			, ФормыУпаковки.ID значение_4
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Материал(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :ВыбДата) значение_5
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.НормаСписания(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :ВыбДата) значение_6
	|		FROM $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ AS УМК_РазрешенныеВидыУпаковкиТМЦ
	|INNER JOIN $Справочник.ТМЦ AS ТМЦ ON ТМЦ.ID = УМК_РазрешенныеВидыУпаковкиТМЦ.PARENTEXT 
	|INNER JOIN $Справочник.ФормыУпаковки AS ФормыУпаковки ON $ПоследнееЗначение.УМК_РазрешенныеВидыУпаковкиТМЦ.ФормаУпаковки(УМК_РазрешенныеВидыУпаковкиТМЦ.ID, :ВыбДата) = ФормыУпаковки.ID
	|INNER JOIN $Справочник.УМК_НормыСписанияМатериаловУпаковокФорм AS УМК_НормыСписанияМатериаловУпаковокФорм ON ФормыУпаковки.ID = УМК_НормыСписанияМатериаловУпаковокФорм.PARENTEXT
	|		WHERE 1=1 " + 
	?(Отбор_2 = 0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор_2)") + " 
	|           AND (ТМЦ.ISMARK = 0)
	|			AND (ТМЦ.ISFOLDER = 2)
	|			AND (УМК_РазрешенныеВидыУпаковкиТМЦ.ISMARK = 0)
	|			AND (УМК_НормыСписанияМатериаловУпаковокФорм.ISMARK = 0)) AS Подзапрос
	|WHERE 1=1 " +
	?(Отбор_1 = 0,"","AND Подзапрос.значение_5 IN (SELECT Val FROM #СписокОтбор_1)") + "
	|GROUP BY 
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_4
	|	, Подзапрос.значение_5 WITH ROLLUP
	|ORDER BY
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_4
	|	, Подзапрос.значение_5 
	|";
		
КонецФункции

Функция ТекстЗапроса2()
	Возврат 
	"SELECT 
	|     Подзапрос.значение_1 [значение_1 $Справочник.ТМЦ]
	|	, Подзапрос.значение_2 [значение_2 $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ]
	|	, Подзапрос.значение_3 [значение_3 $Справочник.ВидыУпаковки]
	|	, Подзапрос.значение_5 [значение_5 $Справочник.ТМЦ]
	|	, Sum(Подзапрос.значение_6) значение_6
	|   , GROUPING(Подзапрос.значение_1) as Группа_1
	|   , GROUPING(Подзапрос.значение_2) as Группа_2
	|   , GROUPING(Подзапрос.значение_3) as Группа_3 
	|   , GROUPING(Подзапрос.значение_5) as Группа_5
	|
	|FROM (SELECT ТМЦ.ID значение_1
	|			, УМК_РазрешенныеВидыУпаковкиТМЦ.ID значение_2
	|			, $УМК_РазрешенныеВидыУпаковкиТМЦ.ВидУпаковки значение_3
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Материал(УМК_НормыСписанияМатериаловУпаковок.ID, :ВыбДата) значение_5
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.НормаСписания(УМК_НормыСписанияМатериаловУпаковок.ID, :ВыбДата) значение_6
	|		FROM $Справочник.ТМЦ AS ТМЦ
	|			INNER JOIN $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ AS УМК_РазрешенныеВидыУпаковкиТМЦ ON ТМЦ.ID = УМК_РазрешенныеВидыУпаковкиТМЦ.PARENTEXT
	|			INNER JOIN $Справочник.УМК_НормыСписанияМатериаловУпаковок AS УМК_НормыСписанияМатериаловУпаковок ON УМК_РазрешенныеВидыУпаковкиТМЦ.ID = УМК_НормыСписанияМатериаловУпаковок.PARENTEXT
	|		WHERE 1=1 " + 
	?(Отбор_2 = 0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор_2)") + "     
	|			AND (ТМЦ.ISMARK = 0)
	|			AND (ТМЦ.ISFOLDER = 2)
	|           AND (УМК_РазрешенныеВидыУпаковкиТМЦ.ISMARK = 0)
	|			AND (УМК_НормыСписанияМатериаловУпаковок.ISMARK = 0)) AS Подзапрос
	|WHERE 1=1 " +
	?(Отбор_1 = 0,"","AND Подзапрос.значение_5 IN (SELECT Val FROM #СписокОтбор_1)") + "
	|GROUP BY 
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_5 WITH ROLLUP
	|ORDER BY
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_5 
	|";
	
КонецФункции

Процедура УстановитьЗаголовки()
	
	Заголовок_1 = "Продукция";
	Заголовок_2 = "Упаковка";
	Заголовок_3 = "Форма";
	Заголовок_4 = "Материал";
	Заголовок_5 = "Количество";
	
	ЗаголовокГруппировок = ?(ПоФорме=1,
	Заголовок_1 + "/" +
	Заголовок_2 + "/" +
	Заголовок_3 + "/" +
	Заголовок_4,
	Заголовок_1 + "/" +
	Заголовок_2 + "/" +
	Заголовок_4)
	;
	
КонецПроцедуры

// Збирає в СписокДат дати зміни періодичного реквізиту ИмяРеквизита елемента Элемент в межах НачДата..КонДата // + claude
Процедура СобратьДатыЭлемента(Элемент, ИмяРеквизита, НачДата, КонДата, СписокДат) // + claude
	Перем Пер;

	Пер = СоздатьОбъект("Периодический");
	Пер.ИспользоватьОбъект(ИмяРеквизита, Элемент);
	Пер.ВыбратьЗначения(НачДата, КонДата);

	Пока Пер.ПолучитьЗначение() = 1 Цикл
		Если (СписокДат.Принадлежит(Пер.ДатаЗнач) = 0) Тогда
			СписокДат.ДобавитьЗначение(Пер.ДатаЗнач);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Повертає відсортований СписокЗначений унікальних дат зміни реквізитів Материал/НормаСписания
// по довіднику(ах), що відповідають поточному режиму ПоФорме, в межах НачДата..КонДата // + claude
Функция ПолучитьДатыИзменений(НачДата, КонДата, ПоФорме) // + claude
	Перем СписокДат; //:СписокЗначений
	Перем Спр;
	Перем ЭлементСсылка;

	СписокДат = СоздатьОбъект("СписокЗначений");

	Если ПоФорме = 1 Тогда
		Спр = СоздатьОбъект("Справочник.УМК_НормыСписанияМатериаловУпаковокФорм");
		Спр.ВыбратьЭлементы(0);
		Пока Спр.ПолучитьЭлемент() = 1 Цикл
			Если (Спр.ПометкаУдаления() = 0) Тогда
				ЭлементСсылка = Спр.ТекущийЭлемент();
				СобратьДатыЭлемента(ЭлементСсылка, "Материал", НачДата, КонДата, СписокДат);
				СобратьДатыЭлемента(ЭлементСсылка, "НормаСписания", НачДата, КонДата, СписокДат);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ПоФорме = 2 Тогда
		Спр = СоздатьОбъект("Справочник.УМК_НормыСписанияМатериаловУпаковок");
		Спр.ВыбратьЭлементы(0);
		Пока Спр.ПолучитьЭлемент() = 1 Цикл
			Если (Спр.ПометкаУдаления() = 0) Тогда
				ЭлементСсылка = Спр.ТекущийЭлемент();
				СобратьДатыЭлемента(ЭлементСсылка, "Материал", НачДата, КонДата, СписокДат);
				СобратьДатыЭлемента(ЭлементСсылка, "НормаСписания", НачДата, КонДата, СписокДат);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СписокДат.Сортировать(0); // + claude (0 = за зростанням; було 1 = за спаданням - дати йшли у зворотному порядку)

	Возврат СписокДат;
КонецФункции

// Заповнює crosstab-таблицю: прогонає робочий однодатний SQL-запит (ТекстЗапроса1/2, з ROLLUP,
// без змін) по кожній даті з ДатыИзменений, збираючи ВСІ детальні рядки (без дедуплікації) в одну
// довгу таблицю тз (значение_1..6 + Ключ + Период). тз сортується по Ключ і завантажується в
// ИндексированнаяТаблица (індекс по Ключ) - за зразком робочого звіту
// Отчеты/СуммыПоСхемамЗП_sql/МодульФормы.1s (Подмножество + ВыбратьСтроки/ПолучитьСтроку з іменем
// індексу). Для кожного унікального Ключ (виявляється звичайним проходом по відсортованій тз)
// значення_6 по всіх датах вибираються через індексований пошук (Подмножество), а не ручним
// пересуванням НомерСтр/Прервать - це і було джерелом нестабільності в попередніх версіях. // + claude
Процедура ЗаполнитьТаблицу(Таб, ДатыИзменений) // + claude
	Перем тзДата; //:ТаблицаЗначений - результат одноданого запиту
	Перем тз; //:ТаблицаЗначений - довгий формат без дедуплікації: значение_1..6 + Ключ + Период
	Перем тзИндекс; //:ИндексированнаяТаблица - індекс по Ключ для швидкого пошуку рядків групи
	Перем тзЗнач; //:ТаблицаЗначений - буфер значення_6 по датах поточної групи (КолДат рядків)
	Перем сзПошук; //:СписокЗначений
	Перем НомерДаты;
	Перем КолДат;
	Перем ДатаИзменения;
	Перем ГруппаСумма;
	Перем Ключ;
	Перем ПредыдущийКлюч;
	Перем значение_6;

	КолДат = ДатыИзменений.РазмерСписка();
	Если КолДат = 0 Тогда
		Возврат;
	КонецЕсли;

	тз = СоздатьОбъект("ТаблицаЗначений");
	тз.НоваяКолонка("значение_1");
	тз.НоваяКолонка("значение_2");
	тз.НоваяКолонка("значение_3");
	тз.НоваяКолонка("значение_4");
	тз.НоваяКолонка("значение_5");
	тз.НоваяКолонка("значение_6");
	тз.НоваяКолонка("Ключ");
	тз.НоваяКолонка("Период");

	Для НомерДаты = 1 По КолДат Цикл

		ДатаИзменения = ДатыИзменений.ПолучитьЗначение(НомерДаты);

		рс = СоздатьОбъект("ODBCRecordset");
		ТекстЗапроса = ?(ПоФорме=1,ТекстЗапроса1(),ТекстЗапроса2());

		рс.УстановитьТекстовыйПараметр("ВыбДата", ДатаИзменения);
		рс.УложитьСписокОбъектов(СписокОтбор_1, "#СписокОтбор_1", "ТМЦ");
		рс.УложитьСписокОбъектов(СписокОтбор_2, "#СписокОтбор_2", "ТМЦ");

		тзДата = рс.ВыполнитьИнструкцию(ТекстЗапроса);
		тзДата.ВыбратьСтроки();

		Пока тзДата.ПолучитьСтроку() = 1 Цикл

			Если ПоФорме = 1 Тогда
				ГруппаСумма = тзДата.Группа_1 + тзДата.Группа_2 + тзДата.Группа_3 + тзДата.Группа_4 + тзДата.Группа_5;
			Иначе
				ГруппаСумма = тзДата.Группа_1 + тзДата.Группа_2 + тзДата.Группа_3 + тзДата.Группа_5;
			КонецЕсли;

			// Цікавить лише детальний (нероздроблений ROLLUP) рядок - Группировка_4
			Если (ГруппаСумма <> 0) Тогда
				Продолжить;
			КонецЕсли;

			Если ПоФорме = 1 Тогда
				Ключ = ЗначениеВСтрокуВнутр(тзДата.значение_1) + "|" + ЗначениеВСтрокуВнутр(тзДата.значение_2) + "|"
				     + ЗначениеВСтрокуВнутр(тзДата.значение_3) + "|" + ЗначениеВСтрокуВнутр(тзДата.значение_4) + "|"
				     + ЗначениеВСтрокуВнутр(тзДата.значение_5);
			Иначе
				Ключ = ЗначениеВСтрокуВнутр(тзДата.значение_1) + "|" + ЗначениеВСтрокуВнутр(тзДата.значение_2) + "|"
				     + ЗначениеВСтрокуВнутр(тзДата.значение_3) + "||" + ЗначениеВСтрокуВнутр(тзДата.значение_5);
			КонецЕсли;

			тз.НоваяСтрока();
			тз.значение_1 = тзДата.значение_1;
			тз.значение_2 = тзДата.значение_2;
			тз.значение_3 = тзДата.значение_3;
			Если ПоФорме = 1 Тогда
				тз.значение_4 = тзДата.значение_4;
			КонецЕсли;
			тз.значение_5 = тзДата.значение_5;
			тз.значение_6 = тзДата.значение_6;
			тз.Ключ = Ключ;
			тз.Период = ДатаИзменения;

		КонецЦикла;

	КонецЦикла;

	Если тз.КоличествоСтрок() = 0 Тогда
		Возврат;
	КонецЕсли;

	тз.Сортировать("+Ключ");

	тзИндекс = СоздатьОбъект("ИндексированнаяТаблица");
	тзИндекс.Загрузить(тз);
	тзИндекс.ДобавитьИндекс("ПоКлючу", "Ключ");

	тзЗнач = СоздатьОбъект("ТаблицаЗначений");
	тзЗнач.НоваяКолонка("Значение");
	Для НомерДаты = 1 По КолДат Цикл
		тзЗнач.НоваяСтрока();
	КонецЦикла;

	ПредыдущийКлюч = "";
	тз.ВыбратьСтроки();
	Пока тз.ПолучитьСтроку() = 1 Цикл

		// тз відсортована по Ключ - однакові Ключ йдуть підряд, обробляємо лише перше входження // + claude
		Если тз.Ключ = ПредыдущийКлюч Тогда
			Продолжить;
		КонецЕсли;
		ПредыдущийКлюч = тз.Ключ;

		Для НомерДаты = 1 По КолДат Цикл
			тзЗнач.УстановитьЗначение(НомерДаты, "Значение", 0);
		КонецЦикла;

		сзПошук = СоздатьОбъект("СписокЗначений");
		сзПошук.ДобавитьЗначение(ПредыдущийКлюч);
		тзИндекс.Подмножество(сзПошук, 1, "ПоКлючу");
		тзИндекс.ВыбратьСтроки("ПоКлючу");
		Пока тзИндекс.ПолучитьСтроку("ПоКлючу") = 1 Цикл
			Для НомерДаты = 1 По КолДат Цикл
				Если тзИндекс.Период = ДатыИзменений.ПолучитьЗначение(НомерДаты) Тогда
					тзЗнач.УстановитьЗначение(НомерДаты, "Значение", тзИндекс.значение_6);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Таб.ВывестиСекцию("Группировка_4|Секция_Группировки");

		Для НомерДаты = 1 По КолДат Цикл
			значение_6 = тзЗнач.ПолучитьЗначение(НомерДаты, "Значение");
			Если (ПустоеЗначение(значение_6) = 1) Тогда
				значение_6 = 0;
			КонецЕсли;
			тз.значение_6 = значение_6;
			Таб.ПрисоединитьСекцию("Группировка_4|Секция_Ресурсы");
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура Сформировать()
	Перем тз; 
	
	Если Обновить = 2 Тогда
	    СтрокаДействийФормы = "#Закрыть";
	КонецЕсли;
	
	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить("Список_1", Список_1);
	Расшифровка.Установить("Список_2", Список_2);
	Расшифровка.Установить("ПоФорме", ПоФорме);
	Расшифровка.Установить("ВыбДата",  ВыбДата);
	Расшифровка.Установить("НачДата", НачДата); // + claude
	Расшифровка.Установить("КонДата", КонДата); // + claude
	Расшифровка.Установить("Отчет", "ПоМатериаламФормУпаковки");
	
	Расшифровка.Установить("Обновить");
	
	СписокОтбор_1 = СоздатьОбъект("СписокЗначений");
	СписокОтбор_2  = СоздатьОбъект("СписокЗначений");
	
	Отбор_1 = Список_2.РазмерСписка();
	Отбор_2  = Список_1.РазмерСписка();
	
	// Подготовка к заполнению выходных форм данными запроса
	Если (ТипЗначенияСтр(Таб) <> "Таблица") ИЛИ (Обновить=0) Тогда
	  Таб = СоздатьОбъект("Таблица");
	Иначе
	  Таб.Очистить();
	КонецЕсли;
	
	Таб.ИсходнаяТаблица("ТабОтчета");
	ЗаголовокОтчета = ?(ПоФорме=1,"Материалы формы упаковки","Материалы упаковки");
	
	УстановитьЗаголовки();
	Таб.ВывестиСекцию("Кнопки|Секция_Группировки");
	Таб.ВывестиСекцию("Шапка|Секция_Группировки");
	Таб.Опции(0,0,Таб.ВысотаТаблицы(),0);

	// Дати змін періодичних реквізитів (Материал, НормаСписания) в межах НачДата..КонДата - по одній колонці на дату // + claude
	ДатыИзменений = ПолучитьДатыИзменений(НачДата, КонДата, ПоФорме); // + claude

	Если ДатыИзменений.РазмерСписка() = 0 Тогда // + claude
		ДатыИзменений.ДобавитьЗначение(КонДата); // + claude (немає змін за період - показуємо стан на кінець періоду)
	КонецЕсли; // + claude

	Для НомерДаты = 1 По ДатыИзменений.РазмерСписка() Цикл // + claude
		Заголовок_5 = "Количество на дату " + Строка(ДатыИзменений.ПолучитьЗначение(НомерДаты)); // + claude
		Таб.ПрисоединитьСекцию("Шапка|Секция_Ресурсы"); // + claude
	КонецЦикла; // + claude

	//Подготовим список материалов по условиям отбора
	Если Отбор_1 > 0 Тогда
		//Результат выборки материалов с учетом отбора
		рс = СоздатьОбъект("ODBCRecordset");
		ТекстЗапроса = 
		"SELECT ТМЦ.ID [Ссылка $Справочник.ТМЦ]
		|FROM $Справочник.ТМЦ AS ТМЦ 
		|WHERE ТМЦ.IsFolder = 2" + 
		?(Список_1.РазмерСписка() =0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор)") + "
		|ORDER BY ТМЦ.ID";
		рс.УложитьСписокОбъектов(Список_2, "#СписокОтбор", "ТМЦ");
		Результат = рс.ВыполнитьИнструкцию(ТекстЗапроса);
		Результат.Выгрузить(СписокОтбор_1,,,"Ссылка");
	КонецЕсли;
	
	//Подготовим список продукции с учетом отбора
	Если Отбор_2 > 0 Тогда
		рс = СоздатьОбъект("ODBCRecordset");
		ТекстЗапроса = 
		"SELECT ТМЦ.ID [Ссылка $Справочник.ТМЦ]
		|FROM $Справочник.ТМЦ AS ТМЦ
		|WHERE ТМЦ.IsFolder = 2" + 
		?(Список_1.РазмерСписка() =0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор)") + "
		|ORDER BY ТМЦ.ID";
		рс.УложитьСписокОбъектов(Список_1, "#СписокОтбор", "ТМЦ");
		Результат = рс.ВыполнитьИнструкцию(ТекстЗапроса);
		Результат.Выгрузить(СписокОтбор_2,,,"Ссылка");
	КонецЕсли;
		
	ЗаполнитьТаблицу(Таб, ДатыИзменений); // + claude

	Таб.ВывестиСекцию("Подвал");
	Таб.ТолькоПросмотр(1);
	Таб.Показать(ЗаголовокОтчета,"");

КонецПроцедуры
