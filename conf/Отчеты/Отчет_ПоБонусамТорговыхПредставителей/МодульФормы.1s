Перем ТабДокументы;
Перем Расшифровка;
Перем Обновить;
Перем Таб;

Процедура  Сформировать() Далее
Функция ОтфильтроватьЭлементыСотрудников(спСотрудников) Далее // + claude
Функция ЗагрузитьБонусы(Д1, Д2, спСотрудников) Далее // + claude
Процедура БонусПоМесяцу(ТЗБонусы, Сотрудник, МесяцКлюч, пСуммаБонусов) Далее // + claude
Функция ЗагрузитьОбороты(Д1, Д2, Сотрудник) Далее // + claude
Процедура ОборотыПоСхемам(ТЗОбороты, МесяцКлюч, пКво, пСумРеал, пСумДоход) Далее // + claude
Функция НайтиСотрудниковПоИмени(Имя) Далее // + claude
Процедура ЗагрузитьРасшифровкуПоСотруднику(НачМ, КонМ, Сотрудник, ТЗРасшифровка) Далее // + claude
Процедура ВывестиОтчетРасшифровку(РасшифровкаЯчейки)Далее

///////////////////////////////////Предопределенные процедуры/////////////////////////////////////////////// 

Процедура ПриОткрытии()
	
	Если глФлагРасшифровки = 1 Тогда 
		
		Обновить = глОбновить;
		
		ДатаНачала = глРасшифровка.Получить("ДатаНачала");
		ДатаОкончания = глРасшифровка.Получить("ДатаОкончания");
		глРасшифровка.Получить("списСотрудников").Выгрузить(списСотрудников);
		
		Если Обновить <> 0 Тогда
			Таб = глТаблица;
		КонецЕсли;           
		
		Если Обновить <> 2 Тогда
			Сформировать();
			СтатусВозврата(0);
			Возврат;       
		КонецЕсли;           
	Иначе
		Обновить = 0;
	КонецЕсли;

	Форма.КнопкаПоУмолчанию("Сформировать");
	
КонецПроцедуры

Процедура ОбработкаЯчейкиТаблицы(ТекЗначение,ТекФлагСтандОбраб,ТекТаблица,ТекАдрес)
	
	Если (ТипЗначения(ТекЗначение) = 2) И (ТекЗначение <> "СохранитиXLSX") Тогда
		ВывестиОтчетРасшифровку(ТекЗначение)
	Иначе
		глОбработкаЯчейкиТаблицы(ТекЗначение,ТекФлагСтандОбраб,ТекТаблица,ТекАдрес);
	КонецЕсли;
	
КонецПроцедуры
///////////////////////////////////Расшифровка//////////////////////////////////////////////////////////////

Функция РасшифровкаОбновить(Обновить)
	
	Расшифровка.Установить("Обновить", Обновить);
	
	Возврат Расшифровка;
	
КонецФункции

//////////////////////////////////Команды отчета/////////////////////////////////////////////////////////////

// Список Сотрудников для отбора может содержать иерархическую группу (не только
// элементы-сотрудников). Отбрасываем группы SQL-запросом по ISFOLDER = 2
// (только элементы), список отбора грузим через УложитьСписокОбъектов -
// по образцу Отчет_ПоНачисленнойЗарплатеСотрудников // + claude
Функция ОтфильтроватьЭлементыСотрудников(спСотрудников)

	спЭлементы = СоздатьОбъект("СписокЗначений");

	Если спСотрудников.РазмерСписка() = 0 Тогда
		Возврат спЭлементы;
	КонецЕсли; // + claude

	рс = СоздатьОбъект("ODBCRecordset");
	рс.УложитьСписокОбъектов(спСотрудников, "#СпСотр", "Сотрудники");

	ТекстЗапроса =
	"SELECT Сотрудники.ID [Сотрудник $Справочник.Сотрудники]
	|FROM $Справочник.Сотрудники AS Сотрудники
	|WHERE (Сотрудники.ID IN (SELECT Val FROM #СпСотр))
	|	AND (Сотрудники.ISFOLDER = 2)";

	РезСотрудники = рс.ВыполнитьИнструкцию(ТекстЗапроса);
	РезСотрудники.Выгрузить(спЭлементы,,,"Сотрудник");

	Возврат спЭлементы;

КонецФункции // ОтфильтроватьЭлементыСотрудников // + claude

// Кредитовий оборот по рахунку нарахування бонусів (сч. 661) за ВЕСЬ період
// звіту, по кожному місяцю - через штатний БухгалтерскиеИтоги (звичайний
// бухгалтерський запит 1С 7.7), а не прямий SQL до _1SENTRY. ИспользоватьСубконто
// з ОтборСубконто=1 ("по всіх значеннях", без конкретного Сотрудника) +
// Ит.ВыбратьСубконто()/ПолучитьСубконто()/Ит.Субконто() - забирає ВІДРАЗУ всіх
// співробітників за один запит на місяць (по зразку АнализСчетаПоСубконто),
// замість окремого запиту на кожного співробітника. КО() коректно враховує
// ручні корегуючі проводки з від'ємною сумою - без сурогатних SQL-гілок по
// ACCDTID/DTSC0 (LT77-296). Відбір по спСотрудників - по ЗначениеВСтрокуВнутр
// (список ключів-рядків), бо Ит.Субконто() і елементи спСотрудников
// матеріалізовані незалежно одне від одного - пряме "=" ненадійне. НачМесяца/
// КонМесяца - той самий помісячний прохід, що і в ТЗМесяцы (Сформировать),
// МесяцКлюч рахується так само (Лев(Формат(...,"ДГГГГММДД"),6)) для
// сумісності при порівнянні в БонусПоМесяцу // + claude
Функция ЗагрузитьБонусы(Д1, Д2, спСотрудников)

	спКлючиДозволених = СоздатьОбъект("СписокЗначений");
	Для НС = 1 По спСотрудников.РазмерСписка() Цикл
		спКлючиДозволених.ДобавитьЗначение(ЗначениеВСтрокуВнутр(спСотрудников.ПолучитьЗначение(НС)));
	КонецЦикла; // + claude

	ТЗБонусы = СоздатьОбъект("ТаблицаЗначений");
	ТЗБонусы.НоваяКолонка("Сотрудник");
	ТЗБонусы.НоваяКолонка("МесяцКлюч");
	ТЗБонусы.НоваяКолонка("СуммаБонусов");

	Счет661 = СчетПоКоду("661");

	ТекМесяц = НачМесяца(Д1);
	Пока ТекМесяц <= Д2 Цикл

		НачМ = Макс(Д1, ТекМесяц);
		КонМ = Мин(Д2, КонМесяца(ТекМесяц));

		Ит = СоздатьОбъект("БухгалтерскиеИтоги");
		Ит.ИспользоватьСубконто(ВидыСубконто.Сотрудники, , 1);

		Если Ит.ВыполнитьЗапрос(НачМ, КонМ, Счет661) = 1 Тогда

			Ит.ВыбратьСубконто();
			Пока Ит.ПолучитьСубконто() = 1 Цикл

				мСотрудникИт = Ит.Субконто();
				мСуммаБонусовИт = Ит.КО();

				Если (спКлючиДозволених.Принадлежит(ЗначениеВСтрокуВнутр(мСотрудникИт)) = 1) И (мСуммаБонусовИт <> 0) Тогда
					ТЗБонусы.НоваяСтрока();
					ТЗБонусы.Сотрудник = мСотрудникИт;
					ТЗБонусы.МесяцКлюч = Лев(Формат(ТекМесяц, "ДГГГГММДД"), 6);
					ТЗБонусы.СуммаБонусов = мСуммаБонусовИт;
				КонецЕсли; // + claude

			КонецЦикла; // + claude

		КонецЕсли; // + claude

		ТекМесяц = ДобавитьМесяц(ТекМесяц, 1);

	КонецЦикла; // + claude

	Возврат ТЗБонусы;

КонецФункции // ЗагрузитьБонусы // + claude

// Сумма бонусов КОНКРЕТНОМУ елементу довідника Сотрудник (не по Наименованию!) за
// місяць МесяцКлюч з уже завантаженої ТЗБонусы (див. ЗагрузитьБонусы) - пошук по
// пам'яті, без звернення до бази. Порівнюємо через ЗначениеВСтрокуВнутр (надійне
// порівняння двох незалежно матеріалізованих з ODBC посилань - пряме "=" в цьому
// файлі вже підводило), а НЕ по Наименованию: порівняння по імені раніше сумувало
// бонус ОБОХ елементів під двома різними співробітниками з однаковим ПІБ на КОЖЕН
// з них (подвоєння), замість того щоб дати кожному його власну суму і об'єднати
// їх один раз пізніше через ТЗДетали.Свернуть (LT77-296) // + claude
Процедура БонусПоМесяцу(ТЗБонусы, Сотрудник, МесяцКлюч, пСуммаБонусов)

	пСуммаБонусов = 0;
	мСотрудникСтр = ЗначениеВСтрокуВнутр(Сотрудник);

	ТЗБонусы.ВыбратьСтроки();
	Пока ТЗБонусы.ПолучитьСтроку() = 1 Цикл
		Если (ЗначениеВСтрокуВнутр(ТЗБонусы.Сотрудник) = мСотрудникСтр) И (ТЗБонусы.МесяцКлюч = МесяцКлюч) Тогда
			пСуммаБонусов = пСуммаБонусов + ТЗБонусы.СуммаБонусов;
		КонецЕсли; // + claude
	КонецЦикла; // + claude

КонецПроцедуры // БонусПоМесяцу // + claude

// SQL-запрос к Регистр.Обороты за ВЕСЬ период отчёта, отфильтрованный по конкретному
// сотруднику - джойном с табличной частью документа СхемаРасчетаБонуса по реквизиту
// Объект (тип Справочник - хранит либо Контрагента, либо Сотрудника). Подзапрос
// с DISTINCT IDDOC - чтобы несколько строк ТЧ с одним и тем же сотрудником не
// задваивали обороты по накладной. УложитьСписокОбъектов третьим параметром не
// принимает тип документа (только справочники/планы счетов) - поэтому фильтр по
// сотруднику через параметр, а не через временную таблицу. Вызывается в цикле по
// сотрудникам (см. Сформировать) - N запросов вместо N x M (сотрудник x месяц),
// как было раньше, и без самодельного индекса ИндексированнаяТаблица (LT77-296:
// поиск по нему работал некорректно). Ветка ВозвратнаяНакладная атрибутується НЕ
// по СхемаРБ самой возвратной накладной, а по СхемаРБ той РасходнаяНакладная, по
// якій товар був відвантажений (ТЧ ВозвратнаяНакладная.ДокПродажи) - тому рядки
// регістру фільтруються по ТМЦ і джойняться на ТЧ повернення, а через ДокПродажи -
// на саму РасходнаяНакладная (LT77-296, уточнення постановки). Якщо в одній
// ВозвратнаяНакладная кілька рядків з однаковим ТМЦ, але різними ДокПродажи (різні
// схеми бонусу), сума обороту по цьому ТМЦ (єдина в регістрі на позицію документа)
// потрапить в кожну відповідну схему - роздільного обороту по рядках ТЧ регістр
// не зберігає // + claude
Функция ЗагрузитьОбороты(Д1, Д2, Сотрудник)

	рс = СоздатьОбъект("ODBCRecordset");
	рс.УстановитьТекстовыйПараметр("НачалоПериода", Д1);
	рс.УстановитьТекстовыйПараметр("ОкончаниеПериода", Д2);
	рс.УстановитьТекстовыйПараметр("Сотрудник", Сотрудник);

	ТекстЗапроса =
	"SELECT Left(Журнал.DATE_TIME_IDDOC,6) МесяцКлюч
	|	, Sum(ОборотыОбороты.РасходКвоОборот) Кво
	|	, Sum(ОборотыОбороты.РасходСумОборот) СумРеал
	|	, Sum(ОборотыОбороты.ДоходОборот) СумДоход
	|FROM $Документ.РасходнаяНакладная AS РасходнаяНакладная
	|	INNER JOIN _1SJOURN AS Журнал ON РасходнаяНакладная.IDDOC = Журнал.IDDOC
	|	INNER JOIN (SELECT DISTINCT СхемаСтроки.IDDOC IDDOC
	|		FROM $ДокументСтроки.СхемаРасчетаБонуса AS СхемаСтроки
	|			INNER JOIN _1SJOURN AS СхемаЖ ON СхемаСтроки.IDDOC = СхемаЖ.IDDOC
	|		WHERE ($СхемаСтроки.Объект = :Сотрудник~)
	|			AND ((СхемаЖ.CLOSED & 1) = 1)) AS СхемыСотрудника
	|		ON $РасходнаяНакладная.СхемаРБ = СхемыСотрудника.IDDOC
	|	INNER JOIN $РегистрОбороты.Обороты(:НачалоПериода,
	|		:ОкончаниеПериода,
	|		Документ) AS ОборотыОбороты ON Журнал.DATE_TIME_IDDOC = ОборотыОбороты.ПозицияДокумента
	|WHERE (Журнал.DATE_TIME_IDDOC >= :НачалоПериода)
	|	AND (Журнал.DATE_TIME_IDDOC <= :ОкончаниеПериода~)
	|	AND ((Журнал.CLOSED & 1) = 1)
	|GROUP BY Left(Журнал.DATE_TIME_IDDOC,6)
	|UNION ALL
	|SELECT Left(Журнал.DATE_TIME_IDDOC,6) МесяцКлюч
	|	, Sum(ОборотыОбороты.РасходКвоОборот) Кво
	|	, Sum(ОборотыОбороты.РасходСумОборот) СумРеал
	|	, Sum(ОборотыОбороты.ДоходОборот) СумДоход
	|FROM $Документ.ВозвратнаяНакладная AS ВозвратнаяНакладная
	|	INNER JOIN _1SJOURN AS Журнал ON ВозвратнаяНакладная.IDDOC = Журнал.IDDOC
	|	INNER JOIN $РегистрОбороты.Обороты(:НачалоПериода,
	|		:ОкончаниеПериода,
	|		Документ) AS ОборотыОбороты ON Журнал.DATE_TIME_IDDOC = ОборотыОбороты.ПозицияДокумента
	|	INNER JOIN $ДокументСтроки.ВозвратнаяНакладная AS ВознакСтроки
	|		ON (ВознакСтроки.IDDOC = ВозвратнаяНакладная.IDDOC)
	|			AND ($ВознакСтроки.ТМЦ = ОборотыОбороты.ТМЦ)
	|	INNER JOIN $Документ.РасходнаяНакладная AS РНПродажи ON $ВознакСтроки.ДокПродажи = РНПродажи.IDDOC
	|	INNER JOIN (SELECT DISTINCT СхемаСтроки.IDDOC IDDOC
	|		FROM $ДокументСтроки.СхемаРасчетаБонуса AS СхемаСтроки
	|			INNER JOIN _1SJOURN AS СхемаЖ ON СхемаСтроки.IDDOC = СхемаЖ.IDDOC
	|		WHERE ($СхемаСтроки.Объект = :Сотрудник~)
	|			AND ((СхемаЖ.CLOSED & 1) = 1)) AS СхемыСотрудника
	|		ON $РНПродажи.СхемаРБ = СхемыСотрудника.IDDOC
	|WHERE (Журнал.DATE_TIME_IDDOC >= :НачалоПериода)
	|	AND (Журнал.DATE_TIME_IDDOC <= :ОкончаниеПериода~)
	|	AND ((Журнал.CLOSED & 1) = 1)
	|GROUP BY Left(Журнал.DATE_TIME_IDDOC,6)";

	РезОбороты = рс.ВыполнитьИнструкцию(ТекстЗапроса);

	ТЗОбороты = СоздатьОбъект("ТаблицаЗначений");
	ТЗОбороты.Загрузить(РезОбороты);

	Возврат ТЗОбороты;

КонецФункции // ЗагрузитьОбороты // + claude

// Суммирует Кво/СуммаРеализовано/СуммаДоход из ТЗОбороты (см. ЗагрузитьОбороты,
// уже отфильтрованной по сотруднику) за месяц МесяцКлюч (ГГГГММ). Таблица маленькая
// (пара строк на месяц из UNION ALL), поэтому простой перебор строк, без индекса // + claude
Процедура ОборотыПоСхемам(ТЗОбороты, МесяцКлюч, пКво, пСумРеал, пСумДоход)

	пКво = 0;
	пСумРеал = 0;
	пСумДоход = 0;

	ТЗОбороты.ВыбратьСтроки();
	Пока ТЗОбороты.ПолучитьСтроку() = 1 Цикл
		Если ТЗОбороты.МесяцКлюч = МесяцКлюч Тогда
			пКво = пКво + ТЗОбороты.Кво;
			пСумРеал = пСумРеал + ТЗОбороты.СумРеал;
			пСумДоход = пСумДоход + ТЗОбороты.СумДоход;
		КонецЕсли; // + claude
	КонецЦикла; // + claude

КонецПроцедуры // ОборотыПоСхемам // + claude

Процедура Сформировать()

	Если ПустоеЗначение(ДатаНачала) = 1 Тогда
		Предупреждение("Не заполнена дата начала периода");
		Возврат;
	КонецЕсли; // + claude

	Если ПустоеЗначение(ДатаОкончания) = 1 Тогда
		Предупреждение("Не заполнена дата окончания периода");
		Возврат;
	КонецЕсли; // + claude

	Если списСотрудников.РазмерСписка() = 0 Тогда
		Предупреждение("Не выбраны торговые представители");
		Возврат;
	КонецЕсли; // + claude
	
	
	Если Обновить = 2 Тогда
		СтрокаДействийФормы = "#Закрыть";
	КонецЕсли;
	
	//Расшифровка
	Расшифровка = СоздатьОбъект("СписокЗначений");
	
	Расшифровка.Установить("ДатаНачала", ДатаНачала);
	Расшифровка.Установить("ДатаОкончания", ДатаОкончания);
	
	Расшифровка.Установить("списСотрудников", списСотрудников);
		
	Расшифровка.Установить("Отчет", "Отчет_ПоБонусамТорговыхПредставителей");
	Расшифровка.Установить("Обновить");
	
	// Подготовка к заполнению выходных форм данными запроса
	Если (ТипЗначенияСтр(Таб) <> "Таблица") ИЛИ (Обновить=0) Тогда
		Таб = СоздатьОбъект("Таблица");
	Иначе
		Таб.Очистить();
	КонецЕсли;

	// список отбора может содержать иерархическую группу - берём только элементы // + claude
	списЭлементовСотрудников = ОтфильтроватьЭлементыСотрудников(списСотрудников);

	Если списЭлементовСотрудников.РазмерСписка() = 0 Тогда
		Предупреждение("Среди выбранных торговых представителей нет элементов (только группы)");
		Возврат;
	КонецЕсли; // + claude

	Состояние("Формирование отчета...");

	// таблица месяцев периода - в ней же копим итоги по столбцам (по месяцу, по всем сотрудникам) // + claude
	ТЗМесяцы = СоздатьОбъект("ТаблицаЗначений");
	ТЗМесяцы.НоваяКолонка("НачМ");
	ТЗМесяцы.НоваяКолонка("КонМ");
	ТЗМесяцы.НоваяКолонка("Месяц");
	ТЗМесяцы.НоваяКолонка("МесяцКлюч");
	ТЗМесяцы.НоваяКолонка("Кво");
	ТЗМесяцы.НоваяКолонка("СумРеал");
	ТЗМесяцы.НоваяКолонка("СумДоход");
	ТЗМесяцы.НоваяКолонка("СумБонус"); // + claude

	ТекМесяц = НачМесяца(ДатаНачала);
	Пока ТекМесяц <= ДатаОкончания Цикл
		ТЗМесяцы.НоваяСтрока();
		ТЗМесяцы.НачМ = Макс(ДатаНачала, ТекМесяц);
		ТЗМесяцы.КонМ = Мин(ДатаОкончания, КонМесяца(ТекМесяц));
		ТЗМесяцы.Месяц = Формат(ТекМесяц, "ДММММГГГГ");
		ТЗМесяцы.МесяцКлюч = Лев(Формат(ТекМесяц, "ДГГГГММДД"), 6);;
		ТЗМесяцы.Кво = 0;
		ТЗМесяцы.СумРеал = 0;
		ТЗМесяцы.СумДоход = 0;
		ТЗМесяцы.СумБонус = 0;
		ТекМесяц = ДобавитьМесяц(ТекМесяц, 1);
	КонецЦикла; // + claude

	// один запрос бонусов сразу по всем выбранным сотрудникам за весь период -
	// вместо отдельного запроса на каждую пару сотрудник/месяц (LT77-296: медленно) // + claude
	ТЗБонусы = ЗагрузитьБонусы(ДатаНачала, ДатаОкончания, списЭлементовСотрудников);

	// деталізація по кожному елементу довідника Сотрудники і кожному місяцю періоду -
	// готуємо ДО виводу в табДок, щоб потім згрупувати по Наименованию (Свернуть,
	// на випадок кількох елементів довідника з однаковим ПІБ) і пропустити
	// співробітників без жодного бонусу за весь період (LT77-296) // + claude
	ТЗДетали = СоздатьОбъект("ТаблицаЗначений");
	ТЗДетали.НоваяКолонка("СотрудникНаименование");
	ТЗДетали.НоваяКолонка("МесяцКлюч");
	ТЗДетали.НоваяКолонка("Кво");
	ТЗДетали.НоваяКолонка("СумРеал");
	ТЗДетали.НоваяКолонка("СумДоход");
	ТЗДетали.НоваяКолонка("СумБонус");

	Кво = 0;
	СуммаРеализовано = 0;
	СуммаДоход = 0;
	СуммаБонусы = 0; // + claude (объявление до передачи как выходных параметров)

	Для НС = 1 По списЭлементовСотрудников.РазмерСписка() Цикл

		Сотрудник = списЭлементовСотрудников.ПолучитьЗначение(НС);
		СотрудникНаименование = СокрЛП(Сотрудник.Наименование);

		// запрос по оборотам фильтруется по сотруднику (джойн с ТЧ СхемаРасчетаБонуса) - в цикле по сотрудникам // + claude
		ТЗОбороты = ЗагрузитьОбороты(ДатаНачала, ДатаОкончания, Сотрудник);

		ТЗМесяцы.ВыбратьСтроки();
		Пока ТЗМесяцы.ПолучитьСтроку() = 1 Цикл

			ОборотыПоСхемам(ТЗОбороты, ТЗМесяцы.МесяцКлюч, Кво, СуммаРеализовано, СуммаДоход);
			БонусПоМесяцу(ТЗБонусы, Сотрудник, ТЗМесяцы.МесяцКлюч, СуммаБонусы);

			ТЗДетали.НоваяСтрока();
			ТЗДетали.СотрудникНаименование = СотрудникНаименование;
			ТЗДетали.МесяцКлюч = ТЗМесяцы.МесяцКлюч;
			ТЗДетали.Кво = Кво;
			ТЗДетали.СумРеал = СуммаРеализовано;
			ТЗДетали.СумДоход = СуммаДоход;
			ТЗДетали.СумБонус = СуммаБонусы; // + claude
			
		КонецЦикла; // + claude

	КонецЦикла; // + claude

	// однакові ПІБ (різні елементи довідника) зливаються в один рядок звіту // + claude
	ТЗДетали.Свернуть("СотрудникНаименование,МесяцКлюч", "Кво,СумРеал,СумДоход,СумБонус");
	ТЗДетали.Сортировать("СотрудникНаименование,МесяцКлюч");

	Таб.ИсходнаяТаблица("ТаблицаОтчета");
	//Кнопки
	Таб.ВывестиСекцию("Кнопки");

	// Шапка: колонка "Сотрудник" (заголовок "Торговый представник") открывает
	// строку, затем по одному блоку "Период" на месяц и блок "ПириодИтоги" // + claude
	Таб.ВывестиСекцию("Шапка|Сотрудник");

	Таб.Опции(0, 0, Таб.ВысотаТаблицы(), 0);

	Состояние("Заполнение выходной таблицы...");

	ТЗМесяцы.ВыбратьСтроки();
	Пока ТЗМесяцы.ПолучитьСтроку() = 1 Цикл
		ПериодМесяц = ТЗМесяцы.Месяц;
		Таб.ПрисоединитьСекцию("Шапка|Период_1");
		Если фДоход = 1 Тогда
			Таб.ПрисоединитьСекцию("Шапка|Период_2");
		КонецЕсли; // + claude
		Таб.ПрисоединитьСекцию("Шапка|Период_3");
	КонецЦикла;
	Таб.ПрисоединитьСекцию("Шапка|ПириодИтоги_1");
	Если фДоход = 1 Тогда
		Таб.ПрисоединитьСекцию("Шапка|ПириодИтоги_2");
	КонецЕсли; // + claude
	Таб.ПрисоединитьСекцию("Шапка|ПириодИтоги_3"); // + claude

	ГрандКво = 0;
	ГрандСуммаРеализовано = 0;
	ГрандСуммаДоход = 0;
	ГрандСуммаБонусы = 0; // + claude

	ТЗДетали.ВыбратьСтроки();
	ЕстьСтрока = ТЗДетали.ПолучитьСтроку();

	Пока ЕстьСтрока = 1 Цикл

		ИмяТекущее = ТЗДетали.СотрудникНаименование;

		// накопичувач місячних сум одного співробітника (ПІБ) - щоб перевірити
		// його на "пропустити" (немає бонусів за весь період) ДО виводу секцій
		// табДок. Пересоздаём объект каждую итерацию - ТаблицаЗначений.Очистить()
		// удаляет и колонки тоже (не только строки) // + claude
		мМесяцДанные = СоздатьОбъект("ТаблицаЗначений");
		мМесяцДанные.НоваяКолонка("Кво");
		мМесяцДанные.НоваяКолонка("СумРеал");
		мМесяцДанные.НоваяКолонка("СумДоход");
		мМесяцДанные.НоваяКолонка("СумБонус");
		мМесяцДанные.НоваяКолонка("МесяцКлюч");

		ИтогоКвоЕмп = 0;
		ИтогоСуммаРеализованоЕмп = 0;
		ИтогоСуммаДоходЕмп = 0;
		ИтогоСуммаБонусыЕмп = 0; // + claude

		Пока (ЕстьСтрока = 1) И (ТЗДетали.СотрудникНаименование = ИмяТекущее) Цикл

			мМесяцДанные.НоваяСтрока();
			мМесяцДанные.Кво = ТЗДетали.Кво;
			мМесяцДанные.СумРеал = ТЗДетали.СумРеал;
			мМесяцДанные.СумДоход = ТЗДетали.СумДоход;
			мМесяцДанные.СумБонус = ТЗДетали.СумБонус;
			мМесяцДанные.МесяцКлюч = ТЗДетали.МесяцКлюч;

			ИтогоКвоЕмп = ИтогоКвоЕмп + ТЗДетали.Кво;
			ИтогоСуммаРеализованоЕмп = ИтогоСуммаРеализованоЕмп + ТЗДетали.СумРеал;
			ИтогоСуммаДоходЕмп = ИтогоСуммаДоходЕмп + ТЗДетали.СумДоход;
			ИтогоСуммаБонусыЕмп = ИтогоСуммаБонусыЕмп + ТЗДетали.СумБонус; // + claude

			ЕстьСтрока = ТЗДетали.ПолучитьСтроку();

		КонецЦикла; // + claude

		// немає жодного бонусу за весь період - рядок в звіт не виводимо // + claude
		Если ИтогоСуммаБонусыЕмп = 0 Тогда
			Продолжить;
		КонецЕсли; // + claude

		СотрудникНаименование = ИмяТекущее;

		Таб.ВывестиСекцию("Строка|Сотрудник");

		мИндексМесяца = 0;

		мМесяцДанные.ВыбратьСтроки();
		Пока мМесяцДанные.ПолучитьСтроку() = 1 Цикл

			Кво = мМесяцДанные.Кво;
			СуммаРеализовано = мМесяцДанные.СумРеал;
			СуммаДоход = мМесяцДанные.СумДоход;
			СуммаБонусы = мМесяцДанные.СумБонус;

			СуммаБонусыНаКг = ?(Кво <> 0, Окр(СуммаБонусы / Кво, 2), 0);
			ПроцентБонусовКРеализации = ?(СуммаРеализовано <> 0, Окр(СуммаБонусы / СуммаРеализовано * 100, 2), 0); // + claude

			// накопление итогов по столбцу (месяцу) для секции "Итоги" - месяца в
			// мМесяцДанные идут в том же порядке, что и в ТЗМесяцы (сортировка
			// по МесяцКлюч совпадает с хронологическим порядком) // + claude
			мИндексМесяца = мИндексМесяца + 1;
			ТЗМесяцы.ПолучитьСтрокуПоНомеру(мИндексМесяца);
			ТЗМесяцы.Кво = ТЗМесяцы.Кво + Кво;
			ТЗМесяцы.СумРеал = ТЗМесяцы.СумРеал + СуммаРеализовано;
			ТЗМесяцы.СумДоход = ТЗМесяцы.СумДоход + СуммаДоход;
			ТЗМесяцы.СумБонус = ТЗМесяцы.СумБонус + СуммаБонусы; // + claude
			
			РасшифровкаЯчейки = СотрудникНаименование + "&" + мМесяцДанные.МесяцКлюч;

			Таб.ПрисоединитьСекцию("Строка|Период_1");
			Если фДоход = 1 Тогда
				Таб.ПрисоединитьСекцию("Строка|Период_2");
			КонецЕсли; // + claude
			Таб.ПрисоединитьСекцию("Строка|Период_3");

		КонецЦикла; // + claude

		ИтогоПериодСтрокаКво = ИтогоКвоЕмп;
		ИтогоПериодСтрокаСуммаРеализовано = ИтогоСуммаРеализованоЕмп;
		ИтогоПериодСтрокаСуммаДоход = ИтогоСуммаДоходЕмп;
		ИтогоПериодСтрокаСуммаБонусы = ИтогоСуммаБонусыЕмп;
		ИтогоПериодСтрокаСуммаБонусыНаКг = ?(ИтогоКвоЕмп <> 0, Окр(ИтогоСуммаБонусыЕмп / ИтогоКвоЕмп, 2), 0);
		ИтогоПериодСтрокаПроцентБонусовКРеализации = ?(ИтогоСуммаРеализованоЕмп <> 0, Окр(ИтогоСуммаБонусыЕмп / ИтогоСуммаРеализованоЕмп * 100, 2), 0); // + claude

		Таб.ПрисоединитьСекцию("Строка|ПириодИтоги_1");
		Если фДоход = 1 Тогда
			Таб.ПрисоединитьСекцию("Строка|ПириодИтоги_2");
		КонецЕсли; // + claude
		Таб.ПрисоединитьСекцию("Строка|ПириодИтоги_3"); // + claude

		ГрандКво = ГрандКво + ИтогоКвоЕмп;
		ГрандСуммаРеализовано = ГрандСуммаРеализовано + ИтогоСуммаРеализованоЕмп;
		ГрандСуммаДоход = ГрандСуммаДоход + ИтогоСуммаДоходЕмп;
		ГрандСуммаБонусы = ГрандСуммаБонусы + ИтогоСуммаБонусыЕмп; // + claude

	КонецЦикла; // + claude

	// Итоги: "Разом:" + один блок "Период" на месяц (итог по столбцу) + блок "Итого" (общий итог) // + claude
	Таб.ВывестиСекцию("Итоги|Сотрудник");

	ТЗМесяцы.ВыбратьСтроки();
	Пока ТЗМесяцы.ПолучитьСтроку() = 1 Цикл

		ИтогоКво = ТЗМесяцы.Кво;
		ИтогоКвоСуммаРеализовано = ТЗМесяцы.СумРеал;
		ИтогоКвоСуммаДоход = ТЗМесяцы.СумДоход;
		ИтогоКвоСуммаБонусы = ТЗМесяцы.СумБонус;
		ИтогоКвоСуммаБонусыНаКг = ?(ТЗМесяцы.Кво <> 0, Окр(ТЗМесяцы.СумБонус / ТЗМесяцы.Кво, 2), 0);
		ИтогоКвоПроцентБонусовКРеализации = ?(ТЗМесяцы.СумРеал <> 0, Окр(ТЗМесяцы.СумБонус / ТЗМесяцы.СумРеал * 100, 2), 0); // + claude

		Таб.ПрисоединитьСекцию("Итоги|Период_1");
		Если фДоход = 1 Тогда
			Таб.ПрисоединитьСекцию("Итоги|Период_2");
		КонецЕсли; // + claude
		Таб.ПрисоединитьСекцию("Итоги|Период_3");

	КонецЦикла; // + claude

	ИтогоПериодКвоКво = ГрандКво;
	ИтогоПериодСуммаРеализовано = ГрандСуммаРеализовано;
	ИтогоПериодСуммаДоход = ГрандСуммаДоход;
	ИтогоПериодСуммаБонусы = ГрандСуммаБонусы;
	ИтогоПериодСуммаБонусыНаКг = ?(ГрандКво <> 0, Окр(ГрандСуммаБонусы / ГрандКво, 2), 0);
	ИтогоПериодПроцентБонусовКРеализации = ?(ГрандСуммаРеализовано <> 0, Окр(ГрандСуммаБонусы / ГрандСуммаРеализовано * 100, 2), 0); // + claude

	Таб.ПрисоединитьСекцию("Итоги|ПириодИтоги_1");
	Если фДоход = 1 Тогда
		Таб.ПрисоединитьСекцию("Итоги|ПириодИтоги_2");
	КонецЕсли; // + claude
	Таб.ПрисоединитьСекцию("Итоги|ПириодИтоги_3"); // + claude

	Таб.ТолькоПросмотр(1);
	Таб.Показать("Отчет по бонусам торговых представителей", "");

КонецПроцедуры

// Ищет элементы Справочник.Сотрудники по Наименованию (может быть несколько -
// см. Свернуть в Сформировать, где строки разных элементов с одинаковым ПІБ
// сливаются в один рядок звіту). Только элементы (ISFOLDER = 2), без групп // + claude
Функция НайтиСотрудниковПоИмени(Имя)

	спЭлементы = СоздатьОбъект("СписокЗначений");

	рс = СоздатьОбъект("ODBCRecordset");
	рс.УстановитьТекстовыйПараметр("Имя", Имя);

	ТекстЗапроса =
	"SELECT Сотрудники.ID [Сотрудник $Справочник.Сотрудники]
	|FROM $Справочник.Сотрудники AS Сотрудники
	|WHERE (Сотрудники.DESCR = :Имя)
	|	AND (Сотрудники.ISFOLDER = 2)";

	РезСотрудники = рс.ВыполнитьИнструкцию(ТекстЗапроса);
	РезСотрудники.Выгрузить(спЭлементы,,,"Сотрудник");

	Возврат спЭлементы;

КонецФункции // НайтиСотрудниковПоИмени // + claude

// Расшифровка по одному сотруднику за один месяц (НачМ-КонМ) - по каждому
// документу (РасходнаяНакладная/ВозвратнаяНакладная), с его Контрагентом и
// СхемаРБ. Строки добавляются в уже созданную ТЗРасшифровка (накопитель -
// расшифровка может объединять несколько элементов справочника с одинаковым
// ПІБ, см. НайтиСотрудниковПоИмени). Ветка ВозвратнаяНакладная синхронізована
// з ЗагрузитьОбороты - СхемаРБ і Контрагент беруться з РасходнаяНакладная
// (ДокПродажи), а не з самої накладної повернення, тому один документ
// повернення з рядками від різних ДокПродажи може дати кілька рядків
// розшифровки (LT77-296) // + claude
Процедура ЗагрузитьРасшифровкуПоСотруднику(НачМ, КонМ, Сотрудник, ТЗРасшифровка)

	рс = СоздатьОбъект("ODBCRecordset");
	рс.УстановитьТекстовыйПараметр("НачМ", НачМ);
	рс.УстановитьТекстовыйПараметр("КонМ", КонМ);
	рс.УстановитьТекстовыйПараметр("Сотрудник", Сотрудник);

	ТекстЗапроса =
	"SELECT Журнал.IDDOC [Документ $Документ]
	|	, Журнал.IDDOCDEF Документ_вид
	|	, $РасходнаяНакладная.СхемаРБ [СхемаРБ $Документ.СхемаРасчетаБонуса]
	|	, $РасходнаяНакладная.Контрагент [Контрагент $Справочник.Контрагенты]
	|	, Sum(ОборотыОбороты.РасходКвоОборот) Кво
	|	, Sum(ОборотыОбороты.РасходСумОборот) СумРеал
	|	, Sum(ОборотыОбороты.ДоходОборот) СумДоход
	|FROM $Документ.РасходнаяНакладная AS РасходнаяНакладная
	|	INNER JOIN _1SJOURN AS Журнал ON РасходнаяНакладная.IDDOC = Журнал.IDDOC
	|	INNER JOIN (SELECT DISTINCT СхемаСтроки.IDDOC IDDOC
	|		FROM $ДокументСтроки.СхемаРасчетаБонуса AS СхемаСтроки
	|			INNER JOIN _1SJOURN AS СхемаЖ ON СхемаСтроки.IDDOC = СхемаЖ.IDDOC
	|		WHERE ($СхемаСтроки.Объект = :Сотрудник~)
	|			AND ((СхемаЖ.CLOSED & 1) = 1)) AS СхемыСотрудника
	|		ON $РасходнаяНакладная.СхемаРБ = СхемыСотрудника.IDDOC
	|	INNER JOIN $РегистрОбороты.Обороты(:НачМ,
	|		:КонМ,
	|		Документ) AS ОборотыОбороты ON Журнал.DATE_TIME_IDDOC = ОборотыОбороты.ПозицияДокумента
	|WHERE (Журнал.DATE_TIME_IDDOC >= :НачМ)
	|	AND (Журнал.DATE_TIME_IDDOC <= :КонМ~)
	|	AND ((Журнал.CLOSED & 1) = 1)
	|GROUP BY Журнал.IDDOC, Журнал.IDDOCDEF, $РасходнаяНакладная.СхемаРБ, $РасходнаяНакладная.Контрагент
	|UNION ALL
	|SELECT Журнал.IDDOC [Документ $Документ]
	|	, Журнал.IDDOCDEF Документ_вид
	|	, $РНПродажи.СхемаРБ [СхемаРБ $Документ.СхемаРасчетаБонуса]
	|	, $РНПродажи.Контрагент [Контрагент $Справочник.Контрагенты]
	|	, Sum(ОборотыОбороты.РасходКвоОборот) Кво
	|	, Sum(ОборотыОбороты.РасходСумОборот) СумРеал
	|	, Sum(ОборотыОбороты.ДоходОборот) СумДоход
	|FROM $Документ.ВозвратнаяНакладная AS ВозвратнаяНакладная
	|	INNER JOIN _1SJOURN AS Журнал ON ВозвратнаяНакладная.IDDOC = Журнал.IDDOC
	|	INNER JOIN $РегистрОбороты.Обороты(:НачМ,
	|		:КонМ,
	|		Документ) AS ОборотыОбороты ON Журнал.DATE_TIME_IDDOC = ОборотыОбороты.ПозицияДокумента
	|	INNER JOIN $ДокументСтроки.ВозвратнаяНакладная AS ВознакСтроки
	|		ON (ВознакСтроки.IDDOC = ВозвратнаяНакладная.IDDOC)
	|			AND ($ВознакСтроки.ТМЦ = ОборотыОбороты.ТМЦ)
	|	INNER JOIN $Документ.РасходнаяНакладная AS РНПродажи ON $ВознакСтроки.ДокПродажи = РНПродажи.IDDOC
	|	INNER JOIN (SELECT DISTINCT СхемаСтроки.IDDOC IDDOC
	|		FROM $ДокументСтроки.СхемаРасчетаБонуса AS СхемаСтроки
	|			INNER JOIN _1SJOURN AS СхемаЖ ON СхемаСтроки.IDDOC = СхемаЖ.IDDOC
	|		WHERE ($СхемаСтроки.Объект = :Сотрудник~)
	|			AND ((СхемаЖ.CLOSED & 1) = 1)) AS СхемыСотрудника
	|		ON $РНПродажи.СхемаРБ = СхемыСотрудника.IDDOC
	|WHERE (Журнал.DATE_TIME_IDDOC >= :НачМ)
	|	AND (Журнал.DATE_TIME_IDDOC <= :КонМ~)
	|	AND ((Журнал.CLOSED & 1) = 1)
	|GROUP BY Журнал.IDDOC, Журнал.IDDOCDEF, $РНПродажи.СхемаРБ, $РНПродажи.Контрагент";

	РезРасшифровка = рс.ВыполнитьИнструкцию(ТекстЗапроса);

	ТЗДоп = СоздатьОбъект("ТаблицаЗначений");
	ТЗДоп.Загрузить(РезРасшифровка);

	ТЗДоп.ВыбратьСтроки();
	Пока ТЗДоп.ПолучитьСтроку() = 1 Цикл
		ТЗРасшифровка.НоваяСтрока();
		ТЗРасшифровка.Документ = ТЗДоп.Документ;
		ТЗРасшифровка.СхемаРБ = ТЗДоп.СхемаРБ;
		ТЗРасшифровка.Контрагент = ТЗДоп.Контрагент;
		ТЗРасшифровка.Кво = ТЗДоп.Кво;
		ТЗРасшифровка.СумРеал = ТЗДоп.СумРеал;
		ТЗРасшифровка.СумДоход = ТЗДоп.СумДоход;
	КонецЦикла; // + claude

КонецПроцедуры // ЗагрузитьРасшифровкуПоСотруднику // + claude

// Обработчик клика по ячейке "Строка|Период" отчёта (см. ОбработкаЯчейкиТаблицы,
// РасшифровкаЯчейки = СотрудникНаименование + "&" + МесяцКлюч, см. Сформировать) -
// показывает разбивку бонуса по документам за этот месяц для этого сотрудника // + claude
Процедура ВывестиОтчетРасшифровку(РасшифровкаЯчейки)

	ПозицияРазделителя = Найти(РасшифровкаЯчейки, "&");
	Если ПозицияРазделителя = 0 Тогда
		Возврат;
	КонецЕсли; // + claude

	ИмяСотрудника = Сред(РасшифровкаЯчейки, 1, ПозицияРазделителя - 1);
	МесяцКлюч = Сред(РасшифровкаЯчейки, ПозицияРазделителя + 1);

	НачМ = Дата("01." + Прав(МесяцКлюч, 2) + "." + Лев(МесяцКлюч, 4));
	КонМ = КонМесяца(НачМ);

	спСотрудников = НайтиСотрудниковПоИмени(ИмяСотрудника);

	Если спСотрудников.РазмерСписка() = 0 Тогда
		Предупреждение("Сотрудник не найден: " + ИмяСотрудника);
		Возврат;
	КонецЕсли; // + claude

	ТЗРасшифровка = СоздатьОбъект("ТаблицаЗначений");
	ТЗРасшифровка.НоваяКолонка("Документ");
	ТЗРасшифровка.НоваяКолонка("СхемаРБ");
	ТЗРасшифровка.НоваяКолонка("Контрагент");
	ТЗРасшифровка.НоваяКолонка("Кво");
	ТЗРасшифровка.НоваяКолонка("СумРеал");
	ТЗРасшифровка.НоваяКолонка("СумДоход");

	Для Инд = 1 По спСотрудников.РазмерСписка() Цикл
		ЗагрузитьРасшифровкуПоСотруднику(НачМ, КонМ, спСотрудников.ПолучитьЗначение(Инд), ТЗРасшифровка);
	КонецЦикла; // + claude

	Таб = СоздатьОбъект("Таблица");
	Таб.ИсходнаяТаблица("ТаблицаРасшифровки");

	СотрудникНаименование = ИмяСотрудника;
	ПериодМесяц = Формат(НачМ, "ММММ ГГГГ");

	// Вертикаль_1 (Сотрудник..СумРеал) виводиться завжди, Вертикаль_2 (СумДоход) -
	// тільки коли увімкнено чекбокс "Выводить доход" (фДоход), за зразком
	// Период_1/_2/_3 в ТаблицаОтчета (LT77-296) // + claude
	Таб.ВывестиСекцию("Шапка|Вертикаль_1");
	Если фДоход = 1 Тогда
		Таб.ПрисоединитьСекцию("Шапка|Вертикаль_2");
	КонецЕсли; // + claude

	ИтогоКво = 0;
	ИтогоКвоСуммаРеализовано = 0;
	ИтогоКвоСуммаДоход = 0; // + claude

	ТЗРасшифровка.ВыбратьСтроки();
	Пока ТЗРасшифровка.ПолучитьСтроку() = 1 Цикл

		Документ = ТЗРасшифровка.Документ;
		СхемаРБ = ТЗРасшифровка.СхемаРБ;
		Контрагент = ТЗРасшифровка.Контрагент;
		Кво = ТЗРасшифровка.Кво;
		СуммаРеализовано = ТЗРасшифровка.СумРеал;
		СуммаДоход = ТЗРасшифровка.СумДоход;

		ИтогоКво = ИтогоКво + Кво;
		ИтогоКвоСуммаРеализовано = ИтогоКвоСуммаРеализовано + СуммаРеализовано;
		ИтогоКвоСуммаДоход = ИтогоКвоСуммаДоход + СуммаДоход; // + claude

		Таб.ВывестиСекцию("Строка|Вертикаль_1");
		Если фДоход = 1 Тогда
			Таб.ПрисоединитьСекцию("Строка|Вертикаль_2");
		КонецЕсли; // + claude

	КонецЦикла; // + claude

	Таб.ВывестиСекцию("Итоги|Вертикаль_1");
	Если фДоход = 1 Тогда
		Таб.ПрисоединитьСекцию("Итоги|Вертикаль_2");
	КонецЕсли; // + claude

	Таб.ТолькоПросмотр(1);
	Таб.Показать("Расшифровка для Отчета по бонусам торговых представителей", "");

КонецПроцедуры // ВывестиОтчетРасшифровку // + claude

///////////////////////////////////Работа со списками отбора и подбором///////////////////////////////////////

Процедура ДобавитьВСписок(Элт, Спис)
	
	Если Спис.Принадлежит(Элт) = 0 Тогда
		Спис.ДобавитьЗначение(Элт, Элт.Наименование);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПодбора(Элт)
	
	Если Элт.Вид() = "Сотрудники" Тогда
		ДобавитьвСписок(Элт, списСотрудников);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЭлементВСписок(НазваниеОбъекта, Один, ИмСп = "")
	
	ИмСпис = ИмСп;
	КФормы = 0;
	ОткрытьПодбор(НазваниеОбъекта, "ДляВыбора", КФормы, Один);
	КФормы.ВыборГруппы(1);
	
КонецПроцедуры

Процедура УдалитьЗначениеСписка(Спис)
	
	Если Спис.ТекущаяСтрока() <> 0 Тогда
		Спис.УдалитьЗначение(Спис.ТекущаяСтрока());
	КонецЕсли;
	
КонецПроцедуры


