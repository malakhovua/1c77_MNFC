Перем Расшифровка;
Перем Обновить;
Перем Таб;

Перем МалыйПрогресс; // + claude (текст STATIC-"бара" на форме, шрифт Webdings: 63 буквы "g" = 100%, см. СтрокаПрогресса/ОбновитьПрогресс)

Перем НомерСписка;
//Условие отборов
Перем Отбор_1;
Перем Отбор_2;

// Списки отборов
Перем СписокОтбор_1; 
Перем СписокОтбор_2;
Перем Заголовок_5;
Перем А; // + claude (ячейка макета Группировка_4|Секция_Ресурсы и Группировка_5|Секция_Ресурсы: "X" если материал неактивен на эту дату, иначе "")

Перем ЗаголовокГруппировок;

Перем тЛогОпераций; // + claude (объект Текст - накапливает строки CSV-лога текущей операции замены/установки норм)

Процедура УстановитьНовыеНормы() Далее
Процедура УстановитьЗаголовки() Далее
Процедура Сформировать() Далее
Процедура ЗаменитьМатериалВНормах(ИмяСправочника, СтарыйМатериал, НовыйМатериал, ДатаЗамены, СписокПродукции) Далее // + claude
Процедура УстановитьНормуВНормах(ИмяСправочника, Материал, НоваяНорма, ДатаЗамены, СписокПродукции) Далее // + claude
Процедура СобратьДатыЭлемента(Элемент, ИмяРеквизита, НачДата, КонДата, СписокДат) Далее // + claude
Процедура ДобавитьСтрокуНорм(Материал) Далее // + claude
Процедура УдалитьСтарыеЛоги() Далее // + claude
Процедура ОбновитьПрогресс(Готово, Всего) Далее // + claude

//***************Расшифровка************************************************

Функция РасшифровкаОбновить(Обновить)
	Расшифровка.Установить("Обновить", Обновить);
	Возврат Расшифровка;
КонецФункции

//***************Предопределенные процедуры*********************************

Процедура ПриОткрытии()

	УдалитьСтарыеЛоги(); // + claude (убираем файлы лога старше недели)

	Если Активность = 0 Тогда
		Активность = 1;
	КонецЕсли;
	
	Если ПоФорме = 0 Тогда
		ПоФорме = 1 
	КонецЕсли;
	
	Если ПустоеЗначение(ВыбДата) = 1 Тогда
		ВыбДата =ТекущаяДата();
	КонецЕсли;
	
	Если (ПустоеЗначение(НачДата) = 1) Тогда // + claude
		НачДата = НачМесяца(ТекущаяДата()); // + claude
	КонецЕсли; // + claude
	
	Если (ПустоеЗначение(КонДата) = 1) Тогда // + claude
		КонДата = ТекущаяДата(); // + claude
	КонецЕсли; // + claude

	Если глФлагРасшифровки = 1 Тогда
		Обновить = глОбновить;

		глРасшифровка.Получить("Список_1").Выгрузить(Список_1);
		глРасшифровка.Получить("Список_2").Выгрузить(Список_2);
		ВыбДата = глРасшифровка.Получить("ВыбДата");
		ПоФорме = глРасшифровка.Получить("ПоФорме");
		Активность = глРасшифровка.Получить("Активность");
		НачДата = глРасшифровка.Получить("НачДата"); // + claude
		КонДата = глРасшифровка.Получить("КонДата"); // + claude
		фВыводитьИзмененные = глРасшифровка.Получить("фВыводитьИзмененные"); // + claude

		Если Обновить <> 0 Тогда
			Таб = глТаблица;
		КонецЕсли;           
		
		Если Обновить <> 2 Тогда
			Сформировать();
			СтатусВозврата(0);
			Возврат;       
		КонецЕсли;           
	Иначе
		Обновить = 0;
	КонецЕсли;
	
	Форма.КнопкаПоУмолчанию("Сформировать");
	
КонецПроцедуры

//***************Работа со списками отбора**********************************

Процедура ДобавитьВСписок(Элт, Наим, Список)
	Если Список.Принадлежит(Элт) = 0 Тогда
		Список.ДобавитьЗначение(Элт, Наим);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПодбора(Элт, конт)
	Перем Спис;
	
	Если Элт.Вид() = "ТМЦ" Тогда
		
		Если НомерСписка=1 Тогда
			Спис = Список_1;
		ИначеЕсли НомерСписка=2 Тогда
			Спис = Список_2;
		ИначеЕсли НомерСписка=3 Тогда
			Спис = Список_3;
		ИначеЕсли НомерСписка=4 Тогда // + claude (4 - ТаблицаНовыхНорм, не СписокЗначений)
			ДобавитьСтрокуНорм(Элт); // + claude
			Возврат; // + claude
		КонецЕсли;

		ДобавитьвСписок(Элт, Строка(Элт), Спис);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЭлементВСписок(НазваниеОбъекта, МножВыбор, НомСпис)
	
	НомерСписка = НомСпис;
	КФормы = 0;
	ОткрытьПодбор(НазваниеОбъекта, "ДляВыбора", КФормы, МножВыбор);
	КФормы.ВыборГруппы(1);
	
КонецПроцедуры

Процедура УдалитьЗначениеСписка(Список)
	Если Список.ТекущаяСтрока() <> 0 Тогда
		Список.УдалитьЗначение(Список.ТекущаяСтрока());
	КонецЕсли;
КонецПроцедуры

// Добавляет строку в ТаблицаНовыхНорм для Материал (из подбора), если его там ещё нет. // + claude
Процедура ДобавитьСтрокуНорм(Материал) // + claude
	Перем Стр;

	Стр = 0;
	Если ТаблицаНовыхНорм.НайтиЗначение(Материал, Стр, "Материал") = 0 Тогда
		ТаблицаНовыхНорм.НоваяСтрока();
		ТаблицаНовыхНорм.Материал = Материал;
	КонецЕсли;
КонецПроцедуры

// Удаляет текущую выделенную строку ТаблицаНовыхНорм. // + claude
Процедура УдалитьСтрокуНорм() // + claude
	Перем ТекСтр;

	ТекСтр = ТаблицаНовыхНорм.ТекущаяСтрока();
	Если ТекСтр <> 0 Тогда
		ТаблицаНовыхНорм.УдалитьСтроку(ТекСтр);
	КонецЕсли;
КонецПроцедуры

// Удаляет все строки ТаблицаНовыхНорм, сохраняя колонки (Очистить() удалил бы и колонки - // + claude
// см. feedback_1c77_odbc_sql). // + claude
Процедура ОчиститьТаблицуНорм() // + claude
	Пока ТаблицаНовыхНорм.КоличествоСтрок() > 0 Цикл
		ТаблицаНовыхНорм.УдалитьСтроку(1);
	КонецЦикла;
КонецПроцедуры

// Двойной клик по гриду ТаблицаНовыхНорм: на колонке "НормаСписания" - ввод числа, на "Материал" -
// выбор другого ТМЦ (по образцу Обработки/ОбработкаНорм/ДвойнойЩелчокТЗЗ). // + claude
Процедура ДвойнойЩелчокТаблицыНорм() // + claude
	Перем ТекСтр;
	Перем ТекКол;
	Перем Ч;
	Перем СпрТМЦ;

	ТекСтр = ТаблицаНовыхНорм.ТекущаяСтрока();
	ТекКол = ТаблицаНовыхНорм.ТекущаяКолонка();

	Если (ТекКол = "") ИЛИ (ТекСтр = 0) Тогда
		Возврат;
	КонецЕсли;

	Если ТекКол = "НормаСписания" Тогда
		Ч = ТаблицаНовыхНорм.НормаСписания;
		Если ВвестиЧисло(Ч, "Введите новую норму списания", 15, 5) = 1 Тогда
			ТаблицаНовыхНорм.НормаСписания = Ч;
		КонецЕсли;
	ИначеЕсли ТекКол = "Материал" Тогда
		СпрТМЦ = СоздатьОбъект("Справочник.ТМЦ");
		Если СпрТМЦ.Выбрать("Выберите материал", "ДляВыбора") <> 0 Тогда
			ТаблицаНовыхНорм.УстановитьЗначение(ТекСтр, ТекКол, СпрТМЦ.ТекущийЭлемент());
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//**************Область компоновки отчета***********************************

Функция ТекстЗапроса1()
	Возврат 
	"SELECT 
	|     Подзапрос.значение_1 [значение_1 $Справочник.ТМЦ] 
	|   , Подзапрос.значение_2 [значение_2 $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ]
	|	, Подзапрос.значение_3 [значение_3 $Справочник.ВидыУпаковки]
	|	, Подзапрос.значение_4 [значение_4 $Справочник.ФормыУпаковки]
	|	, Подзапрос.значение_5 [значение_5 $Справочник.ТМЦ]
	|	, Sum(Подзапрос.значение_6) значение_6
	|	, MAX(Подзапрос.значение_7) значение_7
	|   , GROUPING(Подзапрос.значение_1) as Группа_1
	|   , GROUPING(Подзапрос.значение_2) as Группа_2
	|   , GROUPING(Подзапрос.значение_3) as Группа_3
	|   , GROUPING(Подзапрос.значение_4) as Группа_4 
	|   , GROUPING(Подзапрос.значение_5) as Группа_5
	|FROM (SELECT ТМЦ.ID значение_1
	|           ,УМК_РазрешенныеВидыУпаковкиТМЦ.ID значение_2
	|			, $УМК_РазрешенныеВидыУпаковкиТМЦ.ВидУпаковки значение_3
	|			, ФормыУпаковки.ID значение_4
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Материал(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :ВыбДата) значение_5
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.НормаСписания(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :ВыбДата) значение_6
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Неактивен(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :ВыбДата) значение_7
	|		FROM $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ AS УМК_РазрешенныеВидыУпаковкиТМЦ
	|INNER JOIN $Справочник.ТМЦ AS ТМЦ ON ТМЦ.ID = УМК_РазрешенныеВидыУпаковкиТМЦ.PARENTEXT 
	|INNER JOIN $Справочник.ФормыУпаковки AS ФормыУпаковки ON $ПоследнееЗначение.УМК_РазрешенныеВидыУпаковкиТМЦ.ФормаУпаковки(УМК_РазрешенныеВидыУпаковкиТМЦ.ID, :ВыбДата) = ФормыУпаковки.ID
	|INNER JOIN $Справочник.УМК_НормыСписанияМатериаловУпаковокФорм AS УМК_НормыСписанияМатериаловУпаковокФорм ON ФормыУпаковки.ID = УМК_НормыСписанияМатериаловУпаковокФорм.PARENTEXT
	|		WHERE 1=1 " + 
	?(Отбор_2 = 0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор_2)") + " 
	|           AND (ТМЦ.ISMARK = 0)
	|			AND (ТМЦ.ISFOLDER = 2)
	|			AND (УМК_РазрешенныеВидыУпаковкиТМЦ.ISMARK = 0)
	|			AND (УМК_НормыСписанияМатериаловУпаковокФорм.ISMARK = 0) " +
	?(Активность=2,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Неактивен(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :ВыбДата), 0) = 0)",
	?(Активность=3,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Неактивен(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :ВыбДата), 0) = 1)","")) + "
	|) AS Подзапрос
	|WHERE 1=1 " +
	?(Отбор_1 = 0,"","AND Подзапрос.значение_5 IN (SELECT Val FROM #СписокОтбор_1)") + "
	|GROUP BY 
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_4
	|	, Подзапрос.значение_5 WITH ROLLUP
	|ORDER BY
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_4
	|	, Подзапрос.значение_5 
	|";
		
КонецФункции

Функция ТекстЗапроса2()
	Возврат 
	"SELECT 
	|     Подзапрос.значение_1 [значение_1 $Справочник.ТМЦ]
	|	, Подзапрос.значение_2 [значение_2 $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ]
	|	, Подзапрос.значение_3 [значение_3 $Справочник.ВидыУпаковки]
	|	, Подзапрос.значение_5 [значение_5 $Справочник.ТМЦ]
	|	, Sum(Подзапрос.значение_6) значение_6
	|	, MAX(Подзапрос.значение_7) значение_7
	|   , GROUPING(Подзапрос.значение_1) as Группа_1
	|   , GROUPING(Подзапрос.значение_2) as Группа_2
	|   , GROUPING(Подзапрос.значение_3) as Группа_3 
	|   , GROUPING(Подзапрос.значение_5) as Группа_5
	|
	|FROM (SELECT ТМЦ.ID значение_1
	|			, УМК_РазрешенныеВидыУпаковкиТМЦ.ID значение_2
	|			, $УМК_РазрешенныеВидыУпаковкиТМЦ.ВидУпаковки значение_3
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Материал(УМК_НормыСписанияМатериаловУпаковок.ID, :ВыбДата) значение_5
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.НормаСписания(УМК_НормыСписанияМатериаловУпаковок.ID, :ВыбДата) значение_6
	|			, $ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Неактивен(УМК_НормыСписанияМатериаловУпаковок.ID, :ВыбДата) значение_7
	|		FROM $Справочник.ТМЦ AS ТМЦ
	|			INNER JOIN $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ AS УМК_РазрешенныеВидыУпаковкиТМЦ ON ТМЦ.ID = УМК_РазрешенныеВидыУпаковкиТМЦ.PARENTEXT
	|			INNER JOIN $Справочник.УМК_НормыСписанияМатериаловУпаковок AS УМК_НормыСписанияМатериаловУпаковок ON УМК_РазрешенныеВидыУпаковкиТМЦ.ID = УМК_НормыСписанияМатериаловУпаковок.PARENTEXT
	|		WHERE 1=1 " + 
	?(Отбор_2 = 0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор_2)") + "     
	|			AND (ТМЦ.ISMARK = 0)
	|			AND (ТМЦ.ISFOLDER = 2)
	|           AND (УМК_РазрешенныеВидыУпаковкиТМЦ.ISMARK = 0)
	|			AND (УМК_НормыСписанияМатериаловУпаковок.ISMARK = 0) " +
	?(Активность=2,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Неактивен(УМК_НормыСписанияМатериаловУпаковок.ID, :ВыбДата), 0) = 0)",
	?(Активность=3,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Неактивен(УМК_НормыСписанияМатериаловУпаковок.ID, :ВыбДата), 0) = 1)","")) + "
	|) AS Подзапрос
	|WHERE 1=1 " +
	?(Отбор_1 = 0,"","AND Подзапрос.значение_5 IN (SELECT Val FROM #СписокОтбор_1)") + "
	|GROUP BY 
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_5 WITH ROLLUP
	|ORDER BY
	|     Подзапрос.значение_1
	|	, Подзапрос.значение_2
	|   , Подзапрос.значение_3
	|	, Подзапрос.значение_5 
	|";
	
КонецФункции

Процедура УстановитьЗаголовки()
	
	Заголовок_1 = "Продукция";
	Заголовок_2 = "Упаковка";
	Заголовок_3 = "Форма";
	Заголовок_4 = "Материал";
	Заголовок_5 = "Количество";
	
	ЗаголовокГруппировок = ?(ПоФорме<>2, // + claude (ПоФорме=1 и 3 - с уровнем Форма)
	Заголовок_1 + "/" +
	Заголовок_2 + "/" +
	Заголовок_3 + "/" +
	Заголовок_4,
	Заголовок_1 + "/" +
	Заголовок_2 + "/" +
	Заголовок_4)
	;
	
КонецПроцедуры

Процедура Инвертировать() // + claude
	Перем сзВременный; //:СписокЗначений - временный буфер для обмена Список_2 <-> Список_3

	сзВременный = СоздатьОбъект("СписокЗначений");
	Список_2.Выгрузить(сзВременный);

	Список_2.УдалитьВсе();
	Список_3.Выгрузить(Список_2);

	Список_3.УдалитьВсе();
	сзВременный.Выгрузить(Список_3);
КонецПроцедуры //Инвертировать()

//***************Логирование операций замены/установки норм*****************
// Каждое изменение периодического реквизита (Материал/НормаСписания) в справочниках норм фиксируется в
// CSV-файл (справочник, код, название, реквизит, дата, старое значение, новое значение) - "снимок" состояния
// до изменения, чтобы при необходимости можно было вручную восстановить прежние значения. // + claude

// Возвращает путь к каталогу логов обработки (создаёт каталог, если его ещё нет):
// <КаталогИБ()>\Отчет_ПоМатериаламФормУпаковки_log\ // + claude
Функция ПолучитьКаталогЛогов() // + claude
	Перем Каталог;
	Перем оФС;

	Каталог = КаталогИБ() + "Отчет_ПоМатериаламФормУпаковки_log\";

	оФС = СоздатьОбъект("Scripting.FileSystemObject"); // + claude (нативные ФайлСуществует/СоздатьКаталог не найдены компилятором - работаем через FSO)
	Если оФС.FolderExists(Каталог) = 0 Тогда
		оФС.CreateFolder(Каталог);
	КонецЕсли;

	Возврат Каталог;
КонецФункции

// Удаляет из каталога логов отчёта файлы, старше недели - вызывается при открытии формы
// (ПриОткрытии), чтобы каталог не разрастался бесконечно. 1С7.7 не поддерживает "Для Каждого" (проверено -
// компилятор выдаёт ошибку синтаксиса), поэтому коллекцию файлов папки НЕ обходим напрямую через
// FileSystemObject.Files - вместо этого получаем перечень имён файлов через "dir /b" во временный
// текстовый файл (WScript.Shell.Run с ожиданием завершения - 3-й параметр 1) и читаем его строку
// за строкой через объект Текст (проверенный паттерн - так же читается CSV-лог в ОткатитьПоЛогу()).
// Для каждого найденного файла дата изменения читается через оФС.GetFile(Путь).DateLastModified.
// Ошибка удаления отдельного файла (например, если он открыт в другой программе - Excel через
// кнопку "Открыть файл") не прерывает цикл - пропускает этот файл и идёт дальше. // + claude
Процедура УдалитьСтарыеЛоги() // + claude
	Перем оФС;
	Перем Каталог;
	Перем ВрФайл;
	Перем оШелл;
	Перем тСписок;
	Перем Н;
	Перем ИмяФайла;
	Перем ПолныйПуть;
	Перем ГраничнаяДата;

	Каталог = ПолучитьКаталогЛогов();
	оФС = СоздатьОбъект("Scripting.FileSystemObject");
	ВрФайл = Каталог + "_список.tmp";

	оШелл = СоздатьОбъект("WScript.Shell");
	оШелл.Run("cmd /c dir /b /a-d """ + Каталог + "*.csv"" > """ + ВрФайл + """", 0, 1);

	Если оФС.FileExists(ВрФайл) = 0 Тогда
		Возврат;
	КонецЕсли;

	тСписок = СоздатьОбъект("Текст");
	тСписок.Открыть(ВрФайл); // + claude (в объекте Текст метод чтения - Открыть, не Прочитать)

	ГраничнаяДата = ТекущаяДата() - 7*24*60*60; // + claude (1С7.7: Дата - Число = Дата минус Число секунд)

	Для Н = 1 По тСписок.КоличествоСтрок() Цикл
		ИмяФайла = СокрЛП(тСписок.ПолучитьСтроку(Н));
		Если ИмяФайла = "" Тогда
			Продолжить;
		КонецЕсли;

		ПолныйПуть = Каталог + ИмяФайла;
		Если оФС.FileExists(ПолныйПуть) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если оФС.GetFile(ПолныйПуть).DateLastModified < ГраничнаяДата Тогда
			Попытка
				оФС.DeleteFile(ПолныйПуть, Истина);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Попытка
		оФС.DeleteFile(ВрФайл, Истина);
	Исключение
	КонецПопытки;
КонецПроцедуры

// Формирует строку перечня элементов СписокЗначений через "; " (для справочных строк заголовка лога). // + claude
Функция СписокЗначенийВСтроку(Список) // + claude
	Перем Рез;
	Перем Н;

	Рез = "";
	Для Н = 1 По Список.РазмерСписка() Цикл
		Если Рез <> "" Тогда
			Рез = Рез + "; ";
		КонецЕсли;
		Рез = Рез + Строка(Список.ПолучитьЗначение(Н));
	КонецЦикла;

	Возврат Рез;
КонецФункции

// Создаёт новый Текст-лог операции НазваниеОперации, записывает в него для справки параметры отчёта
// (отборы продукции/материалов, материалы для замены, ПоФорме/Активность/даты), устанавливает
// ПутьКФайлуЛога (атрибут формы) на новый уникальный файл в каталоге логов. Строки самих изменений дописывает
// ЗаписатьВЛог() по ходу выполнения операции. // + claude
Процедура НачатьЛогОперации(НазваниеОперации) // + claude
	Перем ИмяФайла; // + claude

	тЛогОпераций = СоздатьОбъект("Текст");

	ИмяФайла = Формат(ТекущаяДата(), "ДФ=ггггММдд_ччммсс") + ".csv"; // + claude (НомерСеанса() не найдена компилятором - убрана, остался только время с точностью до секунды)
	ПутьКФайлуЛога = ПолучитьКаталогЛогов() + ИмяФайла;

	тЛогОпераций.ДобавитьСтроку("# Отчет: Отчет_ПоМатериаламФормУпаковки");
	тЛогОпераций.ДобавитьСтроку("# Операция: " + НазваниеОперации);
	тЛогОпераций.ДобавитьСтроку("# Дата/время: " + Строка(ТекущаяДата()));
	тЛогОпераций.ДобавитьСтроку("# Отбор продукции (Список_1): " + СписокЗначенийВСтроку(Список_1));
	тЛогОпераций.ДобавитьСтроку("# Отбор материалов (Список_2): " + СписокЗначенийВСтроку(Список_2));
	тЛогОпераций.ДобавитьСтроку("# Материалы для замены (Список_3): " + СписокЗначенийВСтроку(Список_3));
	тЛогОпераций.ДобавитьСтроку("# ПоФорме: " + Строка(ПоФорме));
	тЛогОпераций.ДобавитьСтроку("# Активность: " + Строка(Активность));
	тЛогОпераций.ДобавитьСтроку("# ВыбДата: " + Строка(ВыбДата));
	тЛогОпераций.ДобавитьСтроку("# НачДата: " + Строка(НачДата));
	тЛогОпераций.ДобавитьСтроку("# КонДата: " + Строка(КонДата));
	тЛогОпераций.ДобавитьСтроку("# фВыводитьИзмененные: " + Строка(фВыводитьИзмененные));
	тЛогОпераций.ДобавитьСтроку("Справочник;Код;Наименование;Реквизит;ДатаИзменения;СтароеЗначение;НовоеЗначение;ДатаИзмененияВнутр;СтароеЗначениеВнутр;НовоеЗначениеВнутр;ВладелецВнутр"); // + claude (3 машинные колонки + Владелец - машинный формат ЗначениеВСтрокуВнутр для ОткатитьПоЛогу())
КонецПроцедуры

// Дописывает в тЛогОпераций одну строку изменения реквизита справочника (для возможности обратной операции).
// Кроме "человеческих" колонок (Строка()), пишет машинные колонки через ЗначениеВСтрокуВнутр() - дата,
// старое/новое значение (могут быть ссылкой на справочник (Материал), числом (НормаСписания) или
// логическим (Неактивен) - только ЗначениеВСтрокуВнутр()/ЗначениеИзСтрокиВнутр() корректно восстанавливают
// тип, в отличие от Строка()) и Владелец (Спр.Владелец - подчинённые справочники норм без него не
// находятся ни перебором без владельца, ни НайтиПоКоду - см. ОткатитьПоЛогу и
// feedback_1c77_subordinate_catalog). Используется в ОткатитьПоЛогу(). // + claude
Процедура ЗаписатьВЛог(ИмяСправочника, Спр, ИмяРеквизита, ДатаИзменения, СтароеЗначение, НовоеЗначение) // + claude
	Если ТипЗначенияСтр(тЛогОпераций) <> "Текст" Тогда
		Возврат;
	КонецЕсли;

	тЛогОпераций.ДобавитьСтроку(
		ИмяСправочника + ";" +
		Строка(Спр.Код) + ";" +
		Строка(Спр.ТекущийЭлемент()) + ";" +
		ИмяРеквизита + ";" +
		Строка(ДатаИзменения) + ";" +
		Строка(СтароеЗначение) + ";" +
		Строка(НовоеЗначение) + ";" +
		ЗначениеВСтрокуВнутр(ДатаИзменения) + ";" +
		ЗначениеВСтрокуВнутр(СтароеЗначение) + ";" +
		ЗначениеВСтрокуВнутр(НовоеЗначение) + ";" +
		ЗначениеВСтрокуВнутр(Спр.Владелец) // + claude (без скобок - это свойство, не метод)
	);
КонецПроцедуры

// Дописывает строку для только что созданного элемента (перенос - для него нет старого значения, поэтому
// машинная колонка старого значения остаётся пустой - ОткатитьПоЛогу() такие строки пропускает,
// поскольку автоматически "удалить" новосозданный элемент назад не может). Владелец - см. ЗаписатьВЛог. // + claude
Процедура ЗаписатьВЛогСоздания(ИмяСправочника, Спр, ИмяРеквизита, ДатаИзменения, НовоеЗначение) // + claude
	Если ТипЗначенияСтр(тЛогОпераций) <> "Текст" Тогда
		Возврат;
	КонецЕсли;

	тЛогОпераций.ДобавитьСтроку(
		ИмяСправочника + ";" +
		Строка(Спр.Код) + ";" +
		Строка(Спр.ТекущийЭлемент()) + ";" +
		ИмяРеквизита + ";" +
		Строка(ДатаИзменения) + ";" +
		"(новый элемент)" + ";" +
		Строка(НовоеЗначение) + ";" +
		ЗначениеВСтрокуВнутр(ДатаИзменения) + ";" +
		"" + ";" +
		ЗначениеВСтрокуВнутр(НовоеЗначение) + ";" +
		ЗначениеВСтрокуВнутр(Спр.Владелец) // + claude (без скобок - это свойство, не метод)
	);
КонецПроцедуры

// Записывает накопленный тЛогОпераций в файл ПутьКФайлуЛога и освобождает объект. // + claude
Процедура ЗавершитьЛогОперации() // + claude
	Если ТипЗначенияСтр(тЛогОпераций) <> "Текст" Тогда
		Возврат;
	КонецЕсли;

	тЛогОпераций.Записать(ПутьКФайлуЛога);
	тЛогОпераций = 0;
КонецПроцедуры

// Открывает файл лога (ПутьКФайлуЛога) в ассоциированной программе Windows (кнопка на форме). // + claude
Процедура ОткрытьФайлЛога() // + claude
	Перем оФС;

	Если ПустоеЗначение(ПутьКФайлуЛога) = 1 Тогда
		Предупреждение("Файл лога ещё не создан - сначала выполните замену или установку норм.");
		Возврат;
	КонецЕсли;

	оФС = СоздатьОбъект("Scripting.FileSystemObject"); // + claude (ФайлСуществует не найдена компилятором)
	Если оФС.FileExists(ПутьКФайлуЛога) = 0 Тогда
		Предупреждение("Файл лога не найден: " + ПутьКФайлуЛога);
		Возврат;
	КонецЕсли;

	ЗапуститьПриложение("cmd /c start """" """ + ПутьКФайлуЛога + """"); // + claude (Символ(34) не найдена компилятором - кавычки прямо в литерале строки, удвоенные)
КонецПроцедуры

// Возвращает значение поля номер НомерПоля (с 1) строки Строка, разделённой символом Разделитель. // + claude
Функция ПолеСтроки(ИсхСтрока, Разделитель, НомерПоля) // + claude
	Перем Ост;
	Перем Поз;
	Перем Н;

	Ост = ИсхСтрока;
	Для Н = 1 По НомерПоля - 1 Цикл
		Поз = Найти(Ост, Разделитель); // + claude (СтрНайти не найдена компилятором - правильное имя Найти)
		Если Поз = 0 Тогда
			Возврат "";
		КонецЕсли;
		Ост = Сред(Ост, Поз + СтрДлина(Разделитель));
	КонецЦикла;

	Поз = Найти(Ост, Разделитель); // + claude
	Если Поз = 0 Тогда
		Возврат Ост;
	Иначе
		Возврат Лев(Ост, Поз - 1);
	КонецЕсли;
КонецФункции

// Читает CSV-лог (путь берётся из текущего ПутьКФайлуЛога - можно вручную вписать путь к другому,
// более старому файлу лога) и возвращает в справочники прежние (старые) значения реквизитов - обратная
// операция к ВыполнитьЗаменуМатериалов()/УстановитьНовыеНормы()/ПеренестиМатериалыИзФормыВУпаковку().
// Строки без машинного старого значения - это записи ЗаписатьВЛогСоздания() (новосозданные при
// переносе элементы, для них нет значения, к которому вернуться) - вместо восстановления значения
// такой элемент полностью помечается на удаление (полный откат создания). Строки без колонки
// Владелец (старый формат лога) пропускаются - о чём выводится итог. Сам откат тоже пишется в новый
// лог (через те же НачатьЛогОперации()/ЗаписатьВЛог()/ЗавершитьЛогОперации()), поэтому его тоже
// можно при необходимости откатить этим же механизмом. // + claude
Процедура ОткатитьПоЛогу() // + claude
	Перем ПутьИсточника;
	Перем оФС;
	Перем тЧтения;
	Перем Н;
	Перем ТекСтрока;
	Перем ИмяСправочника;
	Перем Код;
	Перем ИмяРеквизита;
	Перем ДатаИзменения;
	Перем СтароеЗначениеВнутр;
	Перем СтароеЗначение;
	Перем ВладелецВнутр; // + claude
	Перем Владелец; // + claude
	Перем Спр;
	Перем КолВосстановлено;
	Перем КолПропущено;
	Перем КолУдалено; // + claude

	ПутьИсточника = ПутьКФайлуЛога;

	Если ПустоеЗначение(ПутьИсточника) = 1 Тогда
		Предупреждение("Не указан путь к файлу лога - откат не выполнен.");
		Возврат;
	КонецЕсли;

	оФС = СоздатьОбъект("Scripting.FileSystemObject"); // + claude (ФайлСуществует не найдена компилятором)
	Если оФС.FileExists(ПутьИсточника) = 0 Тогда
		Предупреждение("Файл лога не найден: " + ПутьИсточника);
		Возврат;
	КонецЕсли;

	// 4 = кнопки "Да"/"Нет" (Win32 MB_YESNO), 6 = нажато "Да" (IDYES) - именованные константы
	// ВыборДаНет/ВыборДа не определены компилятором в этой сборке, поэтому напрямую числовые коды. // + claude
	Если Вопрос("Откатить изменения по логу " + ПутьИсточника + "? Действие будет применено напрямую к базе и тоже записано в новый лог.", 4) <> 6 Тогда // + claude
		Возврат;
	КонецЕсли;

	тЧтения = СоздатьОбъект("Текст");
	тЧтения.Открыть(ПутьИсточника); // + claude (в объекте Текст метод чтения - Открыть, не Прочитать)

	НачатьЛогОперации("Откат по логу: " + ПутьИсточника); // + claude

	КолВосстановлено = 0;
	КолПропущено = 0;
	КолУдалено = 0; // + claude

	Для Н = 1 По тЧтения.КоличествоСтрок() Цикл
		ТекСтрока = тЧтения.ПолучитьСтроку(Н);

		Если (СокрЛП(ТекСтрока) = "") ИЛИ (Лев(ТекСтрока, 1) = "#") ИЛИ (Лев(ТекСтрока, 11) = "Справочник;") Тогда
			Продолжить;
		КонецЕсли;

		ИмяСправочника = ПолеСтроки(ТекСтрока, ";", 1);
		Код = ПолеСтроки(ТекСтрока, ";", 2);
		ИмяРеквизита = ПолеСтроки(ТекСтрока, ";", 4);
		СтароеЗначениеВнутр = ПолеСтроки(ТекСтрока, ";", 9);
		ВладелецВнутр = ПолеСтроки(ТекСтрока, ";", 11); // + claude

		Если СокрЛП(ВладелецВнутр) = "" Тогда // + claude (старый формат лога без колонки Владелец - пропускаем)
			КолПропущено = КолПропущено + 1;
			Продолжить;
		КонецЕсли;

		Владелец = ЗначениеИзСтрокиВнутр(ВладелецВнутр); // + claude

		// НайтиПоКоду без владельца не находит элементы подчинённого справочника (см.
		// feedback_1c77_subordinate_catalog) - сначала явно задаём владельца (записан в лог через
		// Спр.Владелец в ЗаписатьВЛог/ЗаписатьВЛогСоздания), как и в ПеренестиМатериалыИзФормыВУпаковку. // + claude
		Спр = СоздатьОбъект("Справочник." + ИмяСправочника);
		Спр.ИспользоватьВладельца(Владелец); // + claude
		Если Спр.НайтиПоКоду(Код) = 0 Тогда
			КолПропущено = КолПропущено + 1;
			Продолжить;
		КонецЕсли;

		Если СокрЛП(СтароеЗначениеВнутр) = "" Тогда // + claude
			// Строка "создания" (ЗаписатьВЛогСоздания) - у только что созданного элемента нет
			// старого значения, поэтому вместо восстановления значения полностью откатываем
			// создание - помечаем элемент на удаление (один элемент может логироваться 2 строками
			// - Материал+НормаСписания, поэтому проверяем, не помечен ли он уже). // + claude
			Если Спр.ПометкаУдаления() = 0 Тогда // + claude
				ЗаписатьВЛог(ИмяСправочника, Спр, "ПометкаУдаления", ВыбДата, 0, 1); // + claude
				Спр.ПометкаУдаления(1); // + claude
				Спр.Записать(); // + claude
				КолУдалено = КолУдалено + 1; // + claude
			КонецЕсли; // + claude
			Продолжить; // + claude
		КонецЕсли; // + claude

		ДатаИзменения = ЗначениеИзСтрокиВнутр(ПолеСтроки(ТекСтрока, ";", 8)); // + claude (СтрокаВЗначение не найдена компилятором - правильная пара к ЗначениеВСтрокуВнутр это ЗначениеИзСтрокиВнутр)
		СтароеЗначение = ЗначениеИзСтрокиВнутр(СтароеЗначениеВнутр); // + claude

		Если ИмяРеквизита = "Материал" Тогда
			ЗаписатьВЛог(ИмяСправочника, Спр, "Материал", ДатаИзменения, Спр.Материал.Получить(ДатаИзменения), СтароеЗначение); // + claude
			Спр.Материал.Установить(ДатаИзменения, СтароеЗначение);
		ИначеЕсли ИмяРеквизита = "НормаСписания" Тогда
			ЗаписатьВЛог(ИмяСправочника, Спр, "НормаСписания", ДатаИзменения, Спр.НормаСписания.Получить(ДатаИзменения), СтароеЗначение); // + claude
			Спр.НормаСписания.Установить(ДатаИзменения, СтароеЗначение);
		ИначеЕсли ИмяРеквизита = "Неактивен" Тогда
			ЗаписатьВЛог(ИмяСправочника, Спр, "Неактивен", ДатаИзменения, Спр.Неактивен.Получить(ДатаИзменения), СтароеЗначение); // + claude
			Спр.Неактивен.Установить(ДатаИзменения, СтароеЗначение);
		Иначе
			КолПропущено = КолПропущено + 1;
			Продолжить;
		КонецЕсли;

		Спр.Записать();
		КолВосстановлено = КолВосстановлено + 1;

	КонецЦикла;

	ЗавершитьЛогОперации(); // + claude

	Предупреждение("Откат завершён. Восстановлено: " + КолВосстановлено + ", удалено (созданные переносом элементы): " + КолУдалено + ", пропущено: " + КолПропущено + ". Лог: " + ПутьКФайлуЛога); // + claude
КонецПроцедуры

Процедура ВыполнитьЗаменуМатериалов() // + claude
	Перем НомерПары;
	Перем КолПар;
	Перем СтарыйМатериал;
	Перем НовыйМатериал;

	Если ПустоеЗначение(ВыбДата) = 1 Тогда
		Предупреждение("Не заполнена дата (ВыбДата) - замена материалов не выполнена.");
		Возврат;
	КонецЕсли;

	КолПар = Список_2.РазмерСписка();
	Если Список_3.РазмерСписка() < КолПар Тогда
		КолПар = Список_3.РазмерСписка();
	КонецЕсли;

	Если КолПар = 0 Тогда
		Предупреждение("Список материалов для замены пуст - замена не выполнена.");
		Возврат;
	КонецЕсли;

	НачатьЛогОперации("Замена материалов"); // + claude

	Для НомерПары = 1 По КолПар Цикл
		СтарыйМатериал = Список_2.ПолучитьЗначение(НомерПары);
		НовыйМатериал = Список_3.ПолучитьЗначение(НомерПары);
		Если (ПоФорме = 2) ИЛИ (ПоФорме = 3) Тогда // + claude (учитываем режим отчёта - только Упаковки)
			ЗаменитьМатериалВНормах("УМК_НормыСписанияМатериаловУпаковок", СтарыйМатериал, НовыйМатериал, ВыбДата, Список_1); // + claude
		КонецЕсли; // + claude
		Если (ПоФорме = 1) ИЛИ (ПоФорме = 3) Тогда // + claude (учитываем режим отчёта - только Формы)
			ЗаменитьМатериалВНормах("УМК_НормыСписанияМатериаловУпаковокФорм", СтарыйМатериал, НовыйМатериал, ВыбДата, Список_1); // + claude
		КонецЕсли; // + claude
		ОбновитьПрогресс(НомерПары, КолПар); // + claude
	КонецЦикла;

	ЗавершитьЛогОперации(); // + claude

	Предупреждение("Замена материалов выполнена. Лог: " + ПутьКФайлуЛога); // + claude
КонецПроцедуры //ВыполнитьЗаменуМатериалов()

// Текст запроса для поиска ID записей УМК_НормыСписанияМатериаловУпаковок, чей текущий Материал на
// дату :Дата равен :СтарыйМатериал - для замены материала. С учётом отбора продукции
// (Список_1 отчёта) через #СписокОтбор1, если он задан (ЕстьОтборПродукции=1). // + claude
Функция ТекстЗапросаЗаменыУпаковок(ЕстьОтборПродукции) // + claude
	Возврат
	"SELECT УМК_НормыСписанияМатериаловУпаковок.ID [Ссылка $Справочник.УМК_НормыСписанияМатериаловУпаковок]
	|FROM $Справочник.ТМЦ AS ТМЦ
	|	INNER JOIN $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ AS УМК_РазрешенныеВидыУпаковкиТМЦ ON ТМЦ.ID = УМК_РазрешенныеВидыУпаковкиТМЦ.PARENTEXT
	|	INNER JOIN $Справочник.УМК_НормыСписанияМатериаловУпаковок AS УМК_НормыСписанияМатериаловУпаковок ON УМК_РазрешенныеВидыУпаковкиТМЦ.ID = УМК_НормыСписанияМатериаловУпаковок.PARENTEXT
	|WHERE ($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Материал(УМК_НормыСписанияМатериаловУпаковок.ID, :Дата) = :СтарыйМатериал)
	|	AND (ТМЦ.ISMARK = 0)
	|	AND (ТМЦ.ISFOLDER = 2)
	|	AND (УМК_РазрешенныеВидыУпаковкиТМЦ.ISMARK = 0)
	|	AND (УМК_НормыСписанияМатериаловУпаковок.ISMARK = 0)
	|" + ?(ЕстьОтборПродукции = 1, "AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор1)", "") + // + claude (учитываем фильтр Активность отчёта)
	?(Активность=2,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Неактивен(УМК_НормыСписанияМатериаловУпаковок.ID, :Дата), 0) = 0)", // + claude
	?(Активность=3,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковок.Неактивен(УМК_НормыСписанияМатериаловУпаковок.ID, :Дата), 0) = 1)","")); // + claude
КонецФункции

// Аналогично, для УМК_НормыСписанияМатериаловУпаковокФорм (с дополнительным JOIN на ФормыУпаковки). // + claude
Функция ТекстЗапросаЗаменыФорм(ЕстьОтборПродукции) // + claude
	Возврат
	"SELECT УМК_НормыСписанияМатериаловУпаковокФорм.ID [Ссылка $Справочник.УМК_НормыСписанияМатериаловУпаковокФорм]
	|FROM $Справочник.ТМЦ AS ТМЦ
	|	INNER JOIN $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ AS УМК_РазрешенныеВидыУпаковкиТМЦ ON ТМЦ.ID = УМК_РазрешенныеВидыУпаковкиТМЦ.PARENTEXT
	|	INNER JOIN $Справочник.ФормыУпаковки AS ФормыУпаковки ON $ПоследнееЗначение.УМК_РазрешенныеВидыУпаковкиТМЦ.ФормаУпаковки(УМК_РазрешенныеВидыУпаковкиТМЦ.ID, :Дата) = ФормыУпаковки.ID
	|	INNER JOIN $Справочник.УМК_НормыСписанияМатериаловУпаковокФорм AS УМК_НормыСписанияМатериаловУпаковокФорм ON ФормыУпаковки.ID = УМК_НормыСписанияМатериаловУпаковокФорм.PARENTEXT
	|WHERE ($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Материал(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :Дата) = :СтарыйМатериал)
	|	AND (ТМЦ.ISMARK = 0)
	|	AND (ТМЦ.ISFOLDER = 2)
	|	AND (УМК_РазрешенныеВидыУпаковкиТМЦ.ISMARK = 0)
	|	AND (УМК_НормыСписанияМатериаловУпаковокФорм.ISMARK = 0)
	|" + ?(ЕстьОтборПродукции = 1, "AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор1)", "") + // + claude (учитываем фильтр Активность отчёта)
	?(Активность=2,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Неактивен(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :Дата), 0) = 0)", // + claude
	?(Активность=3,"AND (ISNULL($ПоследнееЗначение.УМК_НормыСписанияМатериаловУпаковокФорм.Неактивен(УМК_НормыСписанияМатериаловУпаковокФорм.ID, :Дата), 0) = 1)","")); // + claude
КонецФункции

// Выполняет поиск+запись замены материала СтарыйМатериал -> НовыйМатериал на дату Дата в справочнике
// ИмяСправочника ("УМК_НормыСписанияМатериаловУпаковок" или "...Форм"), с учётом отбора
// продукции СписокПродукции (Список_1 отчёта), если он не пуст. фВыводитьИзмененные ("только
// изменённые") сознательно НЕ учитывается здесь - при замене материала важен только отбор по
// материалам (сам вызов - на конкретный СтарыйМатериал из Список_2) и продукции. // + claude
Процедура ЗаменитьМатериалВНормах(ИмяСправочника, СтарыйМатериал, НовыйМатериал, ДатаЗамены, СписокПродукции) // + claude
	Перем рс;
	Перем ТекстЗапроса;
	Перем Результат; //:ТаблицаЗначений
	Перем ЕстьОтборПродукции;
	Перем Спр;

	ЕстьОтборПродукции = ?(СписокПродукции.РазмерСписка() > 0, 1, 0);

	рс = СоздатьОбъект("ODBCRecordset");
	ТекстЗапроса = ?(ИмяСправочника = "УМК_НормыСписанияМатериаловУпаковокФорм",
		ТекстЗапросаЗаменыФорм(ЕстьОтборПродукции),
		ТекстЗапросаЗаменыУпаковок(ЕстьОтборПродукции));

	рс.УстановитьТекстовыйПараметр("СтарыйМатериал", СтарыйМатериал);
	рс.УстановитьТекстовыйПараметр("Дата", ДатаЗамены);
	Если ЕстьОтборПродукции = 1 Тогда
		рс.УложитьСписокОбъектов(СписокПродукции, "#СписокОтбор1", "ТМЦ");
	КонецЕсли;

	Результат = рс.ВыполнитьИнструкцию(ТекстЗапроса);
	Результат.ВыбратьСтроки();

	Спр = СоздатьОбъект("Справочник." + ИмяСправочника);

	Пока Результат.ПолучитьСтроку() = 1 Цикл
		Если Спр.НайтиЭлемент(Результат.Ссылка) = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьВЛог(ИмяСправочника, Спр, "Материал", ДатаЗамены, СтарыйМатериал, НовыйМатериал); // + claude
		Спр.Материал.Установить(ДатаЗамены, НовыйМатериал);
		Спр.Записать();
	КонецЦикла;
КонецПроцедуры

// Находит записи ИмяСправочника, чей текущий Материал на дату ДатаЗамены равен Материал (с
// учётом отбора продукции СписокПродукции), и устанавливает НормаСписания = НоваяНорма на эту дату -
// те же запросы, что и ЗаменитьМатериалВНормах (ищем по Материал), только пишем другой реквизит.
// фВыводитьИзмененные ("только изменённые") сознательно НЕ учитывается - важен только отбор по
// материалам и продукции (как и в ЗаменитьМатериалВНормах). // + claude
Процедура УстановитьНормуВНормах(ИмяСправочника, Материал, НоваяНорма, ДатаЗамены, СписокПродукции) // + claude
	Перем рс;
	Перем ТекстЗапроса;
	Перем Результат; //:ТаблицаЗначений
	Перем ЕстьОтборПродукции;
	Перем Спр;
	Перем СтараяНорма; // + claude (текущее значение НормаСписания перед перезаписью - для лога)

	ЕстьОтборПродукции = ?(СписокПродукции.РазмерСписка() > 0, 1, 0);

	рс = СоздатьОбъект("ODBCRecordset");
	ТекстЗапроса = ?(ИмяСправочника = "УМК_НормыСписанияМатериаловУпаковокФорм",
		ТекстЗапросаЗаменыФорм(ЕстьОтборПродукции),
		ТекстЗапросаЗаменыУпаковок(ЕстьОтборПродукции));

	рс.УстановитьТекстовыйПараметр("СтарыйМатериал", Материал);
	рс.УстановитьТекстовыйПараметр("Дата", ДатаЗамены);
	Если ЕстьОтборПродукции = 1 Тогда
		рс.УложитьСписокОбъектов(СписокПродукции, "#СписокОтбор1", "ТМЦ");
	КонецЕсли;

	Результат = рс.ВыполнитьИнструкцию(ТекстЗапроса);
	Результат.ВыбратьСтроки();

	Спр = СоздатьОбъект("Справочник." + ИмяСправочника);

	Пока Результат.ПолучитьСтроку() = 1 Цикл
		Если Спр.НайтиЭлемент(Результат.Ссылка) = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтараяНорма = Спр.НормаСписания.Получить(ДатаЗамены); // + claude
		ЗаписатьВЛог(ИмяСправочника, Спр, "НормаСписания", ДатаЗамены, СтараяНорма, НоваяНорма); // + claude
		Спр.НормаСписания.Установить(ДатаЗамены, НоваяНорма);
		Спр.Записать();
	КонецЦикла;
КонецПроцедуры

// Собирает в СписокДат даты изменения периодического реквизита ИмяРеквизита элемента Элемент в границах НачДата..КонДата // + claude
Процедура СобратьДатыЭлемента(Элемент, ИмяРеквизита, НачДата, КонДата, СписокДат) // + claude
	Перем Пер;

	Пер = СоздатьОбъект("Периодический");
	Пер.ИспользоватьОбъект(ИмяРеквизита, Элемент);
	Пер.ВыбратьЗначения(НачДата, КонДата);

	Пока Пер.ПолучитьЗначение() = 1 Цикл
		Если (СписокДат.Принадлежит(Пер.ДатаЗнач) = 0) Тогда
			СписокДат.ДобавитьЗначение(Пер.ДатаЗнач);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает отсортированный СписокЗначений уникальных дат изменения реквизитов Материал/НормаСписания
// по справочнику(ам), соответствующим текущему режиму ПоФорме, в границах НачДата..КонДата // + claude
Функция ПолучитьДатыИзменений(НачДата, КонДата, ПоФорме) // + claude
	Перем СписокДат; //:СписокЗначений
	Перем Спр;
	Перем ЭлементСсылка;

	СписокДат = СоздатьОбъект("СписокЗначений");

	Если (ПоФорме = 1) ИЛИ (ПоФорме = 3) Тогда // + claude (ПоФорме=3 - и формы, и упаковки вместе)
		Спр = СоздатьОбъект("Справочник.УМК_НормыСписанияМатериаловУпаковокФорм");
		Спр.ВыбратьЭлементы(0);
		Пока Спр.ПолучитьЭлемент() = 1 Цикл
			Если (Спр.ПометкаУдаления() = 0) Тогда
				ЭлементСсылка = Спр.ТекущийЭлемент();
				СобратьДатыЭлемента(ЭлементСсылка, "Материал", НачДата, КонДата, СписокДат);
				СобратьДатыЭлемента(ЭлементСсылка, "НормаСписания", НачДата, КонДата, СписокДат);
				СобратьДатыЭлемента(ЭлементСсылка, "Неактивен", НачДата, КонДата, СписокДат); // + claude
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если (ПоФорме = 2) ИЛИ (ПоФорме = 3) Тогда // + claude
		Спр = СоздатьОбъект("Справочник.УМК_НормыСписанияМатериаловУпаковок");
		Спр.ВыбратьЭлементы(0);
		Пока Спр.ПолучитьЭлемент() = 1 Цикл
			Если (Спр.ПометкаУдаления() = 0) Тогда
				ЭлементСсылка = Спр.ТекущийЭлемент();
				СобратьДатыЭлемента(ЭлементСсылка, "Материал", НачДата, КонДата, СписокДат);
				СобратьДатыЭлемента(ЭлементСсылка, "НормаСписания", НачДата, КонДата, СписокДат);
				СобратьДатыЭлемента(ЭлементСсылка, "Неактивен", НачДата, КонДата, СписокДат); // + claude
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СписокДат.Сортировать(0); // + claude (0 = по возрастанию; было 1 = по убыванию - даты шли в обратном порядке)

	Возврат СписокДат;
КонецФункции

// Заполняет буфер тзЗнач (по одному значению на каждую дату из ДатыИзменений) для одного значения
// Ключ уровня группировки, используя индексированный поиск по тзИндекс/ИмяИндекса. Если Суммировать=1 -
// значения по строкам с одинаковой датой суммируются (для уровней Продукция/Упаковка/Форма, где
// несколько детальных строк могут относиться к одному и тому же ключу); если 0 - просто
// записывается (уровень Материал, где на каждую дату только одна детальная строка). // + claude
Процедура ЗаполнитьБуферЗначений(тзИндекс, ИмяИндекса, Ключ, ДатыИзменений, КолДат, тзЗнач, Суммировать) // + claude
	Перем НомерДаты;
	Перем Текущее;
	Перем сзПоиска;

	Для НомерДаты = 1 По КолДат Цикл
		тзЗнач.УстановитьЗначение(НомерДаты, "Значение", 0);
		тзЗнач.УстановитьЗначение(НомерДаты, "Неактив", 0); // + claude
	КонецЦикла;

	сзПоиска = СоздатьОбъект("СписокЗначений");
	сзПоиска.ДобавитьЗначение(Ключ);
	тзИндекс.Подмножество(сзПоиска, 1, ИмяИндекса);
	тзИндекс.ВыбратьСтроки(ИмяИндекса);
	Пока тзИндекс.ПолучитьСтроку(ИмяИндекса) = 1 Цикл
		Для НомерДаты = 1 По КолДат Цикл
			Если тзИндекс.Период = ДатыИзменений.ПолучитьЗначение(НомерДаты) Тогда
				Если Суммировать = 1 Тогда
					Текущее = тзЗнач.ПолучитьЗначение(НомерДаты, "Значение");
					тзЗнач.УстановитьЗначение(НомерДаты, "Значение", Текущее + тзИндекс.значение_6);
				Иначе
					тзЗнач.УстановитьЗначение(НомерДаты, "Значение", тзИндекс.значение_6);
					тзЗнач.УстановитьЗначение(НомерДаты, "Неактив", тзИндекс.значение_7); // + claude (только на детальном уровне - один материал)
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Выводит одну строку crosstab-секции ИмяСекции ("Группировка_N|Секция_Ресурсы"): по очереди на каждую
// дату записывает тз.значение_6 из буфера тзЗнач и присоединяет колонку. тз - строка-якорь (её значение_1..5
// уже правильно выставлены вызывающим кодом), позиция тз НЕ меняется. // + claude
Процедура ВывестиСтрокуРесурсов(Таб, ИмяСекции, тз, тзЗнач, ДатыИзменений, КолДат) // + claude
	Перем НомерДаты;
	Перем Значение;
	Перем Неактив;

	Для НомерДаты = 1 По КолДат Цикл
		Значение = тзЗнач.ПолучитьЗначение(НомерДаты, "Значение");
		Если (ПустоеЗначение(Значение) = 1) Тогда
			Значение = 0;
		КонецЕсли;
		тз.значение_6 = Значение;
		Неактив = тзЗнач.ПолучитьЗначение(НомерДаты, "Неактив"); // + claude
		А = ?((ПустоеЗначение(Неактив) = 0) И (Неактив = 1), "X", ""); // + claude (макет ТабОтчета.mxl: ячейка Группировка_4|Секция_Ресурсы привязана к "А")
		Таб.ПрисоединитьСекцию(ИмяСекции);
	КонецЦикла;
КонецПроцедуры

// Выводит пустую строку crosstab-секции ИмяСекции (без вычисления суммы) - для уровней
// Продукция/Упаковка/Форма, где итоги убраны, но ячейки по датам всё равно нужно присоединить,
// иначе вместо них - неокрашенный пробел без рамок сетки макета. // + claude
Процедура ВывестиПустыеРесурсы(Таб, ИмяСекции, тз, КолДат) // + claude
	Перем НомерДаты;

	Для НомерДаты = 1 По КолДат Цикл
		тз.значение_6 = "";
		Таб.ПрисоединитьСекцию(ИмяСекции);
	КонецЦикла;
КонецПроцедуры

// Выполняет один SQL-запрос (ЦеФормаЗапиту=1 -> ТекстЗапроса1, по формам; 0 -> ТекстЗапроса2, по упаковкам)
// на дату ДатаИзменения, берёт только детальные (нераздробленные ROLLUP) строки и добавляет их в тз с вычисленными
// Ключ1..Ключ4 (префиксные ключи уровней Продукция/Упаковка/Форма/Материал) и отметкой ЭтоФорма -
// нужно отдельно от глобального ПоФорме, так как при ПоФорме=3 оба запроса выполняются вместе. // + claude
Процедура СобратьДетальныеСтроки(ЦеФормаЗапиту, ДатаИзменения, тз) // + claude
	Перем тзДата; //:ТаблицаЗначений - результат одноданого запиту
	Перем ГруппаСумма;
	Перем Ключ1;
	Перем Ключ2;
	Перем Ключ3;
	Перем Ключ4;

	рс = СоздатьОбъект("ODBCRecordset");
	ТекстЗапроса = ?(ЦеФормаЗапиту = 1, ТекстЗапроса1(), ТекстЗапроса2());

	рс.УстановитьТекстовыйПараметр("ВыбДата", ДатаИзменения);
	рс.УложитьСписокОбъектов(СписокОтбор_1, "#СписокОтбор_1", "ТМЦ");
	рс.УложитьСписокОбъектов(СписокОтбор_2, "#СписокОтбор_2", "ТМЦ");

	тзДата = рс.ВыполнитьИнструкцию(ТекстЗапроса);
	тзДата.ВыбратьСтроки();

	Пока тзДата.ПолучитьСтроку() = 1 Цикл

		Если ЦеФормаЗапиту = 1 Тогда
			ГруппаСумма = тзДата.Группа_1 + тзДата.Группа_2 + тзДата.Группа_3 + тзДата.Группа_4 + тзДата.Группа_5;
		Иначе
			ГруппаСумма = тзДата.Группа_1 + тзДата.Группа_2 + тзДата.Группа_3 + тзДата.Группа_5;
		КонецЕсли;

		// Интересует только детальная (нераздробленная ROLLUP) строка - итоги высших уровней считаем сами // + claude
		Если (ГруппаСумма <> 0) Тогда
			Продолжить;
		КонецЕсли;

		Ключ1 = ЗначениеВСтрокуВнутр(тзДата.значение_1);
		Ключ2 = Ключ1 + "|" + ЗначениеВСтрокуВнутр(тзДата.значение_2) + "|" + ЗначениеВСтрокуВнутр(тзДата.значение_3);
		Если ЦеФормаЗапиту = 1 Тогда
			Ключ3 = Ключ2 + "|" + ЗначениеВСтрокуВнутр(тзДата.значение_4);
			Ключ4 = Ключ3 + "|" + ЗначениеВСтрокуВнутр(тзДата.значение_5);
		Иначе
			Ключ3 = Ключ2;
			Ключ4 = Ключ2 + "||" + ЗначениеВСтрокуВнутр(тзДата.значение_5);
		КонецЕсли;

		тз.НоваяСтрока();
		тз.значение_1 = тзДата.значение_1;
		тз.значение_2 = тзДата.значение_2;
		тз.значение_3 = тзДата.значение_3;
		Если ЦеФормаЗапиту = 1 Тогда
			тз.значение_4 = тзДата.значение_4;
		КонецЕсли;
		тз.значение_5 = тзДата.значение_5;
		тз.значение_6 = тзДата.значение_6;
		тз.значение_7 = тзДата.значение_7; // + claude (Неактивен на эту дату)
		тз.Ключ1 = Ключ1;
		тз.Ключ2 = Ключ2;
		тз.Ключ3 = Ключ3;
		тз.Ключ4 = Ключ4;
		тз.Период = ДатаИзменения;
		тз.ЭтоФорма = ЦеФормаЗапиту;

	КонецЦикла;

КонецПроцедуры

// Заполняет тзСостояние (по одной строке на каждую дату из ДатыИзменений; колонки Есть/Норма/Неактивен) состоянием
// материала (строки тз с Ключ4 = Ключ) - через индекс П4 тзИндекс. Пустые значения нормы/неактивен
// нормализуются к 0. Период строки сопоставляется с датой по значению (как в ЗаполнитьБуферЗначений). // + claude
Процедура ЗаполнитьСостояниеМатериала(тзИндекс, Ключ, ДатыИзменений, КолДат, тзСостояние) // + claude
	Перем НомерДаты;
	Перем сзПоиск;
	Перем Норма;
	Перем Неактивен;

	Для НомерДаты = 1 По КолДат Цикл
		тзСостояние.УстановитьЗначение(НомерДаты, "Есть", 0);
		тзСостояние.УстановитьЗначение(НомерДаты, "Норма", 0);
		тзСостояние.УстановитьЗначение(НомерДаты, "Неактивен", 0);
	КонецЦикла;

	сзПоиск = СоздатьОбъект("СписокЗначений");
	сзПоиск.ДобавитьЗначение(Ключ);
	тзИндекс.Подмножество(сзПоиск, 1, "П4");
	тзИндекс.ВыбратьСтроки("П4");
	Пока тзИндекс.ПолучитьСтроку("П4") = 1 Цикл
		Норма = тзИндекс.значение_6;
		Если (ПустоеЗначение(Норма) = 1) Тогда
			Норма = 0;
		КонецЕсли;
		Неактивен = тзИндекс.значение_7;
		Если (ПустоеЗначение(Неактивен) = 1) Тогда
			Неактивен = 0;
		КонецЕсли;
		Для НомерДаты = 1 По КолДат Цикл
			Если тзИндекс.Период = ДатыИзменений.ПолучитьЗначение(НомерДаты) Тогда
				тзСостояние.УстановитьЗначение(НомерДаты, "Есть", 1);
				тзСостояние.УстановитьЗначение(НомерДаты, "Норма", Норма);
				тзСостояние.УстановитьЗначение(НомерДаты, "Неактивен", Неактивен);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Возвращает копию тз (отсортированной по Ключ4) только с теми материалами, что реально изменились в границах дат
// ДатыИзменений (для фВыводитьИзмененные=1): НормаСписания/Неактивен отличается между датами, ЛИБО материал
// появился не на первой дате (норму/материал внесли в периоде), ЛИБО пропал до последней даты (заменён).
// Материалы, у которых на всех датах пусты и норма, и Неактивен (напр. строка без материала), не считаются. // + claude
Функция ОтфильтроватьТолькоИзмененные(тз, ДатыИзменений) // + claude
	Перем СписокИзмененных; //:СписокЗначений - Ключ4 материалов, изменившихся в периоде
	Перем тзРезультат; //:ТаблицаЗначений - копия тз только с изменённых материалов
	Перем тзИндекс;
	Перем тзСостояние;
	Перем КолДат;
	Перем НомерДаты;
	Перем ПредыдущийКлюч;
	Перем ПерваяДата;
	Перем ПоследняяДата;
	Перем ЕстьНепустое;
	Перем Изменился;
	Перем ПредНорма;
	Перем ПредНеактивен;
	Перем Норма;
	Перем Неактивен;

	КолДат = ДатыИзменений.РазмерСписка();
	Если КолДат <= 1 Тогда // + claude (одна дата в выборке - "изменение" определить нечем сравнивать)
		Возврат тз;
	КонецЕсли; // + claude

	тзРезультат = СоздатьОбъект("ТаблицаЗначений");
	тзРезультат.НоваяКолонка("значение_1");
	тзРезультат.НоваяКолонка("значение_2");
	тзРезультат.НоваяКолонка("значение_3");
	тзРезультат.НоваяКолонка("значение_4");
	тзРезультат.НоваяКолонка("значение_5");
	тзРезультат.НоваяКолонка("значение_6");
	тзРезультат.НоваяКолонка("значение_7");
	тзРезультат.НоваяКолонка("Ключ1");
	тзРезультат.НоваяКолонка("Ключ2");
	тзРезультат.НоваяКолонка("Ключ3");
	тзРезультат.НоваяКолонка("Ключ4");
	тзРезультат.НоваяКолонка("Период");
	тзРезультат.НоваяКолонка("ЭтоФорма");

	тзИндекс = СоздатьОбъект("ИндексированнаяТаблица");
	тзИндекс.Загрузить(тз);
	тзИндекс.ДобавитьИндекс("П4", "Ключ4");

	тзСостояние = СоздатьОбъект("ТаблицаЗначений");
	тзСостояние.НоваяКолонка("Есть");
	тзСостояние.НоваяКолонка("Норма");
	тзСостояние.НоваяКолонка("Неактивен");
	Для НомерДаты = 1 По КолДат Цикл
		тзСостояние.НоваяСтрока();
	КонецЦикла;

	СписокИзмененных = СоздатьОбъект("СписокЗначений");
	ПредыдущийКлюч = "";

	тз.ВыбратьСтроки();
	Пока тз.ПолучитьСтроку() = 1 Цикл
		Если тз.Ключ4 <> ПредыдущийКлюч Тогда
			ПредыдущийКлюч = тз.Ключ4;
			ЗаполнитьСостояниеМатериала(тзИндекс, ПредыдущийКлюч, ДатыИзменений, КолДат, тзСостояние);

			ПерваяДата = 0;
			ПоследняяДата = 0;
			ЕстьНепустое = 0;
			Изменился = 0;
			ПредНорма = 0;
			ПредНеактивен = 0;
			Для НомерДаты = 1 По КолДат Цикл
				Если тзСостояние.ПолучитьЗначение(НомерДаты, "Есть") = 1 Тогда
					Норма = тзСостояние.ПолучитьЗначение(НомерДаты, "Норма");
					Неактивен = тзСостояние.ПолучитьЗначение(НомерДаты, "Неактивен");
					Если (Норма <> 0) ИЛИ (Неактивен <> 0) Тогда
						ЕстьНепустое = 1;
					КонецЕсли;
					Если ПерваяДата = 0 Тогда
						ПерваяДата = НомерДаты;
					ИначеЕсли (Норма <> ПредНорма) ИЛИ (Неактивен <> ПредНеактивен) Тогда
						Изменился = 1;
					КонецЕсли;
					ПоследняяДата = НомерДаты;
					ПредНорма = Норма;
					ПредНеактивен = Неактивен;
				КонецЕсли;
			КонецЦикла;

			Если ЕстьНепустое = 1 Тогда
				Если (ПерваяДата > 1) ИЛИ (ПоследняяДата < КолДат) Тогда
					Изменился = 1;
				КонецЕсли;
				Если Изменился = 1 Тогда
					СписокИзмененных.ДобавитьЗначение(ПредыдущийКлюч);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	тз.ВыбратьСтроки();
	Пока тз.ПолучитьСтроку() = 1 Цикл
		Если СписокИзмененных.Принадлежит(тз.Ключ4) = 1 Тогда
			тзРезультат.НоваяСтрока();
			тзРезультат.значение_1 = тз.значение_1;
			тзРезультат.значение_2 = тз.значение_2;
			тзРезультат.значение_3 = тз.значение_3;
			тзРезультат.значение_4 = тз.значение_4;
			тзРезультат.значение_5 = тз.значение_5;
			тзРезультат.значение_6 = тз.значение_6;
			тзРезультат.значение_7 = тз.значение_7;
			тзРезультат.Ключ1 = тз.Ключ1;
			тзРезультат.Ключ2 = тз.Ключ2;
			тзРезультат.Ключ3 = тз.Ключ3;
			тзРезультат.Ключ4 = тз.Ключ4;
			тзРезультат.Период = тз.Период;
			тзРезультат.ЭтоФорма = тз.ЭтоФорма;
		КонецЕсли;
	КонецЦикла;

	Возврат тзРезультат;
КонецФункции

// Выводит колонки-заголовки "Количество на дату ..." (по одной на каждую дату из ДатыИзменений) - присоединяются
// к последней выведенной секции "Шапка|Секция_Группировки", поэтому вызывается до любого другого вывода. // + claude
Процедура ВывестиЗаголовкиДат(Таб, ДатыИзменений) // + claude
	Перем НомерДаты;

	Для НомерДаты = 1 По ДатыИзменений.РазмерСписка() Цикл
		Заголовок_5 = "Количество на дату " + Строка(ДатыИзменений.ПолучитьЗначение(НомерДаты));
		Таб.ПрисоединитьСекцию("Шапка|Секция_Ресурсы");
	КонецЦикла;
КонецПроцедуры

// Оставляет в ДатыИзменений (список меняется на месте) только даты, на которых для строк тз (уже с учётом
// отборов продукции/материалов и Активность) что-то реально изменилось: материал впервые появился с непустой
// нормой/признаком "Неактивен", либо НормаСписания/Неактивен отличается от предыдущей даты этого же материала.
// Даты, попавшие в ДатыИзменений только из-за изменений других (отфильтрованных) позиций, дают пустые или
// повторные колонки - они убираются. Если значимых дат нет - остаётся последняя дата. // + claude
Процедура ОставитьЗначимыеДаты(тз, ДатыИзменений) // + claude
	Перем КолДат;
	Перем НомерДаты;
	Перем тзИндекс;
	Перем тзСостояние;
	Перем НовыеДаты;
	Перем ПредыдущийКлюч;
	Перем ЕстьПредыдущее;
	Перем ПредНорма;
	Перем ПредНеактивен;
	Перем Норма;
	Перем Неактивен;

	КолДат = ДатыИзменений.РазмерСписка();
	Если КолДат <= 1 Тогда
		Возврат;
	КонецЕсли;

	тзИндекс = СоздатьОбъект("ИндексированнаяТаблица");
	тзИндекс.Загрузить(тз);
	тзИндекс.ДобавитьИндекс("П4", "Ключ4");

	тзСостояние = СоздатьОбъект("ТаблицаЗначений");
	тзСостояние.НоваяКолонка("Есть");
	тзСостояние.НоваяКолонка("Норма");
	тзСостояние.НоваяКолонка("Неактивен");
	тзСостояние.НоваяКолонка("Значима");
	Для НомерДаты = 1 По КолДат Цикл
		тзСостояние.НоваяСтрока();
		тзСостояние.УстановитьЗначение(НомерДаты, "Значима", 0);
	КонецЦикла;

	ПредыдущийКлюч = "";
	тз.ВыбратьСтроки();
	Пока тз.ПолучитьСтроку() = 1 Цикл
		Если тз.Ключ4 <> ПредыдущийКлюч Тогда
			ПредыдущийКлюч = тз.Ключ4;

			ЗаполнитьСостояниеМатериала(тзИндекс, ПредыдущийКлюч, ДатыИзменений, КолДат, тзСостояние); // + claude

			// Даты, на которых состояние материала изменилось относительно предыдущей даты
			ЕстьПредыдущее = 0;
			ПредНорма = 0;
			ПредНеактивен = 0;
			Для НомерДаты = 1 По КолДат Цикл
				Если тзСостояние.ПолучитьЗначение(НомерДаты, "Есть") = 1 Тогда
					Норма = тзСостояние.ПолучитьЗначение(НомерДаты, "Норма");
					Неактивен = тзСостояние.ПолучитьЗначение(НомерДаты, "Неактивен");
					Если (ЕстьПредыдущее = 0) Тогда
						Если (Норма <> 0) ИЛИ (Неактивен <> 0) Тогда
							тзСостояние.УстановитьЗначение(НомерДаты, "Значима", 1);
						КонецЕсли;
					ИначеЕсли (Норма <> ПредНорма) ИЛИ (Неактивен <> ПредНеактивен) Тогда
						тзСостояние.УстановитьЗначение(НомерДаты, "Значима", 1);
					КонецЕсли;
					ЕстьПредыдущее = 1;
					ПредНорма = Норма;
					ПредНеактивен = Неактивен;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	НовыеДаты = СоздатьОбъект("СписокЗначений");
	Для НомерДаты = 1 По КолДат Цикл
		Если тзСостояние.ПолучитьЗначение(НомерДаты, "Значима") = 1 Тогда
			НовыеДаты.ДобавитьЗначение(ДатыИзменений.ПолучитьЗначение(НомерДаты));
		КонецЕсли;
	КонецЦикла;
	Если НовыеДаты.РазмерСписка() = 0 Тогда
		НовыеДаты.ДобавитьЗначение(ДатыИзменений.ПолучитьЗначение(КолДат));
	КонецЕсли;

	ДатыИзменений.УдалитьВсе();
	Для НомерДаты = 1 По НовыеДаты.РазмерСписка() Цикл
		ДатыИзменений.ДобавитьЗначение(НовыеДаты.ПолучитьЗначение(НомерДаты));
	КонецЦикла;
КонецПроцедуры

// Выводит прогресс "Готово из Всего" через Состояние() - тот же паттерн, что использует
// Обработки/ПровестиДокументыПоПартиям/МодульФормы.1s (Состояние(ТекстПрогресса) внутри цикла
// проведения документов; Состояние() заодно перекачивает сообщения Windows, поэтому форма не
// "замирает" на время долгого цикла). Визуальную полосу МалыйПрогресс (63 "g" = 100%) пока не
// заполняем - убрано по просьбе пользователя. Вызывается и из отчёта (ПолучитьДанныеЗаПериод -
// общая функция для Сформировать и обработок замены/установки норм), и напрямую из длинных циклов
// обработок. // + claude
Процедура ОбновитьПрогресс(Готово, Всего) // + claude
	Состояние(Строка(Готово) + " из " + Строка(Всего));
КонецПроцедуры

// Готовит СписокОтбор_1/СписокОтбор_2 (ID-списки для SQL-параметров #СписокОтбор_1/#СписокОтбор_2) и
// Отбор_1/Отбор_2 (признаки "отбор задан") из форменных списков Список_2 (материалы) и Список_1
// (продукция) - используется в Сформировать().
// Фикс: в блоке подготовки СписокОтбор_1 (материалы) условие пустоты проверяло Список_1
// (продукция) вместо Список_2 (материалы) - из-за этого, если продукция не выбрана, отбор по
// материалам полностью игнорировался (возвращались ВСЕ ТМЦ). // + claude
Процедура ПодготовитьСпискиОтбора() // + claude
	СписокОтбор_1 = СоздатьОбъект("СписокЗначений");
	СписокОтбор_2  = СоздатьОбъект("СписокЗначений");

	Отбор_1 = Список_2.РазмерСписка();
	Отбор_2  = Список_1.РазмерСписка();

	//Подготовим список материалов по условиям отбора
	Если Отбор_1 > 0 Тогда
		//Результат выборки материалов с учетом отбора
		рс = СоздатьОбъект("ODBCRecordset");
		ТекстЗапроса =
		"SELECT ТМЦ.ID [Ссылка $Справочник.ТМЦ]
		|FROM $Справочник.ТМЦ AS ТМЦ
		|WHERE ТМЦ.IsFolder = 2" +
		?(Список_2.РазмерСписка() =0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор)") + "
		|ORDER BY ТМЦ.ID";
		рс.УложитьСписокОбъектов(Список_2, "#СписокОтбор", "ТМЦ");
		Результат = рс.ВыполнитьИнструкцию(ТекстЗапроса);
		Результат.Выгрузить(СписокОтбор_1,,,"Ссылка");
	КонецЕсли;

	//Подготовим список продукции с учетом отбора
	Если Отбор_2 > 0 Тогда
		рс = СоздатьОбъект("ODBCRecordset");
		ТекстЗапроса =
		"SELECT ТМЦ.ID [Ссылка $Справочник.ТМЦ]
		|FROM $Справочник.ТМЦ AS ТМЦ
		|WHERE ТМЦ.IsFolder = 2" +
		?(Список_1.РазмерСписка() =0,"","AND ТМЦ.ID IN (SELECT Val FROM #СписокОтбор)") + "
		|ORDER BY ТМЦ.ID";
		рс.УложитьСписокОбъектов(Список_1, "#СписокОтбор", "ТМЦ");
		Результат = рс.ВыполнитьИнструкцию(ТекстЗапроса);
		Результат.Выгрузить(СписокОтбор_2,,,"Ссылка");
	КонецЕсли;
КонецПроцедуры

// Строит длинную таблицу тз (детальные строки по всем датам ДатыИзменений, с учётом текущих
// СписокОтбор_1/СписокОтбор_2/Активность) и применяет те же фильтры, что видны в самом отчёте:
// отсеивание незначимых дат (ОставитьЗначимыеДаты) и, если фВыводитьИзмененные=1, фильтр "только
// изменённые" (ОтфильтроватьТолькоИзмененные) - с повторным отсеиванием дат после него. ДатыИзменений
// меняется по ссылке (список дат, оставшихся значимыми). Используется в ЗаполнитьТаблицу(). // + claude
Функция ПолучитьДанныеЗаПериод(ПоФорме, ДатыИзменений) // + claude
	Перем тз; //:ТаблицаЗначений - длинный формат детальных строк: значение_1..7 + Ключ1..4 + Период + ЭтоФорма
	Перем НомерДаты;
	Перем КолДат;
	Перем ДатаИзменения;

	КолДат = ДатыИзменений.РазмерСписка();

	тз = СоздатьОбъект("ТаблицаЗначений");
	тз.НоваяКолонка("значение_1");
	тз.НоваяКолонка("значение_2");
	тз.НоваяКолонка("значение_3");
	тз.НоваяКолонка("значение_4");
	тз.НоваяКолонка("значение_5");
	тз.НоваяКолонка("значение_6");
	тз.НоваяКолонка("значение_7"); // + claude (Неактивен)
	тз.НоваяКолонка("Ключ1");
	тз.НоваяКолонка("Ключ2");
	тз.НоваяКолонка("Ключ3");
	тз.НоваяКолонка("Ключ4");
	тз.НоваяКолонка("Период");
	тз.НоваяКолонка("ЭтоФорма"); // + claude (1 - строка из запроса "по форме" (есть уровень Форма), 0 - "по упаковке")

	Если КолДат = 0 Тогда
		Возврат тз; // + claude
	КонецЕсли; // + claude

	Для НомерДаты = 1 По КолДат Цикл

		ДатаИзменения = ДатыИзменений.ПолучитьЗначение(НомерДаты);

		Если (ПоФорме = 1) ИЛИ (ПоФорме = 3) Тогда // + claude
			СобратьДетальныеСтроки(1, ДатаИзменения, тз); // + claude
		КонецЕсли; // + claude
		Если (ПоФорме = 2) ИЛИ (ПоФорме = 3) Тогда // + claude
			СобратьДетальныеСтроки(0, ДатаИзменения, тз); // + claude
		КонецЕсли; // + claude

		ОбновитьПрогресс(НомерДаты, КолДат); // + claude (единая точка - охватывает и Сформировать, и обработки замены/установки норм)

	КонецЦикла;

	Если тз.КоличествоСтрок() = 0 Тогда
		Возврат тз; // + claude
	КонецЕсли; // + claude

	// Ключ1 - префикс Ключ2 - префикс Ключ3 - префикс Ключ4 (тот же набор полей через "|"),
	// поэтому одна сортировка по Ключ4 упорядочивает строки сразу по всем уровням вложенности. // + claude
	тз.Сортировать("+Ключ4");

	// Отсеиваем даты, на которых для выбранной продукции/материалов ничего не изменилось (пустые/повторные колонки) // + claude
	ОставитьЗначимыеДаты(тз, ДатыИзменений); // + claude

	Если фВыводитьИзмененные = 1 Тогда // + claude
		тз = ОтфильтроватьТолькоИзмененные(тз, ДатыИзменений); // + claude
		Если тз.КоличествоСтрок() > 0 Тогда // + claude
			// после отсеивания неизменённых материалов снова убираем даты, оставшиеся без значимых изменений // + claude
			ОставитьЗначимыеДаты(тз, ДатыИзменений); // + claude
		КонецЕсли; // + claude
	КонецЕсли; // + claude

	Возврат тз; // + claude
КонецФункции

// Заполняет crosstab-таблицу с полной иерархией (Продукция/Упаковка/Форма/Материал): данные строит
// ПолучитьДанныеЗаПериод(). Уровни Продукция/Упаковка/Форма печатают только заголовок группировки,
// без итогов по датам - итоги на этих уровнях не имеют смысла для crosstab-по-периоду. Реальные
// значения по датам считаются суммированием детальных строк через ИндексированнаяТаблица только на
// уровне Материал (Группировка_4/5). // + claude
Процедура ЗаполнитьТаблицу(Таб, ДатыИзменений) // + claude
	Перем тз; //:ТаблицаЗначений - длинный формат детальных строк: значение_1..6 + Ключ1..4 + Период + ЭтоФорма
	Перем тзИндекс4; //:ИндексированнаяТаблица - индекс по Ключ4 (Материал)
	Перем тзЗнач; //:ТаблицаЗначений - буфер значения_6 по датам текущего ключа/уровня (КолДат строк)
	Перем НомерДаты;
	Перем КолДат;
	Перем Предыдущий1;
	Перем Предыдущий2;
	Перем Предыдущий3;
	Перем Предыдущий4; // + claude
	Перем ИмяСекцииМатериала; // + claude

	тз = ПолучитьДанныеЗаПериод(ПоФорме, ДатыИзменений); // + claude (единая точка получения данных - общая с обработками)
	КолДат = ДатыИзменений.РазмерСписка(); // + claude

	Если тз.КоличествоСтрок() = 0 Тогда
		ВывестиЗаголовкиДат(Таб, ДатыИзменений); // + claude
		Возврат;
	КонецЕсли;

	ВывестиЗаголовкиДат(Таб, ДатыИзменений); // + claude

	тзИндекс4 = СоздатьОбъект("ИндексированнаяТаблица");
	тзИндекс4.Загрузить(тз);
	тзИндекс4.ДобавитьИндекс("П4", "Ключ4");

	тзЗнач = СоздатьОбъект("ТаблицаЗначений");
	тзЗнач.НоваяКолонка("Значение");
	тзЗнач.НоваяКолонка("Неактив"); // + claude
	Для НомерДаты = 1 По КолДат Цикл
		тзЗнач.НоваяСтрока();
	КонецЦикла;

	Предыдущий1 = "";
	Предыдущий2 = "";
	Предыдущий3 = "";
	Предыдущий4 = ""; // + claude
	тз.ВыбратьСтроки();
	Пока тз.ПолучитьСтроку() = 1 Цикл

		// Итоги уровней Продукция/Упаковка/Форма убраны (не имеют смысла для crosstab по датам) -
		// печатается заголовок группировки и пустые ячейки по датам (чтобы остались рамки сетки
		// макета), без расчёта и вывода сумм. // + claude
		Если тз.Ключ1 <> Предыдущий1 Тогда // + claude
			Предыдущий1 = тз.Ключ1; // + claude
			Таб.ВывестиСекцию("Группировка_1|Секция_Группировки"); // + claude
			ВывестиПустыеРесурсы(Таб, "Группировка_1|Секция_Ресурсы", тз, КолДат); // + claude
		КонецЕсли; // + claude

		Если тз.Ключ2 <> Предыдущий2 Тогда // + claude
			Предыдущий2 = тз.Ключ2; // + claude
			Таб.ВывестиСекцию("Группировка_2|Секция_Группировки"); // + claude
			ВывестиПустыеРесурсы(Таб, "Группировка_2|Секция_Ресурсы", тз, КолДат); // + claude
		КонецЕсли; // + claude

		Если (тз.ЭтоФорма = 1) И (тз.Ключ3 <> Предыдущий3) Тогда // + claude (только для строк с реальным уровнем Форма)
			Предыдущий3 = тз.Ключ3; // + claude
			Таб.ВывестиСекцию("Группировка_3|Секция_Группировки"); // + claude
			ВывестиПустыеРесурсы(Таб, "Группировка_3|Секция_Ресурсы", тз, КолДат); // + claude
		КонецЕсли; // + claude

		// Детальный уровень - тз содержит по одной строке НА КАЖДУЮ ДАТУ для одного и того же Ключ4
		// (материал может встречаться на нескольких датах), поэтому выводим строку только один раз
		// на изменение Ключ4 - иначе материал дублируется по разу на каждую дату. Материалы форм
		// (ЭтоФорма=1) печатаются через отдельную область Группировка_5, материалы упаковок
		// (ЭтоФорма=0) - через Группировка_4 // + claude
		Если тз.Ключ4 <> Предыдущий4 Тогда // + claude
			Предыдущий4 = тз.Ключ4; // + claude
			ИмяСекцииМатериала = ?(тз.ЭтоФорма = 1, "Группировка_5", "Группировка_4"); // + claude
			ЗаполнитьБуферЗначений(тзИндекс4, "П4", Предыдущий4, ДатыИзменений, КолДат, тзЗнач, 0); // + claude
			Таб.ВывестиСекцию(ИмяСекцииМатериала + "|Секция_Группировки"); // + claude
			ВывестиСтрокуРесурсов(Таб, ИмяСекцииМатериала + "|Секция_Ресурсы", тз, тзЗнач, ДатыИзменений, КолДат); // + claude
		КонецЕсли; // + claude

	КонецЦикла;

КонецПроцедуры

Процедура Сформировать()
	Перем тз; 
	
	Если Обновить = 2 Тогда
	    СтрокаДействийФормы = "#Закрыть";
	КонецЕсли;
	
	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить("Список_1", Список_1);
	Расшифровка.Установить("Список_2", Список_2);
	Расшифровка.Установить("ПоФорме", ПоФорме);
	Расшифровка.Установить("Активность", Активность);
	Расшифровка.Установить("ВыбДата",  ВыбДата);
	Расшифровка.Установить("НачДата", НачДата); // + claude
	Расшифровка.Установить("КонДата", КонДата); // + claude
	Расшифровка.Установить("фВыводитьИзмененные", фВыводитьИзмененные); // + claude
	Расшифровка.Установить("Отчет", "Отчет_ПоМатериаламФормУпаковки");
	
	Расшифровка.Установить("Обновить");

	ПодготовитьСпискиОтбора(); // + claude (общая с обработками замены/установки норм подготовка отборов)

	// Подготовка к заполнению выходных форм данными запроса
	Если (ТипЗначенияСтр(Таб) <> "Таблица") ИЛИ (Обновить=0) Тогда
	  Таб = СоздатьОбъект("Таблица");
	Иначе
	  Таб.Очистить();
	КонецЕсли;
	
	Таб.ИсходнаяТаблица("ТабОтчета");
	ЗаголовокОтчета = ?(ПоФорме=1,"Материалы формы упаковки",?(ПоФорме=2,"Материалы упаковки","Материалы формы упаковки и упаковки")); // + claude
	
	УстановитьЗаголовки();
	Таб.ВывестиСекцию("Кнопки|Секция_Группировки");
	Таб.ВывестиСекцию("Шапка|Секция_Группировки");
	Таб.Опции(0,0,Таб.ВысотаТаблицы(),4);

	// Даты изменений периодических реквизитов (Материал, НормаСписания) в границах НачДата..КонДата - по одной колонке на дату // + claude
	ДатыИзменений = ПолучитьДатыИзменений(НачДата, КонДата, ПоФорме); // + claude

	Если ДатыИзменений.РазмерСписка() = 0 Тогда // + claude
		ДатыИзменений.ДобавитьЗначение(КонДата); // + claude (нет изменений за период - показываем состояние на конец периода)
	КонецЕсли; // + claude

	// Колонки-заголовки дат выводятся в ЗаполнитьТаблицу (после отсеивания дат, на которых для выбранной продукции/материалов ничего не изменилось) // + claude

	ЗаполнитьТаблицу(Таб, ДатыИзменений); // + claude

	Таб.ВывестиСекцию("Подвал");
	Таб.ТолькоПросмотр(1);
	Таб.Показать(ЗаголовокОтчета,"");

КонецПроцедуры

Процедура УстановитьНовыеНормы() // + claude
	Перем Материал;
	Перем НоваяНорма;

	Перем ВсегоНорм; // + claude
	Перем НомерСтроки; // + claude

	Если ПустоеЗначение(ВыбДата) = 1 Тогда
		Предупреждение("Не заполнена дата (ВыбДата) - установка норм не выполнена.");
		Возврат;
	КонецЕсли;

	Если ТаблицаНовыхНорм.КоличествоСтрок() = 0 Тогда
		Предупреждение("Таблица новых норм пуста - установка норм не выполнена.");
		Возврат;
	КонецЕсли;

	НачатьЛогОперации("Установка норм списания"); // + claude

	ВсегоНорм = ТаблицаНовыхНорм.КоличествоСтрок(); // + claude
	НомерСтроки = 0; // + claude
	ТаблицаНовыхНорм.ВыбратьСтроки();
	Пока ТаблицаНовыхНорм.ПолучитьСтроку() = 1 Цикл
		НомерСтроки = НомерСтроки + 1; // + claude
		Материал = ТаблицаНовыхНорм.Материал;
		НоваяНорма = ТаблицаНовыхНорм.НормаСписания;
		Если ПустоеЗначение(Материал) = 1 Тогда
			Продолжить;
		КонецЕсли;
		Если (ПоФорме = 2) ИЛИ (ПоФорме = 3) Тогда // + claude (учитываем режим отчёта - только Упаковки)
			УстановитьНормуВНормах("УМК_НормыСписанияМатериаловУпаковок", Материал, НоваяНорма, ВыбДата, Список_1); // + claude
		КонецЕсли; // + claude
		Если (ПоФорме = 1) ИЛИ (ПоФорме = 3) Тогда // + claude (учитываем режим отчёта - только Формы)
			УстановитьНормуВНормах("УМК_НормыСписанияМатериаловУпаковокФорм", Материал, НоваяНорма, ВыбДата, Список_1); // + claude
		КонецЕсли; // + claude
		ОбновитьПрогресс(НомерСтроки, ВсегоНорм); // + claude
	КонецЦикла;

	ЗавершитьЛогОперации(); // + claude

	Предупреждение("Новые нормы установлены. Лог: " + ПутьКФайлуЛога); // + claude
КонецПроцедуры // УстановитьНовыеНормы()

//Выполняет перенос активных материалов из справочника
//УМК_НормыСписанияМатериаловУпаковокФорм в УМК_НормыСписанияМатериаловУпаковок на дату-ВыбДата
// Текст запроса для поиска владельцев (УМК_РазрешенныеВидыУпаковкиТМЦ), чья текущая ФормаУпаковка на дату
// :Дата равна :ФормаУпаковки - чтобы перенести материал формы во все записи Упаковок, ссылающиеся на эту форму. // + claude
Функция ТекстЗапросаВладельцевПоФорме() // + claude
	Возврат
	"SELECT УМК_РазрешенныеВидыУпаковкиТМЦ.ID [Ссылка $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ]
	|FROM $Справочник.УМК_РазрешенныеВидыУпаковкиТМЦ AS УМК_РазрешенныеВидыУпаковкиТМЦ
	|WHERE ($ПоследнееЗначение.УМК_РазрешенныеВидыУпаковкиТМЦ.ФормаУпаковки(УМК_РазрешенныеВидыУпаковкиТМЦ.ID, :Дата) = :ФормаУпаковки)
	|	AND (УМК_РазрешенныеВидыУпаковкиТМЦ.ISMARK = 0)";
КонецФункции

Процедура ПеренестиМатериалыИзФормыВУпаковку() // + claude
	Перем СпрФорм;
	Перем СпрУпак;
	Перем рс;
	Перем Результат; //:ТаблицаЗначений
	Перем Материал;
	Перем Норма;
	Перем Найдено; // + claude
	Перем ОшибкаПолучения; // + claude
	Перем ТекущийМатериалУпак; // + claude
	Перем КолПеренесено;
	Перем КолПропущеноПоОшибке; // + claude
	Перем СтароеЗначениеМатериала; // + claude (старое Материал в СпрУпак перед перезаписью - для лога)
	Перем СтараяНормаУпак; // + claude
	Перем СтароеНеактивен; // + claude
	Перем тзИндексУпак; // + claude
	Перем тИндексУпак; // + claude
	Перем КлючПоиска; // + claude
	Перем сзПоиска; // + claude

	Если ПустоеЗначение(ВыбДата) = 1 Тогда
		Предупреждение("Не заполнена дата (ВыбДата) - перенос не выполнен.");
		Возврат;
	КонецЕсли;

	СпрФорм = СоздатьОбъект("Справочник.УМК_НормыСписанияМатериаловУпаковокФорм");
	СпрУпак = СоздатьОбъект("Справочник.УМК_НормыСписанияМатериаловУпаковок");
	КолПеренесено = 0;
	КолПропущеноПоОшибке = 0; // + claude

	НачатьЛогОперации("Перенос материалов форм в упаковку"); // + claude

	// Раньше поиск существующей записи упаковки делал полный ВыбратьЭлементы(0) по ВСЕМУ справочнику
	// СпрУпак заново для КАЖДОЙ пары (запись формы x владелец) - O(N*M*K), очень медленно на реальных
	// объёмах. Строим индекс "Владелец|Материал" -> Код ОДИН раз (единственный полный проход K), дальше
	// ищем по нему (O(log K) через ИндексированнаяТаблица). Найденную запись позиционируем через
	// ИспользоватьВладельца+НайтиПоКоду (та же комбинация, что уже подтверждена рабочей с .Получить()
	// в ОткатитьПоЛогу) - в отличие от ВыбратьЭлементы() в owner-scoped режиме, который ломает
	// .Получить() (см. feedback_1c77_subordinate_catalog). Попытка/Исключение при построении индекса -
	// на некоторых записях .Получить() всё равно падает по неясной причине (см. выше по сессии) -
	// такие записи просто не попадают в индекс (дальше будут считаться "не найдено"). // + claude
	тзИндексУпак = СоздатьОбъект("ТаблицаЗначений"); // + claude
	тзИндексУпак.НоваяКолонка("Ключ"); // + claude
	тзИндексУпак.НоваяКолонка("Код"); // + claude

	СпрУпак.ВыбратьЭлементы(0); // + claude
	Пока СпрУпак.ПолучитьЭлемент() = 1 Цикл // + claude
		Если СпрУпак.ПометкаУдаления() = 1 Тогда // + claude
			Продолжить; // + claude
		КонецЕсли; // + claude
		Если ПустоеЗначение(СпрУпак.Владелец) = 1 Тогда // + claude
			Продолжить; // + claude
		КонецЕсли; // + claude
		ОшибкаПолучения = 0; // + claude
		Попытка // + claude
			ТекущийМатериалУпак = СпрУпак.Материал.Получить(ВыбДата); // + claude
		Исключение // + claude
			ОшибкаПолучения = 1; // + claude
		КонецПопытки; // + claude
		Если ОшибкаПолучения = 1 Тогда // + claude
			КолПропущеноПоОшибке = КолПропущеноПоОшибке + 1; // + claude
			Продолжить; // + claude
		КонецЕсли; // + claude
		тзИндексУпак.НоваяСтрока(); // + claude
		тзИндексУпак.Ключ = ЗначениеВСтрокуВнутр(СпрУпак.Владелец) + "|" + ЗначениеВСтрокуВнутр(ТекущийМатериалУпак); // + claude
		тзИндексУпак.Код = СпрУпак.Код; // + claude
	КонецЦикла; // + claude

	тИндексУпак = СоздатьОбъект("ИндексированнаяТаблица"); // + claude
	тИндексУпак.Загрузить(тзИндексУпак); // + claude
	тИндексУпак.ДобавитьИндекс("ПоКлючу", "Ключ"); // + claude

	СпрФорм.ВыбратьЭлементы(0);
	Пока СпрФорм.ПолучитьЭлемент() = 1 Цикл
		Если СпрФорм.ПометкаУдаления() = 1 Тогда
			Продолжить;
		КонецЕсли;
		Если СпрФорм.Неактивен.Получить(ВыбДата) = 1 Тогда
			Продолжить;
		КонецЕсли;

		Материал = СпрФорм.Материал.Получить(ВыбДата);
		Норма = СпрФорм.НормаСписания.Получить(ВыбДата);
		Если ПустоеЗначение(Материал) = 1 Тогда
			Продолжить;
		КонецЕсли;

		рс = СоздатьОбъект("ODBCRecordset");
		рс.УстановитьТекстовыйПараметр("ФормаУпаковки", СпрФорм.Владелец); // + claude (без скобок - это свойство, не метод)
		рс.УстановитьТекстовыйПараметр("Дата", ВыбДата);
		Результат = рс.ВыполнитьИнструкцию(ТекстЗапросаВладельцевПоФорме());
		Результат.ВыбратьСтроки();

		Пока Результат.ПолучитьСтроку() = 1 Цикл
			КлючПоиска = ЗначениеВСтрокуВнутр(Результат.Ссылка) + "|" + ЗначениеВСтрокуВнутр(Материал); // + claude
			сзПоиска = СоздатьОбъект("СписокЗначений"); // + claude
			сзПоиска.ДобавитьЗначение(КлючПоиска); // + claude
			тИндексУпак.Подмножество(сзПоиска, 1, "ПоКлючу"); // + claude
			тИндексУпак.ВыбратьСтроки("ПоКлючу"); // + claude
			Найдено = тИндексУпак.ПолучитьСтроку("ПоКлючу"); // + claude (1, если в индексе есть запись с таким владельцем+материалом)

			СпрУпак.ИспользоватьВладельца(Результат.Ссылка); // + claude (нужен и для НайтиПоКоду ниже, и для Новый())
			Если Найдено = 1 Тогда // + claude
				СпрУпак.НайтиПоКоду(тИндексУпак.Код); // + claude
				СтароеЗначениеМатериала = СпрУпак.Материал.Получить(ВыбДата); // + claude
				СтараяНормаУпак = СпрУпак.НормаСписания.Получить(ВыбДата); // + claude
			Иначе // + claude
				СпрУпак.Новый();
			КонецЕсли; // + claude

			СпрУпак.ИспользоватьДату(ВыбДата, 1);
			СпрУпак.Материал = Материал;
			СпрУпак.НормаСписания = Норма;
			СпрУпак.Записать();

			// Лог пишем ПОСЛЕ Записать() - для только что созданного (Новый()) элемента Код/Ссылка становятся
			// корректными только после записи. // + claude
			Если Найдено = 0 Тогда // + claude
				ЗаписатьВЛогСоздания("УМК_НормыСписанияМатериаловУпаковок", СпрУпак, "Материал", ВыбДата, Материал); // + claude
				ЗаписатьВЛогСоздания("УМК_НормыСписанияМатериаловУпаковок", СпрУпак, "НормаСписания", ВыбДата, Норма); // + claude
			Иначе // + claude
				ЗаписатьВЛог("УМК_НормыСписанияМатериаловУпаковок", СпрУпак, "Материал", ВыбДата, СтароеЗначениеМатериала, Материал); // + claude
				ЗаписатьВЛог("УМК_НормыСписанияМатериаловУпаковок", СпрУпак, "НормаСписания", ВыбДата, СтараяНормаУпак, Норма); // + claude
			КонецЕсли; // + claude
		КонецЦикла;

		СтароеНеактивен = СпрФорм.Неактивен.Получить(ВыбДата); // + claude
		СпрФорм.Неактивен.Установить(ВыбДата, 1);
		ЗаписатьВЛог("УМК_НормыСписанияМатериаловУпаковокФорм", СпрФорм, "Неактивен", ВыбДата, СтароеНеактивен, 1); // + claude
		СпрФорм.Записать();
		КолПеренесено = КолПеренесено + 1;
	КонецЦикла;

	ЗавершитьЛогОперации(); // + claude

	Предупреждение("Перенесено активных материалов: " + КолПеренесено +
		". Пропущено по ошибке поиска: " + КолПропущеноПоОшибке +
		". Лог: " + ПутьКФайлуЛога); // + claude
КонецПроцедуры //ПеренестиМатериалыИзФормыВУпаковку()

МалыйПрогресс = ""; //заполнение на 100% = значение 63*"g"
ТаблицаНовыхНорм.НоваяКолонка("Материал","Справочник.ТМЦ",,,"Материал"); // + claude (было "ТМЦ" без "Справочник." - неверный тип)
ТаблицаНовыхНорм.НоваяКолонка("НормаСписания", "Число",15,5,"Норма списания");