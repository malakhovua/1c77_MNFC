// + claude
Перем Расшифровка;
Перем Обновить;
Перем Таб;
Перем Контрагент;
Перем Контрагент_Наименование;
Перем ДнейОтсрочки;
Перем КонечныйОстаток;
Перем КонечныйОстатокИтог;
Перем СтрРасшифровка;
Перем РежимСписка; // + claude 1 - список контрагентов без сумм
Перем НачДата; // + claude дата глубины кредита
Перем ДолгНаДатуГлубины; // + claude
Перем Оплаты; // + claude
Перем Возвраты; // + claude возвраты товара
Перем ОплатыБонусы; // + claude
Перем Прочие; // + claude прочие операции погашения
Перем ЗаголовокТекст; // + claude заголовок макета в зависимости от режима
Перем ТабРасш; // + claude таблица расшифровки колонки по документам
Перем ПараметрыРасш; // + claude параметры выводимой расшифровки (для кнопки Обновить)
Перем Расш_Заголовок; // + claude
Перем Документ; // + claude
Перем ДокументОснование; // + claude
Перем Сумма_расш; // + claude
Перем СумаДок_расш; // + claude
Перем СумаДокОснование_расш; // + claude
Перем СумаИтог_расш; // + claude

Процедура Сформировать() Далее
Процедура СписокКонтрагентов() Далее
Процедура ВывестиИерархию(ТЗРез, ТЗГрупп) Далее // + claude
Процедура ВывестиРасшифровку(Парам) Далее // + claude
///////////////////////////////////Предопределенные процедуры///////////////////////////////////////////////

Процедура ПриОткрытии()

	Если глФлагРасшифровки = 1 Тогда

		Обновить = глОбновить;

		Если глРасшифровка.Получить("ВидРасшифровки") = "ДокументыПогашения" Тогда // + claude
			ТабРасш = ?(Обновить <> 0, глТаблица, ""); // + claude
			ВывестиРасшифровку(глРасшифровка); // + claude
			СтатусВозврата(0); // + claude
			Возврат; // + claude
		КонецЕсли; // + claude

		Период = глРасшифровка.Получить("Период");
		глРасшифровка.Получить("СписКонтрагентов").Выгрузить(списКонтрагентов);

		Если Обновить <> 0 Тогда
			Таб = глТаблица;
		КонецЕсли;

		Если Обновить <> 2 Тогда
			Если глРасшифровка.Получить("РежимСписка") = 1 Тогда // + claude
				СписокКонтрагентов(); // + claude
			Иначе // + claude
				Сформировать();
			КонецЕсли; // + claude
			СтатусВозврата(0);
			Возврат;
		КонецЕсли;
	Иначе
		Обновить = 0;
		Период = ТекущаяДата();
	КонецЕсли;

	Форма.КнопкаПоУмолчанию("Сформировать");

КонецПроцедуры // ПриОткрытии()

///////////////////////////////////Расшифровка//////////////////////////////////////////////////////////////

Функция РасшифровкаОбновить(Обновить)

	Если ТипЗначенияСтр(ПараметрыРасш) = "СписокЗначений" Тогда // + claude кнопка Обновить таблицы расшифровки
		ПараметрыРасш.Установить("Обновить", Обновить); // + claude
		Возврат ПараметрыРасш; // + claude
	КонецЕсли; // + claude

	Расшифровка.Установить("Обновить", Обновить);

	Возврат Расшифровка;

КонецФункции // РасшифровкаОбновить()

// Расшифровка колонки погашений строки контрагента (вызывается из макета):
// 1 - оплаты, 2 - возвраты, 3 - оплаты бонусами, 4 - прочие
Функция РасшКолонки(НомерКолонки) // + claude

	Сумма = ?(НомерКолонки = 1, Оплаты, ?(НомерКолонки = 2, Возвраты, ?(НомерКолонки = 3, ОплатыБонусы, Прочие)));
	Если Сумма = 0 Тогда
		Возврат СтрРасшифровка;
	КонецЕсли;

	Спис = СоздатьОбъект("СписокЗначений");
	Спис.Установить("ВидРасшифровки", "ДокументыПогашения");
	Спис.Установить("Колонка", НомерКолонки);
	Спис.Установить("Контрагент", Контрагент);
	Спис.Установить("Глубина", ДнейОтсрочки);
	Спис.Установить("Период", Период);
	Спис.Установить("Отчет", "Очет_ПоПросроченнымДолгамКонтрагентов");

	Возврат Спис;

КонецФункции // РасшКолонки()

Процедура ОбработкаЯчейкиТаблицы(ТекЗначение, ТекФлагСтандОбраб, ТекТаблица, ТекАдрес)

	Если ТекЗначение = "СохранитиXLSX" Тогда
		глСохранитьТабДокXLSX(ТекТаблица);
		ТекФлагСтандОбраб = 0;
		Возврат;
	КонецЕсли;

	Если ТипЗначенияСтр(ТекЗначение) = "СписокЗначений" Тогда // + claude
		Если ТекЗначение.Получить("ВидРасшифровки") = "ДокументыПогашения" Тогда // + claude
			ТекФлагСтандОбраб = 0; // + claude
			ТабРасш = ?(Число(ТекЗначение.Получить("Обновить")) <> 0, ТекТаблица, ""); // + claude
			ВывестиРасшифровку(ТекЗначение); // + claude
			Возврат; // + claude
		КонецЕсли; // + claude
	КонецЕсли; // + claude

	глОбработкаЯчейкиТаблицы(ТекЗначение, ТекФлагСтандОбраб, ТекТаблица, ТекАдрес);

КонецПроцедуры // ОбработкаЯчейкиТаблицы()

/////////////////////////////////Вспомогательные/////////////////////////////////////////////////////////////

// Строка отступа для уровня иерархии
Функция Отступ(Уровень)

	Рез = "";
	Для Сч = 1 По Уровень Цикл
		Рез = Рез + "    ";
	КонецЦикла;

	Возврат Рез;

КонецФункции // Отступ()

// Новая таблица с колонками сумм
Функция НоваяТаблицаСумм(ПерваяКолонка) // + claude

	ТЗ = СоздатьОбъект("ТаблицаЗначений");
	ТЗ.НоваяКолонка(ПерваяКолонка);
	ТЗ.НоваяКолонка("Глубина");
	ТЗ.НоваяКолонка("Путь");
	ТЗ.НоваяКолонка("ДолгНаДатуГлубины");
	ТЗ.НоваяКолонка("Оплаты");
	ТЗ.НоваяКолонка("Возвраты");
	ТЗ.НоваяКолонка("ОплатыБонусы");
	ТЗ.НоваяКолонка("Прочие");
	ТЗ.НоваяКолонка("Сумма");

	Возврат ТЗ;

КонецФункции // НоваяТаблицаСумм()

// Заполнение выводимых сумм из строки таблицы (НомСтр = 0 - нули)
Процедура ЗаполнитьСуммы(ТЗ, НомСтр) // + claude

	Если НомСтр = 0 Тогда
		ДолгНаДатуГлубины = 0;
		Оплаты = 0;
		Возвраты = 0;
		ОплатыБонусы = 0;
		Прочие = 0;
		КонечныйОстаток = 0;
	Иначе
		ДолгНаДатуГлубины = ТЗ.ПолучитьЗначение(НомСтр, "ДолгНаДатуГлубины");
		Оплаты = ТЗ.ПолучитьЗначение(НомСтр, "Оплаты");
		Возвраты = ТЗ.ПолучитьЗначение(НомСтр, "Возвраты");
		ОплатыБонусы = ТЗ.ПолучитьЗначение(НомСтр, "ОплатыБонусы");
		Прочие = ТЗ.ПолучитьЗначение(НомСтр, "Прочие");
		КонечныйОстаток = ТЗ.ПолучитьЗначение(НомСтр, "Сумма");
	КонецЕсли;

КонецПроцедуры // ЗаполнитьСуммы()

// Вывод строки группы (group_1) или контрагента (group_2)
Процедура ВывестиСтроку(ИмяСекции, Значение, Уровень, ТЗ, НомСтр, Глубина) // + claude

	Контрагент = Значение;
	Контрагент_Наименование = Отступ(Уровень) + Значение.Наименование;
	ДнейОтсрочки = Глубина;
	НачДата = ?(ИмяСекции = "group_2", Период - Глубина, ""); // + claude
	ЗаполнитьСуммы(ТЗ, НомСтр); // + claude
	СтрРасшифровка = Значение;

	Если РежимСписка = 1 Тогда // + claude
		Таб.ВывестиСекцию(ИмяСекции + "|Секция_Контрагент"); // + claude
	Иначе // + claude
		Таб.ВывестиСекцию(ИмяСекции);
	КонецЕсли; // + claude

КонецПроцедуры // ВывестиСтроку()

// Расшифровка и выходная таблица для текущего режима
Процедура ПодготовитьТаблицу() // + claude

	Расшифровка = СоздатьОбъект("СписокЗначений");
	Расшифровка.Установить("Период", Период);
	Расшифровка.Установить("СписКонтрагентов", списКонтрагентов);
	Расшифровка.Установить("РежимСписка", РежимСписка);
	Расшифровка.Установить("Отчет", "Очет_ПоПросроченнымДолгамКонтрагентов");
	Расшифровка.Установить("Обновить");

	Если (ТипЗначенияСтр(Таб) <> "Таблица") ИЛИ (Обновить = 0) Тогда
		Таб = СоздатьОбъект("Таблица");
	Иначе
		Таб.Очистить();
	КонецЕсли;
	Таб.ИсходнаяТаблица("Таблица");

КонецПроцедуры // ПодготовитьТаблицу()

// Вывод секции шапки/подвала с учетом режима
Процедура ВывестиОбщуюСекцию(ИмяСекции) // + claude

	Если РежимСписка = 1 Тогда
		Таб.ВывестиСекцию(ИмяСекции + "|Секция_Контрагент");
	Иначе
		Таб.ВывестиСекцию(ИмяСекции);
	КонецЕсли;

КонецПроцедуры // ВывестиОбщуюСекцию()

// Список групп контрагента сверху вниз
Функция ПредкиКонтрагента(Элт)

	Спис = СоздатьОбъект("СписокЗначений");
	Род = Элт.Родитель;
	Пока ПустоеЗначение(Род) = 0 Цикл
		Спис.ВставитьЗначение(1, Род); // + claude
		Род = Род.Родитель;
	КонецЦикла;

	Возврат Спис;

КонецФункции // ПредкиКонтрагента()

// Прибавляет суммы текущей строки ТЗРез к итогу с ключом Ключ (группа или общий итог)
Процедура ДобавитьКИтогу(ТЗГрупп, Ключ, ТЗРез) // + claude

	Перем НомСтр;

	Если ТЗГрупп.НайтиЗначение(Ключ, НомСтр, "Ключ") = 0 Тогда
		ТЗГрупп.НоваяСтрока();
		ТЗГрупп.Ключ = Ключ;
		ТЗГрупп.ДолгНаДатуГлубины = 0;
		ТЗГрупп.Оплаты = 0;
		ТЗГрупп.Возвраты = 0;
		ТЗГрупп.ОплатыБонусы = 0;
		ТЗГрупп.Прочие = 0;
		ТЗГрупп.Сумма = 0;
		НомСтр = ТЗГрупп.НомерСтроки;
	КонецЕсли;
	ТЗГрупп.ПолучитьСтрокуПоНомеру(НомСтр);
	ТЗГрупп.ДолгНаДатуГлубины = ТЗГрупп.ДолгНаДатуГлубины + ТЗРез.ДолгНаДатуГлубины;
	ТЗГрупп.Оплаты = ТЗГрупп.Оплаты + ТЗРез.Оплаты;
	ТЗГрупп.Возвраты = ТЗГрупп.Возвраты + ТЗРез.Возвраты;
	ТЗГрупп.ОплатыБонусы = ТЗГрупп.ОплатыБонусы + ТЗРез.ОплатыБонусы;
	ТЗГрупп.Прочие = ТЗГрупп.Прочие + ТЗРез.Прочие;
	ТЗГрупп.Сумма = ТЗГрупп.Сумма + ТЗРез.Сумма;

КонецПроцедуры // ДобавитьКИтогу()

// Номер строки итога с ключом Ключ (0 - нет итога)
Функция СтрокаИтога(ТЗГрупп, Ключ) // + claude

	Перем НомСтр;

	Если ТЗГрупп.НайтиЗначение(Ключ, НомСтр, "Ключ") = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат НомСтр;

КонецФункции // СтрокаИтога()

// Ключ расчета - основной партнер, если заполнен, иначе сам контрагент
Функция ВыражениеПартнера(Псевдоним) // + claude

	Возврат "CASE WHEN $" + Псевдоним + ".ОсновнойПартнер = $ПустойИД THEN " + Псевдоним + ".ID ELSE $" + Псевдоним + ".ОсновнойПартнер END";

КонецФункции // ВыражениеПартнера()

// Глубина кредита партнера на дату Период
Функция ВыражениеГлубины() // + claude

	Возврат "CAST(ISNULL($ПоследнееЗначение.Контрагенты.Глубина(Партнеры.ID, :Период), 0) AS int)";

КонецФункции // ВыражениеГлубины()

// Текст запроса движений после даты глубины каждого партнера: общий оборот и погашения долга любыми документами.
// Погашение по документу: Расход - Приход; для отгрузки (Приход > 0) - только превышение Расхода над Приходом.
// Возврат товара (отрицательный Приход) увеличивает погашения, возврат денег (отрицательный Расход) уменьшает.
// Долг на дату глубины - на начало дня (Период - Глубина), движения этого дня входят в погашения.
// При глубине 0 движения не берутся - просроченным считается весь долг на конец дня Период.
// Погашение делится: возвраты товара (отрицательный Приход), а расходная часть - по виду документа
// на оплаты (касса, банк, оплата в накладной), бонусы и прочие операции.
// По ВозвратнойНакладной возвраты считаются отдельным запросом (ТекстЗапросаВозвратов).
// ПоДокументам = 1 - строки по контрагентам и документам (расшифровка), иначе - по партнерам.
// Параметры запроса: НачДата, Период.
Функция ТекстЗапросаПогашений(ПоДокументам, Условие) // + claude

	ЧастьРасход = "CASE WHEN Рег.ДолгОснПриход <= 0 THEN Рег.ДолгОснРасход
	|		WHEN Рег.ДолгОснРасход > Рег.ДолгОснПриход THEN Рег.ДолгОснРасход - Рег.ДолгОснПриход
	|		ELSE 0 END";
	ВидыОплат = "$ВидДокумента.ПриходныйКассовый, $ВидДокумента.РасходныйКассовый, $ВидДокумента.БанковскаяВыписка,
	|		$ВидДокумента.УМК_КассоваяВедомость, $ВидДокумента.УМК_КассоваяВедомостьРасходная,
	|		$ВидДокумента.РасходнаяНакладная, $ВидДокумента.РасходнаяРозничная";
	ВидыБонусов = "$ВидДокумента.НачислениеБонуса, $ВидДокумента.УМК_ПремииПоПланамПродажКонтрагенты";
	Глубина = ВыражениеГлубины();

	Если ПоДокументам = 1 Тогда
		Поля = "Контрагенты.ID [Контрагент $Справочник.Контрагенты]
		|	, Рег.ПозицияДокумента ПозДок
		|	, RIGHT(Рег.ПозицияДокумента, 9) [Док $Документ]
		|	, ISNULL(Жур.IDDOCDEF, 0) Док_вид";
		Группировка = "Контрагенты.ID, Рег.ПозицияДокумента, Жур.IDDOCDEF";
	Иначе
		Поля = "Партнеры.ID [Контрагент $Справочник.Контрагенты]";
		Группировка = "Партнеры.ID";
	КонецЕсли;

	Возврат "
	|SELECT " + Поля + "
	|	, SUM(Рег.ДолгОснПриход - Рег.ДолгОснРасход) Оборот
	|	, SUM(CASE WHEN (Рег.ДолгОснПриход < 0) AND (ISNULL(Жур.IDDOCDEF, 0) <> $ВидДокумента.ВозвратнаяНакладная)
	|		THEN -Рег.ДолгОснПриход ELSE 0 END) Возвраты
	|	, SUM(CASE WHEN ISNULL(Жур.IDDOCDEF, 0) IN (" + ВидыОплат + ") THEN " + ЧастьРасход + " ELSE 0 END) Оплаты
	|	, SUM(CASE WHEN ISNULL(Жур.IDDOCDEF, 0) IN (" + ВидыБонусов + ") THEN " + ЧастьРасход + " ELSE 0 END) ОплатыБонусы
	|	, SUM(CASE WHEN ISNULL(Жур.IDDOCDEF, 0) IN (" + ВидыОплат + ", " + ВидыБонусов + ") THEN 0 ELSE " + ЧастьРасход + " END) Прочие
	|FROM $РегистрОстаткиОбороты.ВзаиморасчетыПокупателей(:НачДата, :Период~, Документ, Движения, , ,
	|		(Контрагент), (ДолгОсн)) AS Рег
	|	INNER JOIN $Справочник.Контрагенты AS Контрагенты ON Рег.Контрагент = Контрагенты.ID
	|	INNER JOIN $Справочник.Контрагенты AS Партнеры ON Партнеры.ID = " + ВыражениеПартнера("Контрагенты") + "
	|	LEFT JOIN _1SJOURN AS Жур ON Жур.IDDOC = RIGHT(Рег.ПозицияДокумента, 9)
	|WHERE (DATEDIFF(day, CAST(LEFT(Рег.ПозицияДокумента, 8) AS DateTime), CAST(:Период AS DateTime)) <= " + Глубина + ")
	|	AND (" + Глубина + " > 0) " + Условие + "
	|GROUP BY " + Группировка;

КонецФункции // ТекстЗапросаПогашений()

// Текст запроса возвратов по ВозвратнойНакладной: доля суммы документа в регистре, приходящаяся на строки,
// у которых ДокПродажи выписан до даты глубины (долг по нему входит в ДолгНаДатуГлубины).
// ПоДокументам = 1 - строки по контрагентам, документам возврата и ДокПродажи (расшифровка), иначе - по партнерам.
// Параметры запроса: НачДата, Период.
Функция ТекстЗапросаВозвратов(ПоДокументам, Условие) // + claude

	Глубина = ВыражениеГлубины();

	Если ПоДокументам = 1 Тогда
		Поля = "Контрагенты.ID [Контрагент $Справочник.Контрагенты]
		|	, Рег.ПозицияДокумента ПозДок
		|	, RIGHT(Рег.ПозицияДокумента, 9) [Док $Документ.ВозвратнаяНакладная]
		|	, Прод.ДокОсн [ДокОсн $Документ.РасходнаяНакладная]";
		Группировка = "Контрагенты.ID, Рег.ПозицияДокумента, Прод.ДокОсн";
	Иначе
		Поля = "Партнеры.ID [Контрагент $Справочник.Контрагенты]";
		Группировка = "Партнеры.ID";
	КонецЕсли;

	Возврат "
	|SELECT " + Поля + "
	|	, SUM(-Рег.ДолгОснПриход * Прод.Сумма / Всего.Сумма) Возвраты
	|FROM $РегистрОстаткиОбороты.ВзаиморасчетыПокупателей(:НачДата, :Период~, Документ, Движения, , ,
	|		(Контрагент), (ДолгОсн)) AS Рег
	|	INNER JOIN $Справочник.Контрагенты AS Контрагенты ON Рег.Контрагент = Контрагенты.ID
	|	INNER JOIN $Справочник.Контрагенты AS Партнеры ON Партнеры.ID = " + ВыражениеПартнера("Контрагенты") + "
	|	INNER JOIN (SELECT Стр.IDDOC, SUM($Стр.СуммаСНДС) Сумма
	|		FROM $ДокументСтроки.ВозвратнаяНакладная AS Стр
	|			INNER JOIN _1SJOURN AS ЖВ ON ЖВ.IDDOC = Стр.IDDOC
	|		WHERE ЖВ.DATE_TIME_IDDOC >= :НачДата
	|		GROUP BY Стр.IDDOC
	|		HAVING SUM($Стр.СуммаСНДС) <> 0) AS Всего ON Всего.IDDOC = RIGHT(Рег.ПозицияДокумента, 9)
	|	INNER JOIN (SELECT Стр.IDDOC, $Стр.ДокПродажи ДокОсн, CAST(LEFT(ЖП.DATE_TIME_IDDOC, 8) AS DateTime) ДатаПродажи, SUM($Стр.СуммаСНДС) Сумма
	|		FROM $ДокументСтроки.ВозвратнаяНакладная AS Стр
	|			INNER JOIN _1SJOURN AS ЖВ ON ЖВ.IDDOC = Стр.IDDOC
	|			INNER JOIN _1SJOURN AS ЖП ON ЖП.IDDOC = $Стр.ДокПродажи
	|		WHERE ЖВ.DATE_TIME_IDDOC >= :НачДата
	|		GROUP BY Стр.IDDOC, $Стр.ДокПродажи, LEFT(ЖП.DATE_TIME_IDDOC, 8)) AS Прод ON Прод.IDDOC = RIGHT(Рег.ПозицияДокумента, 9)
	|WHERE (Рег.ДолгОснПриход < 0)
	|	AND (DATEDIFF(day, CAST(LEFT(Рег.ПозицияДокумента, 8) AS DateTime), CAST(:Период AS DateTime)) <= " + Глубина + ")
	|	AND (" + Глубина + " > 0)
	|	AND (DATEDIFF(day, Прод.ДатаПродажи, CAST(:Период AS DateTime)) > " + Глубина + ") " + Условие + "
	|GROUP BY " + Группировка;

КонецФункции // ТекстЗапросаВозвратов()

/////////////////////////////////Обработка команды//////////////////////////////////////////////////////////

Процедура Сформировать()

	Перем ИндДвижения;

	Если Обновить = 2 Тогда
		СтрокаДействийФормы = "#Закрыть";
	КонецЕсли;

	Если ПустоеЗначение(Период) = 1 Тогда
		Предупреждение("Не задан период!");
		Возврат;
	КонецЕсли;

	ЕстьОтбор = ?(списКонтрагентов.РазмерСписка() > 0, 1, 0);
	ВыражПартнер = ВыражениеПартнера("Контрагенты"); // + claude
	УсловиеОтбора = ?(ЕстьОтбор = 1, " AND (Партнеры.ID IN (SELECT " + ВыражениеПартнера("К2") + " FROM $Справочник.Контрагенты AS К2 WHERE К2.ID IN (SELECT Val FROM #списКонтрагентов)))", ""); // + claude

	РежимСписка = 0; // + claude
	ЗаголовокТекст = "Звіт про суми прострочених боргів контрагентів на дату "; // + claude
	ПодготовитьТаблицу(); // + claude

	Состояние("Расчет долгов контрагентов...");

	рс = СоздатьОбъект("ODBCRecordset");
	Если ЕстьОтбор = 1 Тогда
		рс.УложитьСписокОбъектов(списКонтрагентов, "#списКонтрагентов", "Контрагенты");
	КонецЕсли;

	// 1. Срез долгов на дату Период и глубина кредита по основному партнеру // + claude
	ТекстЗапроса = "
	|SELECT Партнеры.ID [Контрагент $Справочник.Контрагенты]
	|	, SUM(Ост.ДолгОснОстаток) Долг
	|	, CAST(ISNULL($ПоследнееЗначение.Контрагенты.Глубина(Партнеры.ID, :Период), 0) AS int) Глубина
	|FROM $РегистрОстатки.ВзаиморасчетыПокупателей(:Период~, , , (Контрагент), (ДолгОсн)) AS Ост
	|	INNER JOIN $Справочник.Контрагенты AS Контрагенты ON Ост.Контрагент = Контрагенты.ID
	|	INNER JOIN $Справочник.Контрагенты AS Партнеры ON Партнеры.ID = " + ВыражПартнер + "
	|WHERE 1=1 " + УсловиеОтбора + "
	|GROUP BY Партнеры.ID
	|HAVING SUM(Ост.ДолгОснОстаток) > 0"; // + claude
	рс.УстановитьТекстовыйПараметр("Период", Период);
	ТЗДолги = рс.ВыполнитьИнструкцию(ТекстЗапроса);

	МаксГлубина = 0;
	ТЗДолги.НоваяКолонка("Ключ");
	ТЗДолги.ВыбратьСтроки();
	Пока ТЗДолги.ПолучитьСтроку() = 1 Цикл
		ТЗДолги.Ключ = ЗначениеВСтрокуВнутр(ТЗДолги.Контрагент);
		МаксГлубина = Макс(МаксГлубина, ТЗДолги.Глубина);
	КонецЦикла;

	// 2. Движения после даты глубины каждого партнера: оборот и погашения (см. ТекстЗапросаПогашений) // + claude
	ЕстьДвижения = 0;
	Если (МаксГлубина > 0) И (ТЗДолги.КоличествоСтрок() > 0) Тогда // + claude
		ТекстЗапроса = ТекстЗапросаПогашений(0, УсловиеОтбора); // + claude
		рс.УстановитьТекстовыйПараметр("НачДата", Период - МаксГлубина); // + claude
		рс.УстановитьТекстовыйПараметр("Период", Период);
		ТЗДвижения = рс.ВыполнитьИнструкцию(ТекстЗапроса);

		// возвраты по ВозвратнойНакладной - только строки с ДокПродажи до даты глубины // + claude
		ТекстЗапроса = ТекстЗапросаВозвратов(0, УсловиеОтбора); // + claude
		рс.УстановитьТекстовыйПараметр("НачДата", Период - МаксГлубина); // + claude
		рс.УстановитьТекстовыйПараметр("Период", Период); // + claude
		ТЗВозвраты = рс.ВыполнитьИнструкцию(ТекстЗапроса); // + claude
		ТЗВозвраты.ВыбратьСтроки(); // + claude
		Пока ТЗВозвраты.ПолучитьСтроку() = 1 Цикл // + claude
			ТЗДвижения.НоваяСтрока();
			ТЗДвижения.Контрагент = ТЗВозвраты.Контрагент;
			ТЗДвижения.Оборот = 0;
			ТЗДвижения.Возвраты = ТЗВозвраты.Возвраты;
			ТЗДвижения.Оплаты = 0;
			ТЗДвижения.ОплатыБонусы = 0;
			ТЗДвижения.Прочие = 0;
		КонецЦикла; // + claude

		Если ТЗДвижения.КоличествоСтрок() > 0 Тогда
			ТЗДвижения.НоваяКолонка("Ключ");
			ТЗДвижения.ВыбратьСтроки();
			Пока ТЗДвижения.ПолучитьСтроку() = 1 Цикл
				ТЗДвижения.Ключ = ЗначениеВСтрокуВнутр(ТЗДвижения.Контрагент);
			КонецЦикла;
			ИндДвижения = СоздатьОбъект("ИндексированнаяТаблица");
			ИндДвижения.Загрузить(ТЗДвижения);
			ИндДвижения.ДобавитьИндекс("ИндКлюч", "Ключ");
			ЕстьДвижения = 1;
		КонецЕсли;
	КонецЕсли;
	
	// 3. Расчет просроченной задолженности
	ТЗРез = НоваяТаблицаСумм("Контрагент"); // + claude
	ТЗГрупп = НоваяТаблицаСумм("Ключ"); // + claude

	ТЗДолги.ВыбратьСтроки();
	Пока ТЗДолги.ПолучитьСтроку() = 1 Цикл

		Оборот = 0;
		СумОплаты = 0; // + claude
		СумВозвраты = 0; // + claude
		СумБонусы = 0; // + claude
		СумПрочие = 0; // + claude
		Если ЕстьДвижения = 1 Тогда
			сзПоиск = СоздатьОбъект("СписокЗначений");
			сзПоиск.ДобавитьЗначение(ТЗДолги.Ключ);
			ИндДвижения.Подмножество(сзПоиск, 1, "ИндКлюч");
			ИндДвижения.ВыбратьСтроки("ИндКлюч");
			Пока ИндДвижения.ПолучитьСтроку("ИндКлюч") = 1 Цикл
				Оборот = Оборот + ИндДвижения.Оборот;
				СумОплаты = СумОплаты + ИндДвижения.Оплаты; // + claude
				СумВозвраты = СумВозвраты + ИндДвижения.Возвраты; // + claude
				СумБонусы = СумБонусы + ИндДвижения.ОплатыБонусы; // + claude
				СумПрочие = СумПрочие + ИндДвижения.Прочие; // + claude
			КонецЦикла;
		КонецЕсли;

		ДолгГлубины = ТЗДолги.Долг - Оборот; // + claude
		Погашено = СумОплаты + СумВозвраты + СумБонусы + СумПрочие; // + claude
		Просрочено = Мин(ТЗДолги.Долг, ДолгГлубины - Погашено); // + claude
		Если Просрочено <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Элт = ТЗДолги.Контрагент;

		ТЗРез.НоваяСтрока(); // + claude
		ТЗРез.Контрагент = Элт;
		ТЗРез.Глубина = ТЗДолги.Глубина;
		ТЗРез.ДолгНаДатуГлубины = ДолгГлубины; // + claude
		ТЗРез.Оплаты = СумОплаты; // + claude
		ТЗРез.Возвраты = СумВозвраты; // + claude
		ТЗРез.ОплатыБонусы = СумБонусы; // + claude
		ТЗРез.Прочие = СумПрочие; // + claude
		ТЗРез.Сумма = Просрочено;

		Предки = ПредкиКонтрагента(Элт);
		Путь = "";
		Для Сч = 1 По Предки.РазмерСписка() Цикл
			Группа = Предки.ПолучитьЗначение(Сч);
			Путь = Путь + Группа.Наименование + "|";
			ДобавитьКИтогу(ТЗГрупп, ЗначениеВСтрокуВнутр(Группа), ТЗРез); // + claude
		КонецЦикла;
		ТЗРез.Путь = Путь + Элт.Наименование;

		ДобавитьКИтогу(ТЗГрупп, "Итог", ТЗРез); // + claude

	КонецЦикла;

	// 4. Вывод иерархически: группы сверху вниз, затем контрагенты
	ВывестиИерархию(ТЗРез, ТЗГрупп); // + claude

	ЗаполнитьСуммы(ТЗГрупп, СтрокаИтога(ТЗГрупп, "Итог")); // + claude
	КонечныйОстатокИтог = КонечныйОстаток; // + claude
	Таб.ВывестиСекцию("Итоги");

	Таб.ТолькоПросмотр(1);
	Таб.Показать("Отчет по просроченным долгам контрагентов на " + Строка(Период), "");

КонецПроцедуры // Сформировать()

// Список контрагентов справочника (с учетом отбора) и глубина кредита на дату Период
Процедура СписокКонтрагентов() // + claude

	Если Обновить = 2 Тогда
		СтрокаДействийФормы = "#Закрыть";
	КонецЕсли;

	Если ПустоеЗначение(Период) = 1 Тогда
		Предупреждение("Не задан период!");
		Возврат;
	КонецЕсли;

	РежимСписка = 1;
	ЗаголовокТекст = "Список контрагентів з глибиною кредиту на дату "; // + claude
	ПодготовитьТаблицу();

	Состояние("Выборка контрагентов...");

	ЕстьОтбор = ?(списКонтрагентов.РазмерСписка() > 0, 1, 0);
	УсловиеОтбора = ?(ЕстьОтбор = 1, " AND (Контрагенты.ID IN (SELECT Val FROM #списКонтрагентов))", "");

	рс = СоздатьОбъект("ODBCRecordset");
	Если ЕстьОтбор = 1 Тогда
		рс.УложитьСписокОбъектов(списКонтрагентов, "#списКонтрагентов", "Контрагенты");
	КонецЕсли;

	ТекстЗапроса = "
	|SELECT Контрагенты.ID [Контрагент $Справочник.Контрагенты]
	|	, CAST(ISNULL($ПоследнееЗначение.Контрагенты.Глубина(Контрагенты.ID, :Период), 0) AS int) Глубина
	|FROM $Справочник.Контрагенты AS Контрагенты
	|WHERE (Контрагенты.ISFOLDER = 2) AND (Контрагенты.ISMARK = 0) " + УсловиеОтбора;
	рс.УстановитьТекстовыйПараметр("Период", Период);
	ТЗСписок = рс.ВыполнитьИнструкцию(ТекстЗапроса);

	ТЗРез = НоваяТаблицаСумм("Контрагент"); // + claude

	// в режиме списка итоги групп не выводятся
	ТЗГрупп = НоваяТаблицаСумм("Ключ"); // + claude

	ТЗСписок.ВыбратьСтроки();
	Пока ТЗСписок.ПолучитьСтроку() = 1 Цикл
		Элт = ТЗСписок.Контрагент;
		Предки = ПредкиКонтрагента(Элт);
		Путь = "";
		Для Сч = 1 По Предки.РазмерСписка() Цикл
			Путь = Путь + Предки.ПолучитьЗначение(Сч).Наименование + "|";
		КонецЦикла;
		ТЗРез.НоваяСтрока();
		ТЗРез.Контрагент = Элт;
		ТЗРез.Глубина = ТЗСписок.Глубина;
		ТЗРез.Сумма = 0;
		ТЗРез.Путь = Путь + Элт.Наименование;
	КонецЦикла;

	ВывестиИерархию(ТЗРез, ТЗГрупп);

	Таб.ТолькоПросмотр(1);
	Таб.Показать("Список контрагентов с глубиной кредита на " + Строка(Период), "");

КонецПроцедуры // СписокКонтрагентов()

// Шапка и строки иерархически: группы сверху вниз, затем контрагенты
Процедура ВывестиИерархию(ТЗРез, ТЗГрупп) // + claude

	Состояние("Заполнение выходной таблицы...");

	ВывестиОбщуюСекцию("Кнопки");
	ВывестиОбщуюСекцию("Заголовки");
	Таб.Опции(0, 0, Таб.ВысотаТаблицы(), 0);

	ТЗРез.Сортировать("Путь");
	ТекПредки = СоздатьОбъект("СписокЗначений");

	ТЗРез.ВыбратьСтроки();
	Пока ТЗРез.ПолучитьСтроку() = 1 Цикл

		Предки = ПредкиКонтрагента(ТЗРез.Контрагент);

		// уровень, с которого группы отличаются от уже выведенных
		Совпадает = 0;
		Для Сч = 1 По Мин(Предки.РазмерСписка(), ТекПредки.РазмерСписка()) Цикл
			Если ЗначениеВСтрокуВнутр(Предки.ПолучитьЗначение(Сч)) <> ТекПредки.ПолучитьЗначение(Сч) Тогда
				Прервать;
			КонецЕсли;
			Совпадает = Сч;
		КонецЦикла;

		ТекПредки.УдалитьВсе();
		Для Сч = 1 По Предки.РазмерСписка() Цикл
			Группа = Предки.ПолучитьЗначение(Сч);
			ТекПредки.ДобавитьЗначение(ЗначениеВСтрокуВнутр(Группа));
			Если Сч > Совпадает Тогда
				ВывестиСтроку("group_1", Группа, Сч - 1, ТЗГрупп, СтрокаИтога(ТЗГрупп, ЗначениеВСтрокуВнутр(Группа)), 0); // + claude
			КонецЕсли;
		КонецЦикла;

		ВывестиСтроку("group_2", ТЗРез.Контрагент, Предки.РазмерСписка(), ТЗРез, ТЗРез.НомерСтроки, ТЗРез.Глубина); // + claude

	КонецЦикла;

КонецПроцедуры // ВывестиИерархию()

// Прибавляет сумму к итогу расшифровки с ключом Ключ (контрагент, документ или общий итог)
Процедура ПрибавитьКИтогуРасш(ТЗИтогов, Ключ, Сумма) // + claude

	Перем НомСтр;

	Если ТЗИтогов.НайтиЗначение(Ключ, НомСтр, "Ключ") = 0 Тогда
		ТЗИтогов.НоваяСтрока();
		ТЗИтогов.Ключ = Ключ;
		ТЗИтогов.Сумма = 0;
		НомСтр = ТЗИтогов.НомерСтроки;
	КонецЕсли;
	ТЗИтогов.УстановитьЗначение(НомСтр, "Сумма", ТЗИтогов.ПолучитьЗначение(НомСтр, "Сумма") + Сумма);

КонецПроцедуры // ПрибавитьКИтогуРасш()

// Итог расшифровки с ключом Ключ
Функция ИтогРасш(ТЗИтогов, Ключ) // + claude

	Перем НомСтр;

	Если ТЗИтогов.НайтиЗначение(Ключ, НомСтр, "Ключ") = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ТЗИтогов.ПолучитьЗначение(НомСтр, "Сумма");

КонецФункции // ИтогРасш()

// Строка расшифровки и итоги по контрагенту, документу и общий
Процедура ДобавитьСтрокуРасш(ТЗ, ТЗИтогов, Контр, ПозДок, Док, ДокОсн, Сумма) // + claude

	ТЗ.НоваяСтрока();
	ТЗ.Контрагент = Контр;
	ТЗ.ПозДок = ПозДок;
	ТЗ.Док = Док;
	ТЗ.ДокОсн = ДокОсн;
	ТЗ.Сумма = Сумма;
	ТЗ.КлючК = ЗначениеВСтрокуВнутр(Контр);
	ТЗ.КлючД = ТЗ.КлючК + ПозДок;

	ПрибавитьКИтогуРасш(ТЗИтогов, ТЗ.КлючК, Сумма);
	ПрибавитьКИтогуРасш(ТЗИтогов, ТЗ.КлючД, Сумма);
	ПрибавитьКИтогуРасш(ТЗИтогов, "Итог", Сумма);

КонецПроцедуры // ДобавитьСтрокуРасш()

// Расшифровка колонки погашений партнера по документам (теми же запросами, что и отчет).
// Парам: Колонка (1 - оплаты, 2 - возвраты, 3 - бонусы, 4 - прочие), Контрагент (партнер), Глубина, Период.
// Таблица вывода - ТабРасш (пустая - новая таблица, иначе обновление существующей).
Процедура ВывестиРасшифровку(Парам) // + claude

	Партнер = Парам.Получить("Контрагент");
	Глубина = Парам.Получить("Глубина");
	Колонка = Парам.Получить("Колонка");
	ДатаРасш = Парам.Получить("Период");

	ИмяКолонки = ?(Колонка = 1, "Оплачено", ?(Колонка = 2, "Повернення товару", ?(Колонка = 3, "Оплата бонусами", "Інші операції")));
	ИмяРесурса = ?(Колонка = 1, "Оплаты", ?(Колонка = 2, "Возвраты", ?(Колонка = 3, "ОплатыБонусы", "Прочие")));

	ТЗ = СоздатьОбъект("ТаблицаЗначений");
	ТЗ.НоваяКолонка("Контрагент");
	ТЗ.НоваяКолонка("ПозДок");
	ТЗ.НоваяКолонка("Док");
	ТЗ.НоваяКолонка("ДокОсн");
	ТЗ.НоваяКолонка("Сумма");
	ТЗ.НоваяКолонка("КлючК");
	ТЗ.НоваяКолонка("КлючД");
	ТЗИтогов = СоздатьОбъект("ТаблицаЗначений");
	ТЗИтогов.НоваяКолонка("Ключ");
	ТЗИтогов.НоваяКолонка("Сумма");

	Если Глубина > 0 Тогда

		Состояние("Расшифровка по документам...");
		УсловиеПартнера = " AND (Партнеры.ID = :Партнер)";
		рс = СоздатьОбъект("ODBCRecordset");

		рс.УстановитьТекстовыйПараметр("НачДата", ДатаРасш - Глубина);
		рс.УстановитьТекстовыйПараметр("Период", ДатаРасш);
		рс.УстановитьТекстовыйПараметр("Партнер", Партнер);
		ТЗДок = рс.ВыполнитьИнструкцию(ТекстЗапросаПогашений(1, УсловиеПартнера));
		ТЗДок.ВыбратьСтроки();
		Пока ТЗДок.ПолучитьСтроку() = 1 Цикл
			Сумма = ТЗДок.ПолучитьЗначение(ТЗДок.НомерСтроки, ИмяРесурса);
			Если Сумма <> 0 Тогда
				ДобавитьСтрокуРасш(ТЗ, ТЗИтогов, ТЗДок.Контрагент, ТЗДок.ПозДок, ТЗДок.Док, "", Сумма);
			КонецЕсли;
		КонецЦикла;

		// возвраты по ВозвратнойНакладной - по строкам с документом продажи
		Если Колонка = 2 Тогда
			рс.УстановитьТекстовыйПараметр("НачДата", ДатаРасш - Глубина);
			рс.УстановитьТекстовыйПараметр("Период", ДатаРасш);
			рс.УстановитьТекстовыйПараметр("Партнер", Партнер);
			ТЗДок = рс.ВыполнитьИнструкцию(ТекстЗапросаВозвратов(1, УсловиеПартнера));
			ТЗДок.ВыбратьСтроки();
			Пока ТЗДок.ПолучитьСтроку() = 1 Цикл
				Если ТЗДок.Возвраты <> 0 Тогда
					ДобавитьСтрокуРасш(ТЗ, ТЗИтогов, ТЗДок.Контрагент, ТЗДок.ПозДок, ТЗДок.Док, ТЗДок.ДокОсн, ТЗДок.Возвраты);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;

	// контрагенты по наименованию, документы в хронологическом порядке
	ТЗ.Сортировать("Контрагент,ПозДок");

	Если ТипЗначенияСтр(ТабРасш) <> "Таблица" Тогда
		ТабРасш = СоздатьОбъект("Таблица");
	Иначе
		ТабРасш.Очистить();
	КонецЕсли;
	ТабРасш.ИсходнаяТаблица("Таблица_расшифровка");

	// параметры для кнопки Обновить (РасшифровкаОбновить вычисляется при выводе секции)
	ПараметрыРасш = СоздатьОбъект("СписокЗначений");
	ПараметрыРасш.Установить("ВидРасшифровки", "ДокументыПогашения");
	ПараметрыРасш.Установить("Колонка", Колонка);
	ПараметрыРасш.Установить("Контрагент", Партнер);
	ПараметрыРасш.Установить("Глубина", Глубина);
	ПараметрыРасш.Установить("Период", ДатаРасш);
	ПараметрыРасш.Установить("Отчет", "Очет_ПоПросроченнымДолгамКонтрагентов");
	ТабРасш.ВывестиСекцию("Кнопки_расш");
	ПараметрыРасш = "";

	// заголовок макета выводит реквизит формы Период - временно подменяем датой расшифровки
	ПериодФормы = Период;
	Период = ДатаРасш;
	Расш_Заголовок = "Розшифровка """ + ИмяКолонки + """ по " + СокрЛП(Партнер.Наименование) + " на дату ";
	ТабРасш.ВывестиСекцию("Заголовки_расш");
	Период = ПериодФормы;
	ТабРасш.Опции(0, 0, ТабРасш.ВысотаТаблицы(), 0);

	ТекКлючК = "";
	ТекКлючД = "";
	ТЗ.ВыбратьСтроки();
	Пока ТЗ.ПолучитьСтроку() = 1 Цикл

		Если ТЗ.КлючК <> ТекКлючК Тогда
			ТекКлючК = ТЗ.КлючК;
			ТекКлючД = "";
			Контрагент_Наименование = ТЗ.Контрагент.Наименование;
			Сумма_расш = ИтогРасш(ТЗИтогов, ТЗ.КлючК);
			СтрРасшифровка = ТЗ.Контрагент;
			ТабРасш.ВывестиСекцию("group_1_расш");
		КонецЕсли;

		Если ТЗ.КлючД <> ТекКлючД Тогда
			ТекКлючД = ТЗ.КлючД;
			Документ = ТЗ.Док;
			СумаДок_расш = ИтогРасш(ТЗИтогов, ТЗ.КлючД);
			СтрРасшифровка = ТЗ.Док;
			ТабРасш.ВывестиСекцию("group_2_расш");
		КонецЕсли;

		Если ПустоеЗначение(ТЗ.ДокОсн) = 0 Тогда
			ДокументОснование = ТЗ.ДокОсн;
			СумаДокОснование_расш = ТЗ.Сумма;
			СтрРасшифровка = ТЗ.ДокОсн;
			ТабРасш.ВывестиСекцию("group_3_расш");
		КонецЕсли;

	КонецЦикла;

	СумаИтог_расш = ИтогРасш(ТЗИтогов, "Итог");
	ТабРасш.ВывестиСекцию("Итоги_расш");

	ТабРасш.ТолькоПросмотр(1);
	ТабРасш.Показать("Розшифровка: " + ИмяКолонки + " - " + СокрЛП(Партнер.Наименование), "");

КонецПроцедуры // ВывестиРасшифровку()

///////////////////////////////////Работа со списками отбора и подбором///////////////////////////////////////

Процедура ДобавитьВСписок(Элт, Спис)

	Если Спис.Принадлежит(Элт) = 0 Тогда
		Спис.ДобавитьЗначение(Элт, Элт.Наименование);
	КонецЕсли;

КонецПроцедуры // ДобавитьВСписок()

Процедура ОбработкаПодбора(Элт)

	Если Элт.Вид() = "Контрагенты" Тогда
		ДобавитьВСписок(Элт, списКонтрагентов);
	КонецЕсли;

КонецПроцедуры // ОбработкаПодбора()

Процедура ДобавитьЭлементВСписок(НазваниеОбъекта, Один)

	КФормы = 0;
	ОткрытьПодбор(НазваниеОбъекта, "ДляВыбора", КФормы, Один);
	КФормы.ВыборГруппы(1);

КонецПроцедуры // ДобавитьЭлементВСписок()

Процедура УдалитьЗначениеСписка(Спис)

	Если Спис.ТекущаяСтрока() <> 0 Тогда
		Спис.УдалитьЗначение(Спис.ТекущаяСтрока());
	КонецЕсли;

КонецПроцедуры // УдалитьЗначениеСписка()
